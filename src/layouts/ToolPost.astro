---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { toTagSlug } from '../utils/tags';

interface Props {
  entry: CollectionEntry<'tools'>;
  kind: string;
  instrument?: boolean;
}

const { entry, kind, instrument = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={`${entry.data.title} — Chips’nCode`} description={entry.data.description} /></head>
  <body>
    <Header />
    <main class:list={['tool-page', instrument && 'tool-page--instrument']}>
      <article class="tool-entry">
        <a href="/tools" class="tool-back">← All tools</a>
        <header class="tool-header">
          <div class="tool-header__lead">
            <p class="editorial-kicker">{kind}</p>
            <h1>{entry.data.title}</h1>
            <p>{entry.data.description}</p>
          </div>
          <div class="tool-header__record">
            <dl>
              <div><dt>Format</dt><dd>{instrument ? 'Interactive' : 'Reference'}</dd></div>
              {entry.data.pubDate ? <div><dt>Published</dt><dd><FormattedDate date={entry.data.pubDate} /></dd></div> : null}
              {entry.data.updatedDate ? <div><dt>Updated</dt><dd><FormattedDate date={entry.data.updatedDate} /></dd></div> : null}
            </dl>
            {entry.data.tags?.length ? (
              <nav aria-label="Tool topics">
                {entry.data.tags.slice(0, 5).map((tag) => <a href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>)}
              </nav>
            ) : null}
          </div>
        </header>
        <div class="tool-body"><div class="prose prose--tool"><slot /></div></div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .tool-page { width: min(1120px, calc(100% - 4rem)); max-width: 1120px; padding: 1.6rem 0 clamp(5rem, 9vw, 8rem); }
  .tool-page--instrument { width: min(1320px, calc(100% - 4rem)); max-width: 1320px; }
  .tool-back { display: inline-block; margin-bottom: 1.4rem; color: var(--muted); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; text-decoration: none; text-transform: uppercase; }
  .tool-back:hover { color: var(--accent); }
  .tool-header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 0.31fr); gap: clamp(2rem, 6vw, 6rem); align-items: end; padding: clamp(1.5rem, 4vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2.5rem); border-block: 1px solid var(--text); }
  .tool-header h1 { max-width: 16ch; margin: 0.35rem 0 0; font-size: clamp(2.8rem, 7vw, 6.4rem); line-height: 0.91; letter-spacing: -0.055em; text-wrap: balance; }
  .tool-header__lead > p:last-child { max-width: 67ch; margin: 1.2rem 0 0; color: var(--text-2); font-size: clamp(1rem, 1.35vw, 1.18rem); line-height: 1.55; }
  .tool-header__record dl { margin: 0; border-top: 1px solid var(--border); }
  .tool-header__record dl div { display: grid; grid-template-columns: 5rem 1fr; gap: 0.8rem; padding: 0.55rem 0; border-bottom: 1px solid var(--border); }
  .tool-header__record dt { color: var(--muted); }
  .tool-header__record dt, .tool-header__record dd, .tool-header__record nav { font-family: var(--font-mono); font-size: 0.65rem; }
  .tool-header__record dd { margin: 0; color: var(--text); }
  .tool-header__record nav { display: flex; flex-wrap: wrap; gap: 0.35rem 0.65rem; margin-top: 0.85rem; }
  .tool-header__record nav a { color: var(--muted); text-decoration: none; }
  .tool-header__record nav a:hover { color: var(--accent); }
  .tool-body { padding-top: clamp(2rem, 5vw, 4.5rem); }
  .tool-page--instrument .tool-body { min-width: 0; overflow-x: auto; overscroll-behavior-inline: contain; }
  .tool-page:not(.tool-page--instrument) .tool-body { max-width: 820px; }
  .prose--tool { color: var(--text-2); }
  .prose--tool :global(> p:first-child) { max-width: 70ch; color: var(--text); font-size: clamp(1.05rem, 1.4vw, 1.2rem); }
  .prose--tool :global(h2) { margin-top: 2.8rem; padding-top: 0.8rem; border-top: 1px solid var(--border); }
  .prose--tool :global(h2:first-of-type) { margin-top: 1.8rem; }
  .prose--tool :global(table) { display: block; overflow-x: auto; }
  .prose--tool :global(pre) { border-radius: 0; box-shadow: none; }
  .prose--tool :global(:not(pre) > code) { border-radius: 0; }
  .tool-page :global(:focus-visible) { border-radius: 0; }
  @media (max-width: 760px) {
    .tool-page, .tool-page--instrument { width: min(100% - 2rem, 1320px); }
    .tool-header { grid-template-columns: 1fr; gap: 1.5rem; }
    .tool-header h1 { max-width: none; }
    .tool-header__record { max-width: 420px; }
  }
</style>
