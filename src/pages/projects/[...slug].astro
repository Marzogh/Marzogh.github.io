---
import { getCollection, getEntry, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { toTagSlug } from '../../utils/tags';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing route parameter: slug');

const entry = await getEntry('projects', slug);
if (!entry) throw new Error(`Project not found: ${slug}`);

const { Content } = await render(entry);
const hero = entry.data.image ?? null;
const headerStyle = entry.data.headerStyle ?? 'panel';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={entry.data.title} description={entry.data.description} />
  </head>
  <body>
    <Header />
    <main class="project-page">
      <article class="project-entry">
        <a href="/projects" class="project-back">← Back to Projects</a>

        <header
          class:list={[
            'project-hero',
            headerStyle === 'panel' && 'panel',
            headerStyle === 'plain' && 'project-hero--plain',
            headerStyle === 'panel' && !hero && 'project-hero--textOnly',
          ]}
        >
          <div class="project-copy">
            <div class="project-kickers">
              <span class="pill">Project</span>
              {entry.data.featured ? <span class="pill pill--coral">Featured</span> : null}
            </div>

            <h1 class="project-title">{entry.data.title}</h1>
            <p class="project-description">{entry.data.description}</p>

            <div class="project-meta">
              {entry.data.pubDate ? (
                <span class="project-meta__item">
                  Published <FormattedDate date={entry.data.pubDate} />
                </span>
              ) : null}
              {entry.data.updatedDate ? (
                <span class="project-meta__item">
                  Updated <FormattedDate date={entry.data.updatedDate} />
                </span>
              ) : null}
            </div>

            {entry.data.tags?.length ? (
              <div class="project-tags">
                {entry.data.tags.map((tag) => (
                  <a class="tagLink" href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>
                ))}
              </div>
            ) : null}

            {(entry.data.github || entry.data.demo) ? (
              <div class="project-links">
                {entry.data.github ? <a class="btn" href={entry.data.github}>Source</a> : null}
                {entry.data.demo ? <a class="btn btn--primary" href={entry.data.demo}>{entry.data.demoLabel ?? 'Live demo'}</a> : null}
              </div>
            ) : null}
          </div>

          {headerStyle === 'panel' && hero ? (
            <div class="project-hero__media">
              <img src={hero} alt="" loading="eager" decoding="async" />
            </div>
          ) : null}
        </header>

        {headerStyle === 'plain' && hero ? (
          <figure class="project-hero-media">
            <img src={hero} alt="" loading="eager" decoding="async" />
          </figure>
        ) : null}

        <div class="project-body panel panel--soft">
          <div class="project-prose prose">
            <Content />
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .project-page {
    max-width: min(1180px, calc(100% - 2 * var(--space-5)));
  }

  .project-entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .project-back {
    width: fit-content;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .project-back:hover {
    color: var(--accent);
  }

  .project-hero {
    min-width: 0;
  }

  .project-hero.panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: var(--space-5);
    align-items: stretch;
    background:
      radial-gradient(800px 240px at top right, rgba(37, 99, 235, 0.08), transparent 70%),
      radial-gradient(620px 220px at bottom left, rgba(45, 255, 178, 0.08), transparent 76%),
      var(--surface-raised);
  }

  .project-hero.panel.project-hero--textOnly {
    grid-template-columns: minmax(0, 1fr);
  }

  .project-hero--plain {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0 0 var(--space-3);
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .project-hero--plain::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--accent) 24%, transparent 76%),
      color-mix(in srgb, var(--border) 72%, transparent 28%)
    );
  }

  .project-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .project-kickers,
  .project-meta,
  .project-tags,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .project-title,
  .project-description {
    margin: 0;
  }

  .project-hero--plain .project-title {
    font-size: clamp(2.3rem, 4vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .project-description {
    max-width: 62ch;
    font-size: 1.08rem;
    color: var(--text-2);
  }

  .project-hero--plain .project-description {
    font-size: clamp(1rem, 1.2vw, 1.12rem);
  }

  .project-meta__item {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .tagLink {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }

  .tagLink:hover {
    color: var(--accent);
  }

  .project-hero__media {
    min-height: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--surface-raised) 92%, transparent 8%),
      color-mix(in srgb, var(--surface) 84%, var(--surface-raised) 16%)
    );
    box-shadow: var(--shadow-sm);
  }

  .project-hero-media {
    margin: 0;
    max-width: min(760px, 100%);
    margin-left: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--surface-raised) 92%, transparent 8%),
      color-mix(in srgb, var(--surface) 84%, var(--surface-raised) 16%)
    );
    box-shadow: var(--shadow-sm);
  }

  .project-hero-media img {
    width: 100%;
    display: block;
  }

  .project-hero__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .project-body {
    padding-top: calc(var(--space-5) + 2px);
  }

  .project-prose :global(h2) {
    margin-top: 2.2rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .project-prose :global(.heroFigure:first-child) {
    margin-top: 0;
  }

  .project-prose :global(.postStats),
  .project-prose :global(.buildGrid),
  .project-prose :global(.qsoKpis) {
    margin: 1.5rem 0 1.9rem;
  }

  .project-prose :global(.spec-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 1rem 0 1.4rem;
  }

  .project-prose :global(.spec-card) {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-raised) 86%, transparent 14%);
    padding: 0.85rem 0.95rem;
  }

  .project-prose :global(.spec-card h3) {
    margin: 0 0 0.3rem;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .project-prose :global(.spec-card p) {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-1);
  }

  .project-prose :global(.cap-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 1rem 0 1.5rem;
  }

  .project-prose :global(.cap-card) {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 72%, transparent 28%);
    padding: 0.9rem 1rem;
  }

  .project-prose :global(.cap-card h3) {
    margin: 0 0 0.45rem;
    font-size: 1.02rem;
  }

  .project-prose :global(.cap-card ul) {
    margin: 0;
  }

  .project-prose :global(.quote-strip) {
    margin: 1.2rem 0 1.6rem;
    padding: 1rem 1.1rem;
    border-left: 4px solid color-mix(in srgb, var(--accent) 72%, transparent 28%);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: color-mix(in srgb, var(--surface-raised) 88%, transparent 12%);
  }

  .project-prose :global(.quote-strip p) {
    margin: 0.25rem 0;
  }

  .project-prose :global(.usecase-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 1rem 0 1.5rem;
  }

  .project-prose :global(.usecase-card) {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-raised) 83%, transparent 17%);
    padding: 0.95rem 1rem;
  }

  .project-prose :global(.usecase-card h3) {
    margin: 0 0 0.45rem;
    font-size: 1.02rem;
  }

  .project-prose :global(.link-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.85rem;
  }

  @media (max-width: 860px) {
    .project-page {
      max-width: calc(100% - 2 * var(--space-4));
    }

    .project-hero.panel {
      grid-template-columns: 1fr;
    }

    .project-prose :global(.spec-grid),
    .project-prose :global(.cap-grid),
    .project-prose :global(.usecase-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
