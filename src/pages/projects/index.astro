---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import { getTagMeta, toTagSlug } from '../../utils/tags';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => {
  const aTime = a.data.pubDate ? a.data.pubDate.getTime() : 0;
  const bTime = b.data.pubDate ? b.data.pubDate.getTime() : 0;
  if (bTime !== aTime) return bTime - aTime;
  return a.data.title.localeCompare(b.data.title);
});

const featuredProject = projects.find((project) => project.data.featured) ?? projects[0] ?? null;
const remainingProjects = featuredProject ? projects.filter((project) => project.id !== featuredProject.id) : [];
function pickThumb(data: any) {
  return data.thumbnail ?? data.thumb ?? data.cover ?? data.coverImage ?? data.heroImage ?? data.image ?? null;
}

function labelFor(project: (typeof projects)[number]) {
  return project.data.type ?? 'Project';
}

const uniqueTags = [...new Set(projects.flatMap((project) => project.data.tags ?? []))];
const radioTags = uniqueTags
  .filter((tag) => getTagMeta(tag).family === 'radio')
  .map((tag) => ({
    slug: toTagSlug(tag),
    label: getTagMeta(tag).label,
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Projects — Chips’nCode"
      description="Builds, hardware experiments, radio field work, firmware, and system design notes."
    />
  </head>
  <body>
    <Header />

    <main class="projects-index">
      <section class="projects-shell">
        <div class="projects-main">
          <IndexHeader
            eyebrow="Workshop"
            title="Projects"
            lede="Real builds, field tests, antenna experiments, firmware detours, and the occasional bit of engineering that behaved properly first time."
            terminalTitle="projects.index"
            statusLines={[
              { label: 'published_projects', value: projects.length },
              { label: 'tags_in_use', value: uniqueTags.length },
              { label: 'radio_builds', value: projects.filter((project) => project.data.type === 'radio' || project.data.tags?.includes('amateur-radio')).length },
            ]}
          />

          {radioTags.length ? (
            <details class="radio-drawer panel panel--soft">
              <summary class="radio-drawer__summary">
                <div class="radio-drawer__summaryText">
                  <p class="eyebrow eyebrow--radio">Radio Shelf</p>
                  <h2>Browse the radio work properly</h2>
                </div>
                <span class="radio-drawer__hint">Open shelf</span>
              </summary>
              <div class="radio-drawer__body">
                <p class="radio-drawer__lede">
                  The radio side of the site is going to keep growing, so these tags are the quickest way into activations, antennas,
                  POTA, and related field work.
                </p>
                <div class="radio-drawer__tags">
                  {radioTags.map((tag) => (
                    <a class="tagChip" href={`/tags/${tag.slug}`}>#{tag.label}</a>
                  ))}
                </div>
              </div>
            </details>
          ) : null}

          {featuredProject ? (
            <section class:list={['featured panel', !pickThumb(featuredProject.data) && 'featured--textOnly']} aria-labelledby="featured-project-heading">
              <div class="featured-copy">
                <div class="featured-kickers">
                  <span class="pill">Latest Project</span>
                  {featuredProject.data.featured ? <span class="pill pill--coral">Featured</span> : null}
                  <span class="pill">{labelFor(featuredProject)}</span>
                </div>

                <h2 id="featured-project-heading" class="featured-title">
                  <a href={`/projects/${featuredProject.id}`}>{featuredProject.data.title}</a>
                </h2>

                {featuredProject.data.description ? <p class="featured-desc">{featuredProject.data.description}</p> : null}

                <div class="featured-meta">
                  {featuredProject.data.pubDate ? (
                    <span class="featured-meta__item">
                      Published <FormattedDate date={featuredProject.data.pubDate} />
                    </span>
                  ) : null}
                  {featuredProject.data.updatedDate ? (
                    <span class="featured-meta__item">
                      Updated <FormattedDate date={featuredProject.data.updatedDate} />
                    </span>
                  ) : null}
                  <span class="featured-meta__item">
                    {featuredProject.data.tags?.length ?? 0} tags
                  </span>
                </div>

                {featuredProject.data.tags?.length ? (
                  <div class="featured-tags">
                    {featuredProject.data.tags.slice(0, 6).map((tag) => (
                      <a class="tagChip" href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>
                    ))}
                  </div>
                ) : null}

              </div>

              {pickThumb(featuredProject.data) ? (
                <a class="featured-media" href={`/projects/${featuredProject.id}`} aria-label={`Open project: ${featuredProject.data.title}`}>
                  {typeof pickThumb(featuredProject.data) === 'string' ? (
                    <img src={pickThumb(featuredProject.data)} alt="" loading="eager" decoding="async" />
                  ) : (
                    <Image
                      src={pickThumb(featuredProject.data)}
                      alt=""
                      widths={[720, 1080, 1440]}
                      sizes="(max-width: 920px) 100vw, (max-width: 1320px) 60vw, 720px"
                    />
                  )}
                </a>
              ) : null}
            </section>
          ) : null}
        </div>
      </section>

      {remainingProjects.length ? (
        <section class="archive" aria-labelledby="project-archive-heading">
          <div class="section-head">
            <h2 id="project-archive-heading">Project Archive</h2>
            <p>Everything else currently on the bench, in the field, or already written up.</p>
          </div>

          <div class="grid">
            {remainingProjects.map((project) => {
              const thumb = pickThumb(project.data);

              return (
                <a href={`/projects/${project.id}`} class:list={['card', !thumb && 'card--textOnly']} aria-label={`Open project: ${project.data.title}`}>
                  {thumb ? (
                    <div class="thumb" aria-hidden="true">
                      {typeof thumb === 'string' ? (
                        <img src={thumb} alt="" loading="lazy" decoding="async" />
                      ) : (
                        <Image
                          src={thumb}
                          alt=""
                          widths={[480, 720, 960]}
                          sizes="(max-width: 520px) 100vw, (max-width: 920px) 50vw, 33vw"
                        />
                      )}
                    </div>
                  ) : null}

                  <div class="card-body">
                    <div class="card-meta">
                      <span class="pill">{labelFor(project)}</span>
                      {project.data.pubDate ? (
                        <span class="card-date">
                          <FormattedDate date={project.data.pubDate} />
                        </span>
                      ) : null}
                    </div>

                    <h3 class="card-title">{project.data.title}</h3>
                    {project.data.description ? <p class="card-desc">{project.data.description}</p> : null}

                    {project.data.tags?.length ? (
                      <div class="card-tags">
                        {project.data.tags.slice(0, 3).map((tag) => <span class="tagChip">#{tag}</span>)}
                      </div>
                    ) : null}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ) : projects.length > 0 ? null : (
        <div class="panel panel--soft empty">
          <p class="empty-title">Projects coming soon.</p>
          <p class="empty-sub">
            Add a project entry with an <code>image</code> in frontmatter and this page will start doing real work.
          </p>
        </div>
      )}
    </main>

    <Footer />

  </body>
</html>

<style>
  .projects-index{
    max-width: min(1480px, calc(100% - 2 * var(--space-5)));
  }

  .projects-shell{
    display:grid;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .projects-main{
    display:grid;
    gap: var(--space-6);
    align-content:start;
    min-width: 0;
  }

  .page-header{
    display:grid;
    gap: var(--space-5);
    background:
      radial-gradient(900px 280px at top right, rgba(37, 99, 235, 0.08), transparent 70%),
      radial-gradient(760px 260px at bottom left, rgba(45, 255, 178, 0.08), transparent 76%),
      var(--surface-raised);
  }

  .page-copy{
    display:flex;
    flex-direction:column;
    gap: var(--space-3);
  }

  .eyebrow{
    width: fit-content;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface-glass);
  }

  .eyebrow--radio{
    color: color-mix(in srgb, var(--accent) 54%, var(--text) 46%);
  }

  .page-title,
  .page-lede{
    margin: 0;
  }

  .page-title{
    font-size: clamp(2.7rem, 4vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .page-lede{
    max-width: 38ch;
    color: var(--text-2);
    font-size: clamp(1.08rem, 1.35vw, 1.5rem);
    line-height: 1.6;
  }

  .overview-console{
    border: 1px solid color-mix(in srgb, var(--border) 82%, var(--text) 18%);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.94), rgba(15, 23, 42, 0.88)),
      #0f172a;
    color: #d8e4f5;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .overview-console__head{
    display:flex;
    align-items:center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.16);
    background: rgba(15, 23, 42, 0.78);
  }

  .overview-console__dot{
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.45);
  }

  .overview-console__title{
    margin-left: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: #93a6c1;
  }

  .overview-console__grid{
    display:grid;
    gap: 0;
    margin: 0;
    padding: 12px 14px 14px;
  }

  .overview-row{
    display:grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px;
    align-items: baseline;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(148, 163, 184, 0.12);
    font-family: var(--font-mono);
  }

  .overview-row:last-child{
    border-bottom: 0;
  }

  .overview-row dt,
  .overview-row dd{
    margin: 0;
  }

  .overview-row dt{
    color: #9fb0c8;
    font-size: 0.82rem;
  }

  .overview-row dd{
    color: #f8fbff;
    font-size: 0.96rem;
    font-weight: 700;
  }

  .radio-drawer{
    display:grid;
    gap: 0;
    background:
      radial-gradient(560px 180px at top right, rgba(37, 99, 235, 0.07), transparent 72%),
      radial-gradient(520px 200px at bottom left, rgba(16, 185, 129, 0.07), transparent 72%),
      var(--surface-raised);
  }

  .radio-drawer[open] .radio-drawer__hint{
    content: "Hide shelf";
  }

  .radio-drawer__summary{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: var(--space-4);
    list-style:none;
    cursor:pointer;
  }

  .radio-drawer__summary::-webkit-details-marker{
    display:none;
  }

  .radio-drawer__summaryText{
    display:flex;
    flex-direction:column;
    gap: 8px;
  }

  .radio-drawer__summaryText h2,
  .radio-drawer__summaryText p,
  .radio-drawer__lede{
    margin: 0;
  }

  .radio-drawer__summaryText h2{
    font-size: clamp(1.15rem, 1.5vw, 1.55rem);
    line-height: 1.08;
  }

  .radio-drawer__hint{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-glass);
    color: var(--text-2);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .radio-drawer[open] .radio-drawer__hint{
    color: var(--text);
  }

  .radio-drawer__body{
    display:grid;
    gap: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    margin-top: 14px;
  }

  .radio-drawer__lede{
    color: var(--text-2);
    max-width: 66ch;
    font-size: 0.96rem;
  }

  .radio-drawer__tags{
    display:flex;
    flex-wrap:wrap;
    gap: 10px;
  }

  .featured{
    display:grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    gap: var(--space-5);
    align-items: stretch;
    width: min(100%, 1160px);
    margin-right: auto;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface-raised) 96%, transparent 4%), color-mix(in srgb, var(--surface) 90%, var(--surface-raised) 10%));
  }

  .featured--textOnly{
    grid-template-columns: 1fr;
    width: min(100%, 860px);
    background:
      radial-gradient(720px 220px at top left, rgba(37, 99, 235, 0.08), transparent 70%),
      radial-gradient(640px 220px at bottom right, rgba(45, 255, 178, 0.08), transparent 76%),
      var(--surface-raised);
  }

  .featured-copy{
    display:flex;
    flex-direction:column;
    gap: var(--space-4);
    min-width: 0;
  }

  .featured-kickers,
  .featured-meta,
  .featured-tags,
  .card-meta,
  .card-tags{
    display:flex;
    flex-wrap:wrap;
    gap: 10px;
    align-items:center;
  }

  .featured-title,
  .featured-desc{
    margin: 0;
  }

  .featured-title{
    font-size: clamp(2rem, 2.5vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .featured-title a{
    color: inherit;
    text-decoration: none;
  }

  .featured-title a:hover{
    color: var(--accent);
  }

  .featured-desc{
    max-width: 34ch;
    color: var(--text-2);
    font-size: clamp(1rem, 1.15vw, 1.2rem);
  }

  .tagChip{
    display:inline-flex;
    align-items:center;
    gap: 0.35rem;
    padding: 0.34rem 0.62rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-glass);
    color: var(--text-2);
    font-size: 0.82rem;
    line-height: 1;
    text-decoration: none;
  }

  .tagChip:hover{
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 22%, var(--border) 78%);
  }

  .featured-meta__item,
  .card-date{
    color: var(--muted);
    font-size: 0.94rem;
  }

  .featured-media,
  .thumb{
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  .featured-media{
    display: block;
    width: 100%;
    max-width: 100%;
    min-height: 100%;
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
    aspect-ratio: 16 / 11;
    min-width: 0;
  }

  .featured-media :global(picture){
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
  }

  .featured-media :global(img),
  .thumb :global(img){
    width: 100%;
    max-width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .thumb{
    aspect-ratio: 16 / 9;
  }

  .section-head{
    display:flex;
    flex-direction:column;
    gap: 8px;
    margin-bottom: var(--space-5);
  }

  .section-head h2,
  .section-head p{
    margin: 0;
  }

  .section-head h2{
    font-size: clamp(1.5rem, 1.9vw, 2.2rem);
  }

  .section-head p{
    color: var(--text-2);
  }

  .grid{
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-5);
    align-items: start;
  }

  .card{
    display:flex;
    flex-direction:column;
    align-self: start;
    text-decoration:none;
    color:inherit;
    border:1px solid var(--border);
    border-radius:18px;
    overflow:hidden;
    background: var(--surface-raised);
    box-shadow: var(--shadow-sm);
    transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease;
  }

  .card--textOnly{
    background:
      radial-gradient(520px 180px at top left, rgba(37, 99, 235, 0.06), transparent 72%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(248, 250, 252, 0.96));
  }

  .card:hover{
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--accent) 25%, var(--border) 75%);
  }

  .card-body{
    display:flex;
    flex-direction:column;
    gap: var(--space-3);
    padding: var(--space-5);
    min-width: 0;
  }

  .card-title,
  .card-desc{
    margin:0;
  }

  .card-title{
    font-size:clamp(1.18rem, 1.15vw, 1.45rem);
    line-height:1.16;
    color:var(--text);
    text-wrap: balance;
  }

  .card-desc{
    color:var(--text-2);
    font-size: 0.98rem;
  }

  .empty{
    padding: var(--space-6);
  }

  .empty-title{
    margin: 0 0 0.4rem;
    font-weight: 700;
    color: var(--text);
  }

  .empty-sub{
    margin: 0;
    color: var(--text-2);
    max-width: 80ch;
  }

  @media (min-width: 760px){
    .page-header{
      grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
      align-items: end;
    }

  }

  @media (max-width: 920px){
    .featured{
      grid-template-columns: 1fr;
    }

    .page-header{
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 1099px){
    .projects-index{
      max-width: min(1160px, calc(100% - 2 * var(--space-5)));
    }

    .page-lede,
    .featured-desc,
    .radio-drawer__lede{
      max-width: none;
    }
  }
</style>
