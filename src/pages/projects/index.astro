---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectCover from '../../components/projects/ProjectCover.astro';
import { projectCatalogue } from '../../data/projectCatalogue';
import '../../styles/project-catalogue.css';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Projects | Chips’nCode" description="Almanacs, collections, applications and other things I’ve made." />
  </head>
  <body>
    <Header />
    <main class="projects-index" aria-labelledby="projects-title">
      <header class="catalogue-heading">
        <h1 id="projects-title">Projects</h1>
        <p>Birds, skies, imaginary worlds, and whatever I end up building next.</p>
      </header>
      <div class="catalogue" data-project-grid>
        {projectCatalogue.map((project) => (
          <article class:list={['catalogue-entry', `catalogue-type--${project.typeface}`]} aria-labelledby={`title-${project.id}`}>
            <ProjectCover project={project} />
            <div class="catalogue-copy">
              <h2 id={`title-${project.id}`}><a href={project.href}>{project.title}</a></h2>
              <p class="catalogue-description">{project.description}</p>
              <div class="catalogue-links">
                <a class="catalogue-open" href={project.href}>
                  {project.action}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
                </a>
                {project.about && <a href={project.about} aria-label={`About ${project.title}`}>About</a>}
                {project.source && <a href={project.source} aria-label={`${project.title} source on GitHub`}>Source</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </main>
    <script is:inline>
      const projectGrid = document.querySelector('[data-project-grid]');
      if (projectGrid) {
        const entries = Array.from(projectGrid.children);
        for (let index = entries.length - 1; index > 0; index--) {
          const other = Math.floor(Math.random() * (index + 1));
          [entries[index], entries[other]] = [entries[other], entries[index]];
        }
        entries.forEach((entry, index) => {
          projectGrid.append(entry);
          const image = entry.querySelector('img');
          if (image) image.loading = index < 2 ? 'eager' : 'lazy';
        });
      }
    </script>
    <Footer />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Projects',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: projectCatalogue.map((project, index) => ({
          '@type': 'ListItem', position: index + 1,
          item: { '@type': 'CreativeWork', name: project.title, description: project.description,
            url: new URL(project.href, Astro.site).href,
            ...(project.pubDate ? { datePublished: project.pubDate } : {}),
          },
        })),
      },
    })} />
  </body>
</html>
