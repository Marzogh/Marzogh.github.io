---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import { getTagMeta, toTagSlug } from '../../utils/tags';

const COLLECTION_CONFIG = [
  { name: 'blog', label: 'Notebook', basePath: '/notebook' },
  { name: 'projects', label: 'Projects', basePath: '/projects' },
  { name: 'docs', label: 'Docs', basePath: '/docs' },
  { name: 'education', label: 'Education', basePath: '/education' },
  { name: 'tools', label: 'Tools', basePath: '/tools' },
  { name: 'astrophotography', label: 'Astrophotography', basePath: '/astrophotography' },
] as const;

type CollectionName = (typeof COLLECTION_CONFIG)[number]['name'];

function toDateValue(data: Record<string, unknown>) {
  const candidate =
    data.pubDate ??
    data.updatedDate ??
    data.sessionDate ??
    null;
  const date = candidate instanceof Date ? candidate : new Date(String(candidate ?? ''));
  return Number.isNaN(date.valueOf()) ? 0 : date.valueOf();
}

function toDateLabel(data: Record<string, unknown>) {
  const candidate =
    data.pubDate ??
    data.updatedDate ??
    data.sessionDate ??
    null;
  const date = candidate instanceof Date ? candidate : new Date(String(candidate ?? ''));
  if (Number.isNaN(date.valueOf())) return null;
  return new Intl.DateTimeFormat('en-AU', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(date);
}

function pickThumb(data: Record<string, unknown>) {
  return (
    data.thumbnail ??
    data.thumb ??
    data.cover ??
    data.coverImage ??
    data.heroImage ??
    data.image ??
    null
  );
}

export async function getStaticPaths() {
  const slugToLabel = new Map<string, string>();
  const collectionConfig = [
    { name: 'blog', label: 'Notebook', basePath: '/notebook' },
    { name: 'projects', label: 'Projects', basePath: '/projects' },
    { name: 'docs', label: 'Docs', basePath: '/docs' },
    { name: 'education', label: 'Education', basePath: '/education' },
    { name: 'tools', label: 'Tools', basePath: '/tools' },
    { name: 'astrophotography', label: 'Astrophotography', basePath: '/astrophotography' },
  ] as const;

  for (const config of collectionConfig) {
    const entries = await getCollection(config.name, ({ data }) => !data.draft);
    for (const entry of entries) {
      const tags = Array.isArray(entry.data.tags) ? entry.data.tags : [];
      for (const tag of tags) {
        const slug = toTagSlug(tag);
        if (!slugToLabel.has(slug)) slugToLabel.set(slug, tag);
      }
    }
  }

  return [...slugToLabel.entries()].map(([tag, label]) => ({
    params: { tag },
    props: { label },
  }));
}

const { tag } = Astro.params;
const { label: _label } = Astro.props;

if (!tag) {
  throw new Error('Missing route parameter: tag');
}

const allItems = [];

for (const config of COLLECTION_CONFIG) {
  const entries = await getCollection(config.name, ({ data }) => !data.draft);
  for (const entry of entries) {
    const tags = Array.isArray(entry.data.tags) ? entry.data.tags : [];
    if (!tags.some((item) => toTagSlug(item) === tag)) continue;

    allItems.push({
      kind: config.label,
      url: `${config.basePath}/${entry.id}`,
      title: entry.data.title,
      description: entry.data.description ?? '',
      tags,
      dateLabel: toDateLabel(entry.data as Record<string, unknown>),
      dateValue: toDateValue(entry.data as Record<string, unknown>),
    });
  }
}

allItems.sort((a, b) => b.dateValue - a.dateValue || a.title.localeCompare(b.title));

const countByKind = allItems.reduce<Record<string, number>>((acc, item) => {
  acc[item.kind] = (acc[item.kind] ?? 0) + 1;
  return acc;
}, {});

const activeTag = getTagMeta(tag);
const coTagCounts = new Map<string, { label: string; count: number }>();

for (const item of allItems) {
  for (const itemTag of item.tags) {
    const itemSlug = toTagSlug(itemTag);
    if (itemSlug === tag) continue;
    const current = coTagCounts.get(itemSlug);
    coTagCounts.set(itemSlug, {
      label: itemTag,
      count: (current?.count ?? 0) + 1,
    });
  }
}

const relatedTags = [...coTagCounts.entries()]
  .sort((a, b) => {
    const relatedBias = (activeTag.related.includes(b[0]) ? 1 : 0) - (activeTag.related.includes(a[0]) ? 1 : 0);
    if (relatedBias !== 0) return relatedBias;
    return b[1].count - a[1].count || a[1].label.localeCompare(b[1].label);
  })
  .slice(0, 8)
  .map(([slug, info]) => ({
    slug,
    label: getTagMeta(slug, info.label).label,
    count: info.count,
  }));

const pageTitle = `${activeTag.label} — Tagged Content`;
const pageDescription = activeTag.description;
const kindSummary = Object.entries(countByKind)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const topKind = kindSummary[0];
const latestLabel = allItems[0]?.dateLabel ?? 'n/a';
const kindMixLabel = kindSummary.length
  ? kindSummary.map(([kind, count]) => `${kind}:${count}`).join(' · ')
  : 'n/a';
const statusLines = [
  { label: 'tagged_items', value: allItems.length },
  { label: 'collections', value: Object.keys(countByKind).length },
  { label: 'top_collection', value: topKind ? `${topKind[0]} (${topKind[1]})` : 'n/a' },
  { label: 'related_tags', value: relatedTags.length },
  { label: 'latest_item', value: latestLabel },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <Header />

    <main>
      <header class:list={['page-header', activeTag.family === 'radio' && 'page-header--radio']}>
        <p class="topics-kicker">Topics</p>
        <IndexHeader
          eyebrow={activeTag.eyebrow}
          title={activeTag.label}
          lede={pageDescription}
          terminalTitle={`tag.${tag}.log`}
          statusLines={statusLines}
        />
        <div class="meta-strip" aria-label="Tag collection mix">
          <span class="meta-strip__label">Collection mix</span>
          <span class="meta-strip__value">{kindMixLabel}</span>
        </div>
        {relatedTags.length ? (
          <div class="related">
            <p class="related__label">Related tags</p>
            <div class="related__list">
              {relatedTags.map((relatedTag) => (
                <a class="related__link" href={`/tags/${relatedTag.slug}`}>
                  <span>#{relatedTag.label}</span>
                  <span class="related__count">{relatedTag.count}</span>
                </a>
              ))}
            </div>
          </div>
        ) : null}
      </header>

      {allItems.length === 0 ? (
        <div class="panel panel--soft empty">
          <p class="empty-title">Nothing tagged {activeTag.label} yet.</p>
          <p class="empty-sub">Add this tag to published entries and they will appear here automatically.</p>
        </div>
      ) : (
        <>
          <section class="sortbar" aria-label="Sort tagged entries">
            <div class="sortbar__group" role="group" aria-label="Sort order">
              <button class="sortbar__button is-active" type="button" data-sort="newest">Newest</button>
              <button class="sortbar__button" type="button" data-sort="alpha">A-Z</button>
              <button class="sortbar__button" type="button" data-sort="collection">Collection</button>
            </div>
            <p class="sortbar__count">{allItems.length} archive item{allItems.length === 1 ? '' : 's'}</p>
          </section>

          <section class="archive-list" aria-label={`Items tagged ${activeTag.label}`}>
            {allItems.map((item) => (
            <article class="archive-item">
              <a href={item.url} class="archive-item__title" aria-label={`Open ${item.kind}: ${item.title}`}>
                {item.title}
              </a>
              <p class="archive-item__meta">
                <span>{item.kind}</span>
                {item.dateLabel ? <span>{item.dateLabel}</span> : null}
              </p>
              {item.description ? <p class="archive-item__desc">{item.description}</p> : null}
              <div class="archive-item__tags">
                {item.tags
                  .filter((itemTag) => toTagSlug(itemTag) !== tag)
                  .slice(0, 3)
                  .map((itemTag) => (
                    <a class="tag-link" href={`/tags/${toTagSlug(itemTag)}`}>
                      #{getTagMeta(itemTag).label}
                    </a>
                  ))}
              </div>
              <span
                class="archive-item__sortdata"
                data-title={item.title.toLowerCase()}
                data-kind={item.kind.toLowerCase()}
                data-date={item.dateValue}
                aria-hidden="true"
              ></span>
            </article>
          ))}
          </section>
        </>
      )}
    </main>

    <Footer />
  </body>
</html>

<script is:inline>
  (() => {
    const buttons = Array.from(document.querySelectorAll('.sortbar__button'));
    const list = document.querySelector('.archive-list');
    if (!buttons.length || !list) return;

    const items = Array.from(list.querySelectorAll('.archive-item'));

    const getSortData = (item) => {
      const node = item.querySelector('.archive-item__sortdata');
      return {
        title: node?.getAttribute('data-title') ?? '',
        kind: node?.getAttribute('data-kind') ?? '',
        date: Number(node?.getAttribute('data-date') ?? 0),
      };
    };

    const applySort = (mode) => {
      const sorted = [...items].sort((a, b) => {
        const aData = getSortData(a);
        const bData = getSortData(b);

        if (mode === 'alpha') {
          return aData.title.localeCompare(bData.title);
        }

        if (mode === 'collection') {
          return aData.kind.localeCompare(bData.kind) || bData.date - aData.date || aData.title.localeCompare(bData.title);
        }

        return bData.date - aData.date || aData.title.localeCompare(bData.title);
      });

      sorted.forEach((item) => list.appendChild(item));
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.getAttribute('data-sort') || 'newest';
        buttons.forEach((other) => other.classList.remove('is-active'));
        button.classList.add('is-active');
        applySort(mode);
      });
    });
  })();
</script>

<style>
  main {
    max-width: min(1320px, calc(100% - 2 * var(--space-5)));
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(620px 180px at top right, color-mix(in srgb, var(--accent) 16%, transparent 84%), transparent 72%),
      radial-gradient(460px 160px at bottom left, color-mix(in srgb, var(--leaf) 12%, transparent 88%), transparent 74%),
      var(--surface-raised);
    box-shadow: var(--shadow-sm);
  }

  .topics-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .page-header--radio {
    background:
      radial-gradient(620px 180px at top right, rgba(37, 99, 235, 0.14), transparent 72%),
      radial-gradient(560px 200px at bottom left, rgba(16, 185, 129, 0.12), transparent 72%),
      var(--surface-raised);
  }

  .page-header :global(.index-hero) {
    margin: 0;
    gap: var(--space-3);
  }

  .page-header :global(.index-hero__copy) {
    gap: 0.45rem;
  }

  .page-header :global(.index-hero__lede) {
    max-width: 64ch;
  }

  .page-header :global(.index-hero__title) {
    margin: 0;
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    line-height: 1.08;
    text-wrap: balance;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .page-header :global(.index-hero__title)::before {
    content: '#';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent 86%);
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent 74%);
  }

  .page-header :global(.index-hero__eyebrow) {
    display: none;
  }

  .page-header :global(.index-hero__terminal) {
    border-radius: 12px;
  }

  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.55rem 0.75rem;
    background: var(--surface-glass);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .meta-strip__label {
    color: var(--text-2);
  }

  .meta-strip__value {
    color: var(--text);
    font-weight: 600;
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related__label {
    margin: 0;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .related__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .related__link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.26rem 0.52rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-raised) 84%, var(--surface) 16%);
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.2;
    transition: border-color 120ms ease, background 120ms ease;
  }

  .related__link:hover {
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border) 58%);
    background: color-mix(in srgb, var(--surface-raised) 80%, var(--accent) 20%);
  }

  .related__count {
    display: inline-flex;
    min-width: 1rem;
    justify-content: center;
    color: var(--text-2);
    font-weight: 700;
  }

  .empty {
    padding: var(--space-6);
  }

  .empty-title,
  .empty-sub {
    margin: 0;
  }

  .empty-sub {
    margin-top: 0.4rem;
    color: var(--text-2);
  }

  .sortbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .sortbar__group {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem;
    background: var(--surface-glass);
  }

  .sortbar__button {
    border: 0;
    background: transparent;
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: var(--text-2);
    cursor: pointer;
  }

  .sortbar__button:hover {
    background: color-mix(in srgb, var(--surface-raised) 88%, var(--accent) 12%);
    color: var(--text);
  }

  .sortbar__button.is-active {
    background: color-mix(in srgb, var(--surface-raised) 78%, var(--accent) 22%);
    color: var(--text);
  }

  .sortbar__count {
    margin: 0;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .archive-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 0.9rem;
  }

  .archive-item {
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-raised);
    display: grid;
    gap: 0.5rem;
    box-shadow: var(--shadow-sm);
  }

  .archive-item__title {
    margin: 0;
    color: var(--text);
    text-decoration: none;
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
    font-weight: 650;
    line-height: 1.2;
  }

  .archive-item__title:hover {
    color: var(--accent);
  }

  .archive-item__meta {
    margin: 0;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .archive-item__desc {
    margin: 0;
    color: var(--text-2);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .archive-item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .archive-item__sortdata {
    display: none;
  }

  @media (max-width: 720px) {
    main {
      max-width: calc(100% - 2 * var(--space-4));
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }

    .archive-item {
      padding: 0.85rem 0.9rem;
    }

    .page-header {
      padding: var(--space-4);
    }

    .meta-strip {
      font-size: 0.75rem;
    }

    .sortbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
    }
  }
</style>
