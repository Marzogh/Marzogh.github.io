---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getTagMeta, toTagSlug } from '../../utils/tags';

const COLLECTION_CONFIG = [
  { name: 'blog', label: 'Notebook', basePath: '/notebook' },
  { name: 'projects', label: 'Projects', basePath: '/projects' },
  { name: 'docs', label: 'Docs', basePath: '/docs' },
  { name: 'education', label: 'Education', basePath: '/education' },
  { name: 'tools', label: 'Tools', basePath: '/tools' },
  { name: 'astrophotography', label: 'Astrophotography', basePath: '/astrophotography' },
] as const;

type CollectionName = (typeof COLLECTION_CONFIG)[number]['name'];

function toDateValue(data: Record<string, unknown>) {
  const candidate =
    data.pubDate ??
    data.updatedDate ??
    data.sessionDate ??
    null;
  const date = candidate instanceof Date ? candidate : new Date(String(candidate ?? ''));
  return Number.isNaN(date.valueOf()) ? 0 : date.valueOf();
}

function toDateLabel(data: Record<string, unknown>) {
  const candidate =
    data.pubDate ??
    data.updatedDate ??
    data.sessionDate ??
    null;
  const date = candidate instanceof Date ? candidate : new Date(String(candidate ?? ''));
  if (Number.isNaN(date.valueOf())) return null;
  return new Intl.DateTimeFormat('en-AU', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(date);
}

function pickThumb(data: Record<string, unknown>) {
  return (
    data.thumbnail ??
    data.thumb ??
    data.cover ??
    data.coverImage ??
    data.heroImage ??
    data.image ??
    null
  );
}

export async function getStaticPaths() {
  const slugToLabel = new Map<string, string>();
  const collectionConfig = [
    { name: 'blog', label: 'Notebook', basePath: '/notebook' },
    { name: 'projects', label: 'Projects', basePath: '/projects' },
    { name: 'docs', label: 'Docs', basePath: '/docs' },
    { name: 'education', label: 'Education', basePath: '/education' },
    { name: 'tools', label: 'Tools', basePath: '/tools' },
    { name: 'astrophotography', label: 'Astrophotography', basePath: '/astrophotography' },
  ] as const;

  for (const config of collectionConfig) {
    const entries = await getCollection(config.name, ({ data }) => !data.draft);
    for (const entry of entries) {
      const tags = Array.isArray(entry.data.tags) ? entry.data.tags : [];
      for (const tag of tags) {
        const slug = toTagSlug(tag);
        if (!slugToLabel.has(slug)) slugToLabel.set(slug, tag);
      }
    }
  }

  return [...slugToLabel.entries()].map(([tag, label]) => ({
    params: { tag },
    props: { label },
  }));
}

const { tag } = Astro.params;
const { label: _label } = Astro.props;

if (!tag) {
  throw new Error('Missing route parameter: tag');
}

const allItems = [];

for (const config of COLLECTION_CONFIG) {
  const entries = await getCollection(config.name, ({ data }) => !data.draft);
  for (const entry of entries) {
    const tags = Array.isArray(entry.data.tags) ? entry.data.tags : [];
    if (!tags.some((item) => toTagSlug(item) === tag)) continue;

    allItems.push({
      kind: config.label,
      url: `${config.basePath}/${entry.id}`,
      title: entry.data.title,
      description: entry.data.description ?? '',
      tags,
      dateLabel: toDateLabel(entry.data as Record<string, unknown>),
      dateValue: toDateValue(entry.data as Record<string, unknown>),
    });
  }
}

allItems.sort((a, b) => b.dateValue - a.dateValue || a.title.localeCompare(b.title));

const countByKind = allItems.reduce<Record<string, number>>((acc, item) => {
  acc[item.kind] = (acc[item.kind] ?? 0) + 1;
  return acc;
}, {});

const activeTag = getTagMeta(tag);
const coTagCounts = new Map<string, { label: string; count: number }>();

for (const item of allItems) {
  for (const itemTag of item.tags) {
    const itemSlug = toTagSlug(itemTag);
    if (itemSlug === tag) continue;
    const current = coTagCounts.get(itemSlug);
    coTagCounts.set(itemSlug, {
      label: itemTag,
      count: (current?.count ?? 0) + 1,
    });
  }
}

const relatedTags = [...coTagCounts.entries()]
  .sort((a, b) => {
    const relatedBias = (activeTag.related.includes(b[0]) ? 1 : 0) - (activeTag.related.includes(a[0]) ? 1 : 0);
    if (relatedBias !== 0) return relatedBias;
    return b[1].count - a[1].count || a[1].label.localeCompare(b[1].label);
  })
  .slice(0, 8)
  .map(([slug, info]) => ({
    slug,
    label: getTagMeta(slug, info.label).label,
    count: info.count,
  }));

const pageTitle = `${activeTag.label} — Tagged Content`;
const pageDescription = activeTag.description;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <Header />

    <main>
      <header class:list={['page-header', activeTag.family === 'radio' && 'page-header--radio']}>
        <p class="eyebrow">{activeTag.eyebrow}</p>
        <h1 class="page-title">{activeTag.label}</h1>
        <p class="page-lede">{pageDescription}</p>
        <div class="summary">
          <div class="summaryCard">
            <div class="summaryCard__num">{allItems.length}</div>
            <div class="summaryCard__lbl">Resources tagged</div>
          </div>
          <div class="summaryCard">
            <div class="summaryCard__num">{Object.keys(countByKind).length}</div>
            <div class="summaryCard__lbl">Collection{Object.keys(countByKind).length === 1 ? '' : 's'}</div>
          </div>
          <div class="summaryBreakdown">
            {Object.entries(countByKind).map(([kind, count]) => (
              <span class="summary__pill">{kind}: {count}</span>
            ))}
          </div>
        </div>
        {relatedTags.length ? (
          <div class="related">
            <p class="related__label">Related tags</p>
            <div class="related__list">
              {relatedTags.map((relatedTag) => (
                <a class="pill" href={`/tags/${relatedTag.slug}`}>
                  #{relatedTag.label} <span class="pill__count">{relatedTag.count}</span>
                </a>
              ))}
            </div>
          </div>
        ) : null}
      </header>

      {allItems.length === 0 ? (
        <div class="panel panel--soft empty">
          <p class="empty-title">Nothing tagged {activeTag.label} yet.</p>
          <p class="empty-sub">Add this tag to published entries and they will appear here automatically.</p>
        </div>
      ) : (
        <section class="archive-list" aria-label={`Items tagged ${activeTag.label}`}>
          {allItems.map((item) => (
            <article class="archive-item">
              <a href={item.url} class="archive-item__title" aria-label={`Open ${item.kind}: ${item.title}`}>
                {item.title}
              </a>
              <p class="archive-item__meta">
                <span>{item.kind}</span>
                {item.dateLabel ? <span>{item.dateLabel}</span> : null}
              </p>
              {item.description ? <p class="archive-item__desc">{item.description}</p> : null}
              <div class="archive-item__tags">
                {item.tags
                  .filter((itemTag) => toTagSlug(itemTag) !== tag)
                  .slice(0, 3)
                  .map((itemTag) => (
                    <a class="pill pill--muted" href={`/tags/${toTagSlug(itemTag)}`}>
                      #{getTagMeta(itemTag).label}
                    </a>
                  ))}
              </div>
            </article>
          ))}
        </section>
      )}
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    max-width: min(1320px, calc(100% - 2 * var(--space-5)));
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: 24px;
    background:
      radial-gradient(620px 180px at top right, color-mix(in srgb, var(--accent) 16%, transparent 84%), transparent 72%),
      radial-gradient(460px 160px at bottom left, color-mix(in srgb, var(--leaf) 12%, transparent 88%), transparent 74%),
      var(--surface-raised);
    box-shadow: var(--shadow-sm);
  }

  .page-header--radio {
    background:
      radial-gradient(620px 180px at top right, rgba(37, 99, 235, 0.14), transparent 72%),
      radial-gradient(560px 200px at bottom left, rgba(16, 185, 129, 0.12), transparent 72%),
      var(--surface-raised);
  }

  .eyebrow {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .page-title {
    margin: 0;
    font-size: clamp(2.2rem, 4.2vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .page-lede {
    margin: 0;
    max-width: 70ch;
    color: var(--text-2);
  }

  .summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-3);
  }

  .summaryCard,
  .summaryBreakdown,
  .summary__pill,
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .summaryCard,
  .summaryBreakdown {
    border: 1px solid var(--border);
    background: var(--surface-glass);
    border-radius: 16px;
    padding: 0.95rem 1rem;
  }

  .summaryCard {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .summaryCard__num {
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
  }

  .summaryCard__lbl {
    margin-top: 6px;
    font-size: 0.92rem;
    color: var(--text-2);
  }

  .summaryBreakdown {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    align-content: flex-start;
  }

  .summary__pill,
  .pill {
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-raised) 72%, var(--surface) 28%);
    color: var(--text-2);
    font-size: 0.92rem;
  }

  .pill--muted {
    opacity: 0.82;
  }

  .pill__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.4rem;
    height: 1.4rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-raised) 78%, var(--surface) 22%);
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .related__label {
    margin: 0;
    color: var(--text-2);
    font-size: 0.95rem;
  }

  .related__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .related__list a.pill {
    text-decoration: none;
    color: var(--text);
    transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
  }

  .related__list a.pill:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border) 58%);
    background: color-mix(in srgb, var(--surface-raised) 66%, var(--accent) 34%);
  }

  .empty {
    padding: var(--space-6);
  }

  .empty-title,
  .empty-sub {
    margin: 0;
  }

  .empty-sub {
    margin-top: 0.4rem;
    color: var(--text-2);
  }

  .archive-list {
    display: grid;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface-raised);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .archive-item {
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--border);
    display: grid;
    gap: 0.6rem;
  }

  .archive-item:first-child {
    border-top: 0;
  }

  .archive-item__title {
    margin: 0;
    color: var(--text);
    text-decoration: none;
    font-size: clamp(1.2rem, 1.7vw, 1.55rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .archive-item__title:hover {
    color: var(--accent);
  }

  .archive-item__meta {
    margin: 0;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .archive-item__desc {
    margin: 0;
    color: var(--text-2);
    max-width: 90ch;
  }

  .archive-item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .archive-item__tags .pill {
    text-decoration: none;
  }

  @media (max-width: 720px) {
    main {
      max-width: calc(100% - 2 * var(--space-4));
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }

    .archive-item {
      padding: var(--space-4);
    }

    .page-header {
      padding: var(--space-4);
    }
  }
</style>
