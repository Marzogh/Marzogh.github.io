---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import PoetryRightsNotice from '../../components/PoetryRightsNotice.astro';
import { poetry, poetryBySlug } from '../../data/poetry';

export async function getStaticPaths() {
  return poetry.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing route parameter: slug');

const entry = poetryBySlug.get(slug);
if (!entry) throw new Error(`Poem not found: ${slug}`);

const previous = poetry.find((item) => item.pubDateValue.getTime() < entry.pubDateValue.getTime()) ?? null;
const next = [...poetry].reverse().find((item) => item.pubDateValue.getTime() > entry.pubDateValue.getTime()) ?? null;
const archivePosition = poetry.findIndex((item) => item.slug === entry.slug) + 1;
const displayDate = new Intl.DateTimeFormat('en-AU', { day: '2-digit', month: 'short', year: 'numeric' }).format(entry.pubDateValue);
const titleMark = entry.title.replace(/^[^A-Za-z]+/, '').charAt(0) || 'P';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${entry.title} — Poetry — Chips’nCode`} description={entry.excerpt} />
  </head>
  <body>
    <Header />
    <main class:list={['poem-page', entry.backgroundImage && 'poem-page--withArt']}>
      {entry.backgroundImage ? (
        <div class="poem-page__wash" style={`background-image: url('${entry.backgroundImage}')`} aria-hidden="true"></div>
      ) : null}

      <article class="poem-entry">
        <a href="/poetry" class="poem-back">← Back to Poetry</a>

        <PageHeader
          kicker="Poetry / archive"
          title={entry.title}
          variant="article"
          meta={[
            { label: 'Written', value: displayDate },
            { label: 'Entry', value: `${String(archivePosition).padStart(2, '0')} / ${poetry.length}` },
            { label: 'Source', value: entry.headerImage ? 'Original page' : 'Text archive' },
          ]}
        />

        <div class="poem-layout">
          <aside class="poem-artifact" aria-label={entry.headerImage ? 'Original title graphic' : 'Text archive marker'}>
            <p class="editorial-kicker">Surviving artifact</p>
            {entry.headerImage ? (
              <figure class="poem-artifact__image">
                <img src={entry.headerImage} alt="" loading="eager" decoding="async" />
                <figcaption>Original title graphic, preserved as part of the archive.</figcaption>
              </figure>
            ) : (
              <div class="poem-artifact__textOnly">
                <span aria-hidden="true">{titleMark}</span>
                <p>No original title graphic survives for this entry.</p>
              </div>
            )}
          </aside>

          <section class="poem-body" aria-label="Poem text">
            <header class="poem-body__head">
              <span>Poem</span>
              <span>{entry.lines.filter(Boolean).length} lines</span>
            </header>
            <div class="poem-text" aria-label="Poem text">
              {entry.lines.map((line) =>
                line ? <div class="poem-line">{line}</div> : <div class="poem-gap" aria-hidden="true"></div>
              )}
            </div>
          </section>

          <aside class="poem-marginalia" aria-label="Archive note">
            <div>
              <p class="editorial-kicker">Provenance</p>
              <p>This text is preserved from the poetry archive. Surviving legacy material remains with the poem rather than being rebuilt into something newer.</p>
            </div>
            <div class="poem-marginalia__rights"><PoetryRightsNotice compact={true} /></div>
          </aside>
        </div>

        <nav class="poem-nav" aria-label="Poem navigation">
          {next ? (
            <a class="poem-nav__link" href={`/poetry/${next.slug}`}>
              <span class="poem-nav__label">Newer</span>
              <span class="poem-nav__title">{next.title}</span>
            </a>
          ) : <span></span>}
          {previous ? (
            <a class="poem-nav__link poem-nav__link--next" href={`/poetry/${previous.slug}`}>
              <span class="poem-nav__label">Older</span>
              <span class="poem-nav__title">{previous.title}</span>
            </a>
          ) : null}
        </nav>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .poem-page {
    position: relative;
    max-width: min(1380px, calc(100% - 2 * var(--space-5)));
  }

  .poem-page__wash {
    position: fixed;
    inset: 0;
    background-position: center;
    background-size: cover;
    opacity: 0.08;
    filter: saturate(0.85);
    pointer-events: none;
    z-index: -2;
  }

  .poem-page__wash::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(248, 244, 234, 0.9), rgba(246, 241, 230, 0.97)),
      radial-gradient(900px 280px at top left, rgba(181, 101, 29, 0.08), transparent 72%);
  }

  .poem-entry {
    display: flex;
    flex-direction: column;
    gap: clamp(1.6rem, 2.4vw, 2.3rem);
  }

  .poem-back {
    width: fit-content;
    text-decoration: none;
    color: var(--text-2);
    font-size: 0.9rem;
  }

  .poem-back:hover {
    color: var(--accent);
  }

  .poem-layout {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.4rem, 4vw, 4.6rem);
    align-items: start;
    position: relative;
    padding-top: 1.2rem;
    padding-bottom: 0.6rem;
  }

  .poem-layout::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 0.5px);
    width: 1px;
    background:
      linear-gradient(
        180deg,
        transparent 0%,
        color-mix(in srgb, var(--border) 82%, transparent) 8%,
        color-mix(in srgb, var(--border) 82%, transparent) 92%,
        transparent 100%
      );
    opacity: 0.72;
    pointer-events: none;
  }

  .poem-record {
    display: grid;
    gap: 1.05rem;
    align-content: start;
    position: sticky;
    top: calc(var(--header-height, 4.5rem) + 3rem);
    align-self: start;
    padding-right: clamp(1rem, 2vw, 1.6rem);
  }

  .poem-record__copy {
    display: grid;
    gap: 0.9rem;
  }

  .poem-record__eyebrow,
  .poem-record__note,
  .poem-record__artifactLabel {
    margin: 0;
  }

  .poem-record__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .poem-title {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(2.25rem, 3.6vw, 3.7rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .poem-record__meta {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-top: 0.5rem;
  }

  .poem-record__metaRow {
    display: grid;
    gap: 0.24rem;
  }

  .poem-record__metaRow dt,
  .poem-record__metaRow dd {
    margin: 0;
  }

  .poem-record__metaRow dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .poem-record__metaRow dd,
  .poem-record__note {
    color: var(--text-2);
    line-height: 1.68;
    max-width: 31ch;
    padding-top: 0.45rem;
    font-size: 0.96rem;
  }

  .poem-record__artifact {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 0.3rem;
  }

  .poem-record__artifactLabel {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .poem-record__artifact img {
    max-width: 100%;
    max-height: 112px;
    display: block;
    height: auto;
  }

  .poem-body {
    padding-left: clamp(1.6rem, 3vw, 2.8rem);
    min-width: 0;
  }

  .poem-text {
    font-family: var(--font-serif);
    font-size: clamp(1.16rem, 1.2vw, 1.34rem);
    line-height: 1.96;
    color: var(--text);
    max-width: 32em;
  }

  .poem-line {
    white-space: pre-wrap;
  }

  .poem-gap {
    height: 1.65rem;
  }

  .poem-provenance {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 1.6rem;
    align-items: start;
    padding-top: 1.1rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
  }

  .poem-provenance p {
    margin: 0;
    max-width: none;
    color: var(--text-2);
    line-height: 1.68;
  }

  .poem-provenance__note {
    font-size: 0.98rem;
  }

  .poem-provenance__rights {
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .poem-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    padding-top: 0.55rem;
  }

  .poem-nav__link {
    display: grid;
    gap: 0.2rem;
    color: var(--text);
    text-decoration: none;
    padding-top: 0.2rem;
  }

  .poem-nav__link--next {
    text-align: right;
  }

  .poem-nav__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .poem-nav__title {
    font-size: 1rem;
    line-height: 1.45;
  }

  .poem-nav__link:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .poem-layout {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .poem-layout::before {
      display: none;
    }

    .poem-title {
      max-width: none;
    }

    .poem-record {
      position: static;
      padding-right: 0;
    }

    .poem-body {
      padding-left: 0;
    }

    .poem-provenance {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .poem-nav {
      grid-template-columns: 1fr;
    }

    .poem-record__metaRow {
      gap: 0.2rem;
    }

    .poem-nav__link--next {
      text-align: left;
    }
  }

  /* Shared poem template: artifact, verse and provenance. */
  .poem-page {
    width: min(100% - 48px, 1500px);
    max-width: none;
    padding-top: 1.25rem;
  }

  .poem-page__wash {
    opacity: 0.075;
    filter: saturate(0.72) contrast(0.92);
  }

  .poem-page__wash::after {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--paper) 90%, transparent), color-mix(in srgb, var(--paper) 97%, transparent)),
      radial-gradient(900px 280px at top left, color-mix(in srgb, var(--accent) 8%, transparent), transparent 72%);
  }

  .poem-entry {
    gap: 1rem;
  }

  .poem-entry :global(.page-header--article) {
    padding-top: 0.65rem;
  }

  .poem-entry :global(.page-header--article h1) {
    max-width: 18ch;
    font-size: clamp(2.2rem, 3.4vw, 3.5rem);
  }

  .poem-back {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .poem-layout {
    display: grid;
    grid-template-columns: minmax(180px, 230px) minmax(360px, 1fr) minmax(200px, 250px);
    gap: 0;
    align-items: start;
    padding: 0;
    border-block: 1px solid var(--text);
  }

  .poem-layout::before {
    display: none;
  }

  .poem-artifact,
  .poem-marginalia {
    position: sticky;
    top: calc(var(--header-height, 4.5rem) + 1.25rem);
    align-self: start;
  }

  .poem-artifact {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.25rem 1.25rem 0;
    border-right: 1px solid var(--border);
  }

  .poem-artifact__image {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .poem-artifact__image img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 120px;
    object-fit: contain;
    object-position: left top;
  }

  .poem-artifact__image figcaption,
  .poem-artifact__textOnly p,
  .poem-marginalia p {
    margin: 0;
    color: var(--text-2);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .poem-artifact__textOnly {
    display: grid;
    gap: 0.65rem;
  }

  .poem-artifact__textOnly > span {
    color: var(--accent);
    font-family: var(--font-filigree);
    font-size: clamp(2.35rem, 3vw, 3rem);
    font-weight: 400;
    font-synthesis: none;
    line-height: 1;
  }

  .poem-body {
    min-width: 0;
    padding: 1.25rem clamp(1.5rem, 4vw, 4rem) 2.5rem;
  }

  .poem-body__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .poem-text {
    max-width: 38em;
    margin-inline: auto;
    color: var(--text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.08rem, 1.18vw, 1.24rem);
    line-height: 1.88;
  }

  .poem-gap {
    height: 1.35rem;
  }

  .poem-marginalia {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem 0 1.25rem 1.25rem;
    border-left: 1px solid var(--border);
  }

  .poem-marginalia > div {
    display: grid;
    gap: 0.65rem;
  }

  .poem-marginalia__rights {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .poem-nav {
    gap: 0;
    padding-top: 0;
    border-block: 1px solid var(--border);
  }

  .poem-nav__link {
    min-height: 92px;
    padding: 0.85rem 1rem;
  }

  .poem-nav__link + .poem-nav__link,
  .poem-nav > span + .poem-nav__link {
    border-left: 1px solid var(--border);
  }

  @media (max-width: 1100px) {
    .poem-layout {
      grid-template-columns: minmax(160px, 210px) minmax(0, 1fr);
    }

    .poem-marginalia {
      position: static;
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(240px, 0.7fr);
      padding: 1rem 0;
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .poem-marginalia__rights {
      padding: 0 0 0 1rem;
      border-top: 0;
      border-left: 1px solid var(--border);
    }
  }

  @media (max-width: 720px) {
    .poem-page {
      width: min(100% - 28px, 1500px);
    }

    .poem-layout {
      grid-template-columns: 1fr;
    }

    .poem-artifact,
    .poem-marginalia {
      position: static;
    }

    .poem-artifact {
      padding: 1rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .poem-artifact__image img {
      max-height: 90px;
    }

    .poem-body {
      padding: 1rem 0 2rem;
    }

    .poem-text {
      margin-inline: 0;
      font-size: 1.05rem;
      line-height: 1.82;
    }

    .poem-marginalia {
      grid-template-columns: 1fr;
    }

    .poem-marginalia__rights {
      padding: 0.75rem 0 0;
      border-top: 1px solid var(--border);
      border-left: 0;
    }
  }
</style>
