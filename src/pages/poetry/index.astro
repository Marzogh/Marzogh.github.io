---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import PoetryRightsNotice from '../../components/PoetryRightsNotice.astro';
import { poetry } from '../../data/poetry';

const latest = poetry[0] ?? null;
const earliest = poetry[poetry.length - 1] ?? null;
const poemsByYear = poetry.reduce((acc, entry) => {
  const year = entry.pubDateValue.getUTCFullYear();
  const bucket = acc.get(year) ?? [];
  bucket.push(entry);
  acc.set(year, bucket);
  return acc;
}, new Map<number, typeof poetry>());
const years = [...poemsByYear.keys()].sort((a, b) => b - a);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Poetry — Chips’nCode"
      description="Poems of wind, sea, starlight, wild country, grief, climate dread, reverence for life, and the search for peace without looking away."
    />
  </head>
  <body>
    <Header />

    <main class="poetry-index">
      <section class="poetry-hero" aria-label="Poetry introduction">
        <p class="poetry-hero__eyebrow">Verse</p>
        <h1 class="poetry-hero__title">Poetry</h1>

        <article class="poetry-curator">
          <div class="poetry-curator__intro">
            <p class="poetry-curator__lede">
              These poems are kept here as an archive rather than a feed: work written across childhood and youth, arranged
              so the recurrences are visible in sequence rather than hidden by summary.
            </p>

            <p class="poetry-curator__paragraph">
              The same concerns return again and again in different light: weather, stars, wilderness, solitude, joy,
              grief, damage, longing, and the attempt to live with a clear eye in a wounded world. Read straight
              through and the poems start speaking to one another.
            </p>

            <p class="poetry-curator__paragraph">
              The natural world is not decoration in this archive. It is witness, refuge, teacher, and measure. That
              is why so many pieces turn toward rain, sea, birds, hills, wind, and starlight when they are really
              trying to say something about scale, consequence, and how a human life ought to be lived.
            </p>

            <p class="poetry-curator__paragraph poetry-curator__paragraph--continue">
              <a href="/poetry/curators-note">Continue to read the full curator’s note</a>
            </p>
          </div>

          <aside class="poetry-ledger" aria-label="Collection note">
            <p class="poetry-ledger__eyebrow">Collection</p>
            <dl class="poetry-ledger__grid">
              <div class="poetry-ledger__row">
                <dt>Poems</dt>
                <dd>{poetry.length}</dd>
              </div>
              <div class="poetry-ledger__row">
                <dt>Span</dt>
                <dd>{earliest ? earliest.pubDate : 'n/a'} to {latest ? latest.pubDate : 'n/a'}</dd>
              </div>
              <div class="poetry-ledger__row">
                <dt>Structure</dt>
                <dd>Chronological archive</dd>
              </div>
              <div class="poetry-ledger__row">
                <dt>Source</dt>
                <dd>Original pages and text files</dd>
              </div>
            </dl>
            <p class="poetry-ledger__note">
              This is laid out as an archive rather than a gallery. Read straight through if you want to watch the same
              concerns return in different light: weather, stars, wilderness, myth, solitude, joy, grief, damage, and
              the long attempt to work out what it means to live well without looking away.
            </p>
          </aside>

          <div class="poetry-curator__rights">
            <PoetryRightsNotice compact={true} />
          </div>
        </article>
      </section>

      <section class="poetry-archive" aria-label="Poetry archive">
        <div class="poetry-archive__head">
          <p class="poetry-archive__eyebrow">Archive</p>
          <h2 class="poetry-archive__title">Chronology</h2>
        </div>

        {years.map((year) => (
          <section class="poetry-year" aria-labelledby={`poetry-year-${year}`}>
            <div class="poetry-year__head">
              <h3 id={`poetry-year-${year}`}>{year}</h3>
              <p>{poemsByYear.get(year)?.length ?? 0} poem{(poemsByYear.get(year)?.length ?? 0) === 1 ? '' : 's'}</p>
            </div>

            <div class="poetry-list">
              {poemsByYear.get(year)?.map((entry) => (
                <article class="poetry-row">
                  <div class="poetry-row__meta">
                    <span class="poetry-row__date">
                      <FormattedDate date={entry.pubDateValue} />
                    </span>
                    <span class="poetry-row__artifact">{entry.headerImage ? 'Original title graphic preserved' : 'Text archive entry'}</span>
                  </div>

                  <div class="poetry-row__body">
                    <h4 class="poetry-row__title">
                      <a href={`/poetry/${entry.slug}`}>{entry.title}</a>
                    </h4>
                    <p class="poetry-row__excerpt">{entry.excerpt}</p>
                  </div>

                  {entry.headerImage ? (
                    <a class="poetry-row__graphic" href={`/poetry/${entry.slug}`} aria-label={`Open poem: ${entry.title}`}>
                      <img src={entry.headerImage} alt="" loading="lazy" decoding="async" />
                    </a>
                  ) : (
                    <div class="poetry-row__graphicNote" aria-hidden="true">
                      <span>Text only</span>
                    </div>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))}
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .poetry-index {
    max-width: min(1320px, calc(100% - 2 * var(--space-5)));
  }

  .poetry-hero {
    display: grid;
    gap: 1rem;
    margin-bottom: var(--space-7);
  }

  .poetry-hero__eyebrow,
  .poetry-hero__title {
    margin: 0;
  }

  .poetry-hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .poetry-hero__title {
    margin-top: 0.35rem;
    margin-bottom: 0;
  }

  .poetry-curator {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 360px);
    column-gap: clamp(2rem, 4vw, 4rem);
    row-gap: 1.4rem;
    align-items: start;
    padding-top: 1.1rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
  }

  .poetry-curator__intro {
    display: grid;
    gap: 0.9rem;
    max-width: 70ch;
  }

  .poetry-curator__lede,
  .poetry-curator__paragraph {
    margin: 0;
  }

  .poetry-curator__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.18rem, 1.55vw, 1.42rem);
    line-height: 1.72;
    color: var(--text);
    text-wrap: balance;
  }

  .poetry-ledger {
    width: 100%;
    margin: 0;
    padding-left: clamp(1rem, 2vw, 1.5rem);
    border-left: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
  }

  .poetry-ledger__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .poetry-ledger__grid {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .poetry-ledger__row {
    display: grid;
    gap: 0.3rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
  }

  .poetry-ledger__row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .poetry-ledger__row dt,
  .poetry-ledger__row dd,
  .poetry-ledger__note {
    margin: 0;
  }

  .poetry-ledger__row dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .poetry-ledger__row dd {
    color: var(--text);
    line-height: 1.45;
  }

  .poetry-ledger__note {
    margin-top: 1rem;
    color: var(--text-2);
    line-height: 1.68;
    font-size: 0.96rem;
  }

  .poetry-curator__paragraph {
    color: var(--text-2);
    font-size: clamp(1rem, 1.02vw, 1.06rem);
    line-height: 1.8;
  }

  .poetry-curator__paragraph--continue {
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  .poetry-curator__paragraph--continue a {
    color: var(--accent);
    text-decoration: none;
  }

  .poetry-curator__paragraph--continue a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .poetry-curator__rights {
    grid-column: 1 / -1;
    max-width: none;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .poetry-archive {
    display: grid;
    gap: var(--space-5);
  }

  .poetry-archive__head {
    display: grid;
    gap: 0.35rem;
  }

  .poetry-archive__eyebrow,
  .poetry-archive__title {
    margin: 0;
  }

  .poetry-archive__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .poetry-year {
    display: grid;
    gap: 0.85rem;
  }

  .poetry-year__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--border);
  }

  .poetry-year__head h3,
  .poetry-year__head p {
    margin: 0;
  }

  .poetry-year__head p {
    color: var(--text-2);
    font-size: 0.95rem;
  }

  .poetry-list {
    display: grid;
  }

  .poetry-row {
    display: grid;
    grid-template-columns: minmax(100px, 124px) minmax(0, 1fr) minmax(88px, 132px);
    gap: 1.2rem;
    align-items: start;
    padding: 0.95rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 74%, transparent);
  }

  .poetry-row:last-child {
    border-bottom: 0;
  }

  .poetry-row__meta {
    display: grid;
    gap: 0.35rem;
    padding-top: 0.2rem;
  }

  .poetry-row__date {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .poetry-row__artifact {
    font-family: var(--font-mono);
    font-size: 0.67rem;
    line-height: 1.5;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .poetry-row__body {
    display: grid;
    gap: 0.32rem;
  }

  .poetry-row__title,
  .poetry-row__excerpt {
    margin: 0;
  }

  .poetry-row__title a {
    color: var(--text);
    text-decoration: none;
  }

  .poetry-row__title a:hover {
    color: var(--accent);
  }

  .poetry-row__excerpt {
    color: var(--text-2);
    line-height: 1.62;
    max-width: 64ch;
  }

  .poetry-row__graphic {
    align-self: center;
    justify-self: end;
    text-decoration: none;
  }

  .poetry-row__graphic img {
    max-width: min(132px, 100%);
    max-height: 48px;
    height: auto;
    display: block;
    opacity: 0.92;
  }

  .poetry-row__graphicNote {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  @media (max-width: 920px) {
    .poetry-curator {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 1.25rem;
    }

    .poetry-ledger {
      padding-left: 0;
      padding-top: 1rem;
      border-left: 0;
      border-top: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
    }

    .poetry-curator__intro,
    .poetry-ledger__note,
    .poetry-row__excerpt {
      max-width: none;
    }

    .poetry-row {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .poetry-row__graphic,
    .poetry-row__graphicNote {
      justify-self: start;
      justify-content: flex-start;
    }
  }
 </style>
