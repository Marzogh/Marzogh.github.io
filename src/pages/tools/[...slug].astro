---
import { getCollection, getEntry, render } from 'astro:content';
import ToolPost from '../../layouts/ToolPost.astro';

export async function getStaticPaths() {
  const entries = await getCollection('tools', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing route parameter: slug');
const entry = await getEntry('tools', slug);
if (!entry) throw new Error(`Tool entry not found: ${slug}`);

const tags = new Set((entry.data.tags ?? []).map((tag) => tag.toLowerCase()));
const instrument = tags.has('analysis') || tags.has('mapping') || tags.has('leaflet') || tags.has('interactive');
const kind = tags.has('mapping') && tags.has('analysis')
  ? 'Analysis and mapping instrument'
  : tags.has('mapping')
    ? 'Mapping instrument'
  : tags.has('analysis')
    ? 'Analysis instrument'
    : tags.has('rgb565') && tags.has('interactive')
      ? 'Colour instrument'
    : tags.has('rgb565')
      ? 'Colour reference'
      : tags.has('downloader')
        ? 'Download utility'
        : 'Tool';
const { Content } = await render(entry);
---

<ToolPost entry={entry} kind={kind} instrument={instrument}>
  <Content />
</ToolPost>
