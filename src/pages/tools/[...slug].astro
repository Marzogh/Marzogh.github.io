---
import { getCollection, getEntry, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { toTagSlug } from '../../utils/tags';

export async function getStaticPaths() {
  const entries = await getCollection('tools', ({ data }) => !data.draft);

  if (!entries || entries.length === 0) {
    return [];
  }

  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing route parameter: slug');
}

const entry = await getEntry('tools', slug);

if (!entry) {
  throw new Error(`Tool entry not found: ${slug}`);
}

const { Content } = await render(entry);
const headerStyle = entry.data.headerStyle ?? 'plain';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={entry.data.title} description={entry.data.description} />
  </head>
  <body>
    <Header />
    <main class="tools-page">
      <article class="tools-entry">
        <a href="/tools" class="tools-back">
          ← Back to Tools
        </a>

        <header class:list={['tools-hero', headerStyle === 'panel' && 'panel', headerStyle === 'plain' && 'tools-hero--plain']}>
          <div class="tools-hero__eyebrow meta-row">
            <div class="meta-cluster">
              <span class="meta-kicker">Tool</span>
              {entry.data.featured ? <span class="meta-status">Featured</span> : null}
            </div>
            {entry.data.pubDate ? (
              <span class="meta-date">
                <FormattedDate date={entry.data.pubDate} />
              </span>
            ) : null}
          </div>

          <h1 class="tools-title">{entry.data.title}</h1>

          {entry.data.description ? <p class="tools-description">{entry.data.description}</p> : null}

          <div class="tools-meta">
            {entry.data.updatedDate ? (
              <span class="tools-meta__item">
                Updated <FormattedDate date={entry.data.updatedDate} />
              </span>
            ) : null}
          </div>

          {entry.data.tags?.length ? (
            <div class="tools-tags tag-list" aria-label="Tool tags">
              {entry.data.tags.map((tag) => (
                <a class="tag-link" href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>
              ))}
            </div>
          ) : null}
        </header>

        <div class="tools-body panel panel--soft">
          <div class="prose prose--tools">
            <Content />
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .tools-page {
    max-width: min(1120px, calc(100% - 2 * var(--space-5)));
  }

  .tools-entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .tools-back {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .tools-back:hover {
    color: var(--accent);
  }

  .tools-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    overflow: hidden;
    min-width: 0;
    background:
      radial-gradient(620px 180px at top right, rgba(37, 99, 235, 0.08), transparent 70%),
      radial-gradient(520px 160px at top left, rgba(45, 255, 178, 0.08), transparent 72%),
      linear-gradient(180deg, rgba(15, 23, 42, 0.02), rgba(15, 23, 42, 0)),
      var(--surface-raised);
  }

  .tools-hero--plain {
    position: relative;
    padding: 0 0 var(--space-3);
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .tools-hero--plain::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--accent) 24%, transparent 76%),
      color-mix(in srgb, var(--border) 72%, transparent 28%)
    );
  }

  .tools-hero__eyebrow,
  .tools-tags,
  .tools-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .tools-title {
    margin: 0;
  }

  .tools-hero--plain .tools-title {
    font-size: clamp(2.25rem, 4vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .tools-description {
    margin: 0;
    max-width: 62ch;
    color: var(--text-2);
    font-size: 1.05rem;
  }

  .tools-meta__item {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .tools-body {
    padding-top: calc(var(--space-5) + 2px);
  }

  .prose--tools {
    color: var(--text-2);
  }

  .prose--tools :global(h2) {
    margin-top: 2rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--border);
  }

  .prose--tools :global(h2:first-of-type) {
    margin-top: 0;
  }

  .prose--tools :global(h3) {
    margin-top: 1.5rem;
  }

  .prose--tools :global(ul),
  .prose--tools :global(ol) {
    margin-bottom: 1.35rem;
  }

  .prose--tools :global(li + li) {
    margin-top: 0.35rem;
  }

  .prose--tools :global(table) {
    display: block;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }
</style>
