---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import CliShell from '../../components/CliShell.astro';
import { toTagSlug } from '../../utils/tags';

const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.pubDate && b.data.pubDate) {
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  }

  if (a.data.pubDate) return -1;
  if (b.data.pubDate) return 1;

  return a.data.title.localeCompare(b.data.title);
});

const toolTags = [...new Set(tools.flatMap((tool) => tool.data.tags ?? []))];
const leadTool = tools[0] ?? null;
const deckTools = leadTool ? tools.slice(1) : [];

function getToolIdentity(tool: (typeof tools)[number]) {
  const tags = tool.data.tags ?? [];

  if (tags.some((tag) => ['mapping', 'kml', 'leaflet'].includes(tag))) {
    return { symbol: '⌖', label: 'Mapping utility' };
  }

  if (tags.some((tag) => ['adif', 'logging', 'analysis'].includes(tag))) {
    return { symbol: '▤', label: 'Log utility' };
  }

  if (tags.some((tag) => ['colour', 'rgb565', 'tft'].includes(tag))) {
    return { symbol: '◈', label: 'Colour utility' };
  }

  if (tags.includes('reference')) {
    return { symbol: '≡', label: 'Reference utility' };
  }

  return { symbol: '◦', label: 'Utility' };
}

function toolDateValue(tool: (typeof tools)[number]) {
  const candidate = tool.data.updatedDate ?? tool.data.pubDate ?? null;
  return candidate instanceof Date ? candidate.valueOf() : 0;
}

function formatDateStamp(value: number) {
  if (!value) return 'n/a';
  return new Date(value).toISOString().slice(0, 10);
}

const cliEntries = tools.map((tool) => ({
  id: tool.id,
  title: tool.data.title,
  url: `/tools/${tool.id}`,
  section: getToolIdentity(tool).label,
  description: tool.data.description ?? '',
  tags: tool.data.tags ?? [],
  updated: toolDateValue(tool),
  featured: tool.id === leadTool?.id,
}));

const toolSections = [...new Set(cliEntries.map((entry) => entry.section))];
const latestToolUpdated = cliEntries.length ? Math.max(...cliEntries.map((entry) => entry.updated)) : 0;

const cliManual = {
  stat: { name: 'stat', synopsis: 'stat', description: 'Show top-level stats for Tools.', examples: ['stat'], seeAlso: ['help', 'ls', 'man'] },
  help: { name: 'help', synopsis: 'help [command]', description: 'List commands or command help.', examples: ['help', 'help ls'], seeAlso: ['man', 'ls', 'grep'] },
  ls: { name: 'ls', synopsis: 'ls [section]', description: 'List tool sections or entries in one section.', examples: ['ls', 'ls "Mapping utility"'], seeAlso: ['cd', 'pwd', 'grep'] },
  cd: { name: 'cd', synopsis: 'cd <section> | cd /', description: 'Change virtual section context.', examples: ['cd "Log utility"', 'cd /'], seeAlso: ['pwd', 'ls'] },
  pwd: { name: 'pwd', synopsis: 'pwd', description: 'Print current virtual path.', examples: ['pwd'], seeAlso: ['cd', 'ls'] },
  cat: { name: 'cat', synopsis: 'cat <tool-id|title>', description: 'Show summary for a tool entry.', examples: ['cat adif-log-analyser'], seeAlso: ['open', 'man', 'grep'] },
  open: { name: 'open', synopsis: 'open <tool-id|title>', description: 'Open a tool page.', examples: ['open rgb565-colour-reference'], seeAlso: ['cat', 'man'] },
  grep: { name: 'grep', synopsis: 'grep <query>', description: 'Search title, description, section, and tags.', examples: ['grep map', 'grep colour'], seeAlso: ['find', 'tag', 'ls'] },
  find: { name: 'find', synopsis: 'find <query>', description: 'Alias for grep.', examples: ['find adif'], seeAlso: ['grep', 'tag'] },
  tag: { name: 'tag', synopsis: 'tag <name>', description: 'List entries by tag match.', examples: ['tag mapping', 'tag reference'], seeAlso: ['grep', 'ls'] },
  man: { name: 'man', synopsis: 'man [command|topic]', description: 'Open manual pages for commands or tool entries.', examples: ['man', 'man ls', 'man adif'], seeAlso: ['help', 'cat', 'open'] },
  history: { name: 'history', synopsis: 'history', description: 'Show shell command history.', examples: ['history'], seeAlso: ['clear'] },
  clear: { name: 'clear', synopsis: 'clear', description: 'Clear shell output.', examples: ['clear'], seeAlso: ['history'] },
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Tools — Chips’nCode"
      description="Interactive utilities, calculators, experiments, and technical playground tools."
    />
  </head>
  <body>
    <Header />
    <main class="tools-index">
      <section class="tools-hero">
        <div>
          <IndexHeader
            eyebrow="Tools"
            title="Tools"
            lede="Utilities, references, quick-look calculators, and practical little pages that earn their keep by being faster than reopening the same forum thread."
          />
        </div>
      </section>

      {tools.length === 0 ? (
        <div class="panel panel--soft empty">
          <p class="empty-title">Tools coming soon.</p>
          <p class="empty-sub">
            Publish tools in the <code>tools</code> collection and they will appear here automatically.
          </p>
        </div>
      ) : (
        <>
          {leadTool ? (
            <section class="tool-featureBand" aria-labelledby="tools-featured-heading">
              <div class="section-head">
                <div>
                  <p class="eyebrow eyebrow--accent">Instrument Rack</p>
                  <h2 id="tools-featured-heading">Lead utility</h2>
                </div>
              </div>

              <div class="tool-featureBand__grid">
                <article class="tool-lead panel">
                  <div class="tool-identity" aria-hidden="true">
                    <span class="tool-identity__icon">{getToolIdentity(leadTool).symbol}</span>
                    <div class="tool-identity__copy">
                      <span class="tool-identity__label">{getToolIdentity(leadTool).label}</span>
                      {leadTool.data.tags?.[0] ? (
                        <a class="tool-identity__tag" href={`/tags/${toTagSlug(leadTool.data.tags[0])}`}>
                          #{leadTool.data.tags[0]}
                        </a>
                      ) : null}
                    </div>
                  </div>

                  <div class="tool-lead__copy">
                    <div class="tool-lead__meta">
                      {leadTool.data.pubDate ? (
                        <span class="tool-lead__date">
                          <FormattedDate date={leadTool.data.pubDate} />
                        </span>
                      ) : null}
                      <span class="pill pill--compact">Lead utility</span>
                    </div>

                    <h3 class="tool-lead__title">
                      <a href={`/tools/${leadTool.id}`}>{leadTool.data.title}</a>
                    </h3>

                    <p class="tool-lead__desc">{leadTool.data.description}</p>

                    {leadTool.data.tags?.length ? (
                      <div class="tool-tagRow">
                        {leadTool.data.tags.slice(0, 4).map((tag) => (
                          <a class="tagChip" href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>
                        ))}
                      </div>
                    ) : null}
                  </div>
                </article>

                {deckTools.length ? (
                  <div class="tool-deck">
                    {deckTools.map((tool) => (
                      <a href={`/tools/${tool.id}`} class="tool-card panel panel--soft" aria-label={`Open tool: ${tool.data.title}`}>
                        <div class="tool-card__body">
                          <div class="tool-card__identity" aria-hidden="true">
                            <span class="tool-identity__icon tool-identity__icon--small">{getToolIdentity(tool).symbol}</span>
                            <span class="tool-card__label">{getToolIdentity(tool).label}</span>
                          </div>

                          <div class="tool-card__meta">
                            {tool.data.pubDate ? (
                              <span class="tool-card__date">
                                <FormattedDate date={tool.data.pubDate} />
                              </span>
                            ) : null}
                            <span class="pill pill--compact">Tool</span>
                          </div>

                          <h3 class="tool-card__title">{tool.data.title}</h3>
                          <p class="tool-card__desc">{tool.data.description}</p>
                        </div>
                      </a>
                    ))}
                  </div>
                ) : null}
              </div>
            </section>
          ) : null}
        </>
      )}
    </main>
    <Footer />

    <div class="edge-drawer-instance">
      <input id="tools-query-toggle" class="edge-drawer-toggle edge-drawer-toggle--query" type="checkbox" />
      <label
        for="tools-query-toggle"
        class="edge-drawer-tab"
        data-drawer-name="Tools Query"
        aria-label="Open tools query drawer"
      >
        Tools Query
      </label>

      <div class="edge-drawer-overlay edge-drawer-overlay--query" data-edge-drawer="tools-query-toggle">
        <label for="tools-query-toggle" class="edge-drawer-backdrop" aria-label="Close tools query drawer"></label>
        <aside class="edge-drawer-panel edge-drawer-panel--query" role="dialog" aria-modal="true" aria-label="Tools query drawer">
          <label for="tools-query-toggle" class="edge-drawer-close edge-drawer-close--query">Close</label>
          <CliShell
            shellId="tools-cli"
            shellTitle="tools.query"
            initialCommand="stat"
            entries={cliEntries}
            commandManual={cliManual}
            statsLines={[
              { label: 'published_tools', value: tools.length },
              { label: 'sections', value: toolSections.length },
              { label: 'tags_in_use', value: toolTags.length },
              { label: 'dated_entries', value: tools.filter((tool) => tool.data.pubDate).length },
              { label: 'last_updated', value: formatDateStamp(latestToolUpdated) },
            ]}
            presets={['ls', 'grep map', 'tag adif', 'man ls', 'open rgb565']}
          />
        </aside>
      </div>
    </div>
  </body>
</html>

<style>
  .tools-index {
    max-width: min(1320px, calc(100% - 2 * var(--space-5)));
  }

  .tools-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
  }

  .empty {
    padding: var(--space-6);
  }

  .empty-title {
    margin: 0 0 0.4rem;
    font-weight: 700;
    color: var(--text);
  }

  .empty-sub {
    margin: 0;
    color: var(--text-2);
    max-width: 80ch;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .section-head h2 {
    margin: 0;
  }

  .eyebrow--accent {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 52%, var(--text) 48%);
  }

  .tool-featureBand {
    display: grid;
    gap: var(--space-5);
  }

  .tool-featureBand__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: var(--space-5);
    align-items: start;
  }

  .tool-lead,
  .tool-card {
    text-decoration: none;
    color: inherit;
  }

  .tool-lead {
    display: grid;
    gap: var(--space-4);
    background:
      radial-gradient(540px 220px at top left, rgba(45, 255, 178, 0.1), transparent 70%),
      radial-gradient(520px 220px at top right, rgba(37, 99, 235, 0.08), transparent 68%),
      var(--surface-raised);
  }

  .tool-identity {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 96%, transparent 4%), color-mix(in srgb, var(--surface-raised) 92%, var(--surface) 8%));
    box-shadow: var(--shadow-sm);
  }

  .tool-identity__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 14px;
    border: 1px solid var(--surface-glass-border);
    background:
      radial-gradient(120% 120% at top left, color-mix(in srgb, var(--accent) 18%, transparent 82%), transparent 55%),
      var(--surface-glass);
    color: var(--text);
    font-size: 1.15rem;
    font-weight: 700;
    flex: 0 0 auto;
  }

  .tool-identity__icon--small {
    width: 2rem;
    height: 2rem;
    border-radius: 12px;
    font-size: 1rem;
  }

  .tool-identity__copy {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .tool-identity__label,
  .tool-identity__tag,
  .tool-card__label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .tool-identity__label,
  .tool-card__label {
    color: var(--muted);
    text-transform: lowercase;
  }

  .tool-identity__tag {
    color: var(--text-2);
    text-decoration: none;
  }

  .tool-identity__tag:hover {
    color: var(--text);
  }

  .tool-lead__copy,
  .tool-card__body {
    min-width: 0;
  }

  .tool-lead__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tool-lead__meta,
  .tool-card__meta,
  .tool-tagRow {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .tool-lead__meta,
  .tool-card__meta {
    justify-content: flex-end;
  }

  .tool-lead__date,
  .tool-card__date {
    color: var(--muted);
    font-size: 0.86rem;
  }

  .pill--compact {
    padding: 0.24rem 0.56rem;
    font-size: 0.74rem;
    line-height: 1;
  }

  .tool-lead__title,
  .tool-lead__desc,
  .tool-card__title,
  .tool-card__desc {
    margin: 0;
  }

  .tool-lead__title {
    font-size: clamp(2rem, 2.8vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .tool-lead__title a,
  .tool-card__title {
    color: inherit;
    text-decoration: none;
  }

  .tool-lead__title a:hover,
  .tool-card:hover .tool-card__title {
    color: var(--accent);
  }

  .tool-lead__desc {
    max-width: 42ch;
    color: var(--text-2);
    font-size: clamp(1rem, 1.1vw, 1.15rem);
  }

  .tagChip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.34rem 0.62rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-glass);
    color: var(--text-2);
    font-size: 0.82rem;
    line-height: 1;
    text-decoration: none;
    transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
  }

  .tagChip:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border) 58%);
    background: color-mix(in srgb, var(--surface-raised) 66%, var(--accent) 34%);
    color: var(--text);
  }

  .tool-deck {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .tool-card {
    display: grid;
    gap: var(--space-3);
    align-self: start;
  }

  .tool-card__body {
    display: grid;
    gap: var(--space-3);
  }

  .tool-card__identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tool-card__title {
    font-size: clamp(1.18rem, 1.35vw, 1.45rem);
    line-height: 1.14;
    text-wrap: balance;
  }

  .tool-card__desc {
    color: var(--text-2);
  }

  @media (max-width: 980px) {
    .tools-hero {
      grid-template-columns: 1fr;
    }

    .tool-featureBand__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 780px) {
    .tools-index {
      max-width: calc(100% - 2 * var(--space-4));
    }

    .tool-lead__meta,
    .tool-card__meta {
      justify-content: flex-start;
    }
  }
</style>
