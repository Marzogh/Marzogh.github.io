---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort((a, b) => {
  const aTime = (a.data.updatedDate ?? a.data.pubDate)?.getTime() ?? 0;
  const bTime = (b.data.updatedDate ?? b.data.pubDate)?.getTime() ?? 0;
  return bTime - aTime || a.data.title.localeCompare(b.data.title);
});

const isInstrument = (tool: (typeof tools)[number]) => {
  const tags = new Set((tool.data.tags ?? []).map((tag) => tag.toLowerCase()));
  return tags.has('analysis') || tags.has('mapping') || tags.has('leaflet') || tags.has('interactive');
};

const toolIdentity = (tool: (typeof tools)[number]) => {
  const tags = new Set((tool.data.tags ?? []).map((tag) => tag.toLowerCase()));
  if (tags.has('mapping') && tags.has('analysis')) return { mark: '⌖', label: 'Analysis and mapping instrument' };
  if (tags.has('mapping')) return { mark: '⌖', label: 'Mapping instrument' };
  if (tags.has('analysis')) return { mark: '≋', label: 'Analysis instrument' };
  if (tags.has('rgb565') && tags.has('interactive')) return { mark: '◫', label: 'Colour instrument' };
  if (tags.has('rgb565')) return { mark: '◫', label: 'Colour reference' };
  if (tags.has('downloader')) return { mark: '↓', label: 'Download utility' };
  return { mark: '·', label: 'Utility' };
};

const formatDate = (tool: (typeof tools)[number]) => {
  const date = tool.data.updatedDate ?? tool.data.pubDate;
  return date
    ? new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }).format(date)
    : 'Undated';
};

const instruments = tools.filter(isInstrument);
const references = tools.filter((tool) => !isInstrument(tool));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Tools — Chips’nCode" description="Small, practical utilities for radio logs, maps, colour values, files, and recurring technical jobs." />
  </head>
  <body>
    <Header />
    <main class="tools-library">
      <header class="tools-library__header">
        <div>
          <p class="editorial-kicker">Working shelf</p>
          <h1>Tools</h1>
          <p>Small, practical utilities for radio logs, maps, colour values, files, and the jobs that are too tedious to keep doing by hand.</p>
        </div>
        <dl aria-label="Tools summary">
          <div><dt>Tools</dt><dd>{tools.length}</dd></div>
          <div><dt>Interactive</dt><dd>{instruments.length}</dd></div>
          <div><dt>References</dt><dd>{references.length}</dd></div>
        </dl>
      </header>

      {tools.length === 0 ? (
        <p class="tools-empty">Nothing is on the bench yet.</p>
      ) : (
        <div class="tools-directory">
          {instruments.length ? (
            <section class="tools-group" aria-labelledby="interactive-tools">
              <header>
                <div>
                  <p class="editorial-kicker">Use in the browser</p>
                  <h2 id="interactive-tools">Interactive instruments</h2>
                </div>
                <p>Bring your own data. Processing stays in the browser.</p>
              </header>
              <div class="tools-grid">
                {instruments.map((tool) => {
                  const identity = toolIdentity(tool);
                  return (
                    <a class="tool-card" href={`/tools/${tool.id}`}>
                      <span class="tool-card__mark" aria-hidden="true">{identity.mark}</span>
                      <span class="tool-card__copy">
                        <small>{identity.label}</small>
                        <strong>{tool.data.title}</strong>
                        <span>{tool.data.description}</span>
                      </span>
                      <span class="tool-card__foot"><time>{formatDate(tool)}</time><i aria-hidden="true">→</i></span>
                    </a>
                  );
                })}
              </div>
            </section>
          ) : null}

          {references.length ? (
            <section class="tools-group" aria-labelledby="reference-tools">
              <header>
                <div>
                  <p class="editorial-kicker">Keep nearby</p>
                  <h2 id="reference-tools">References and downloads</h2>
                </div>
                <p>Compact answers and reusable helpers without the dashboard treatment.</p>
              </header>
              <div class="tools-grid">
                {references.map((tool) => {
                  const identity = toolIdentity(tool);
                  return (
                    <a class="tool-card" href={`/tools/${tool.id}`}>
                      <span class="tool-card__mark" aria-hidden="true">{identity.mark}</span>
                      <span class="tool-card__copy">
                        <small>{identity.label}</small>
                        <strong>{tool.data.title}</strong>
                        <span>{tool.data.description}</span>
                      </span>
                      <span class="tool-card__foot"><time>{formatDate(tool)}</time><i aria-hidden="true">→</i></span>
                    </a>
                  );
                })}
              </div>
            </section>
          ) : null}
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>
  .tools-library { width: min(1180px, calc(100% - 4rem)); max-width: 1180px; padding: clamp(2rem, 5vw, 4.5rem) 0 clamp(5rem, 9vw, 8rem); }
  .tools-library__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; padding-bottom: clamp(1.5rem, 3vw, 2.4rem); border-bottom: 1px solid var(--text); }
  .tools-library__header h1 { margin: 0.35rem 0 0; font-size: clamp(3.2rem, 8vw, 7rem); line-height: 0.86; letter-spacing: -0.06em; }
  .tools-library__header > div > p:last-child { max-width: 64ch; margin: 1.2rem 0 0; color: var(--text-2); font-size: clamp(1rem, 1.3vw, 1.16rem); }
  .tools-library__header dl { display: grid; grid-template-columns: repeat(3, auto); margin: 0; border-block: 1px solid var(--border); }
  .tools-library__header dl div { display: grid; gap: 0.2rem; min-width: 5.5rem; padding: 0.65rem 0.85rem; border-left: 1px solid var(--border); }
  .tools-library__header dt, .tools-library__header dd, .tool-card small, .tool-card__foot { font-family: var(--font-mono); }
  .tools-library__header dt { color: var(--muted); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .tools-library__header dd { margin: 0; color: var(--text); font-size: 0.86rem; font-weight: 650; }
  .tools-directory { display: grid; gap: clamp(3.5rem, 7vw, 6rem); margin-top: clamp(3rem, 6vw, 5rem); }
  .tools-group > header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 0.48fr); gap: 2rem; align-items: end; padding-bottom: 0.9rem; border-bottom: 1px solid var(--text); }
  .tools-group h2 { margin: 0.25rem 0 0; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1; letter-spacing: -0.04em; }
  .tools-group > header > p { margin: 0; color: var(--muted); font-size: 0.82rem; line-height: 1.5; }
  .tools-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .tool-card { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: 1fr auto; column-gap: 1rem; min-height: 235px; padding: clamp(1.15rem, 2vw, 1.6rem); border-bottom: 1px solid var(--border); color: inherit; text-decoration: none; }
  .tool-card:nth-child(even) { border-left: 1px solid var(--border); }
  .tool-card:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .tool-card__mark { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--border)); color: var(--accent); font-size: 1.45rem; line-height: 1; }
  .tool-card__copy { display: flex; flex-direction: column; min-width: 0; }
  .tool-card small { color: var(--accent); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .tool-card strong { margin-top: 0.7rem; font-size: clamp(1.35rem, 2.5vw, 2rem); line-height: 1.05; letter-spacing: -0.035em; }
  .tool-card__copy > span:last-child { max-width: 46ch; margin-top: 0.75rem; color: var(--text-2); font-size: 0.9rem; line-height: 1.55; }
  .tool-card__foot { grid-column: 2; display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-top: 1.5rem; color: var(--muted); font-size: 0.64rem; text-transform: uppercase; }
  .tool-card__foot i { color: var(--text); font: normal 1.05rem/1 sans-serif; }
  .tools-empty { padding: 3rem 0; border-bottom: 1px solid var(--border); color: var(--muted); }
  @media (max-width: 800px) {
    .tools-library { width: min(100% - 2rem, 1180px); }
    .tools-library__header { grid-template-columns: 1fr; }
    .tools-library__header dl { width: 100%; grid-template-columns: repeat(3, 1fr); }
    .tools-library__header dl div:first-child { border-left: 0; }
  }
  @media (max-width: 620px) {
    .tools-library { padding-top: 1.5rem; }
    .tools-library__header h1 { font-size: clamp(3.5rem, 22vw, 5.5rem); }
    .tools-library__header dl { display: none; }
    .tools-group > header { grid-template-columns: 1fr; gap: 0.7rem; }
    .tools-grid { grid-template-columns: 1fr; }
    .tool-card { min-height: 205px; padding-inline: 0.5rem; }
    .tool-card:nth-child(even) { border-left: 0; }
  }
</style>
