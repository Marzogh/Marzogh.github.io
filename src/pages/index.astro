---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ThemeIcon from '../components/ThemeIcon.astro';
import heroImage from '../assets/home-hero-2026.png';
import { isPublishedEntryData } from '../utils/publishing';

const blog = await getCollection('blog', ({ data }) => isPublishedEntryData(data));
const projects = await getCollection('projects', ({ data }) => !data.draft);
const tools = await getCollection('tools', ({ data }) => !data.draft);
const docs = await getCollection('docs', ({ data }) => !data.draft);
const education = await getCollection('education', ({ data }) => !data.draft && data.showInLanding);
const astrophotography = await getCollection('astrophotography', ({ data }) => !data.draft);

const slugFor = (entry) => String(entry.slug ?? entry.id ?? '').replace(/\.(md|mdx)$/i, '');
const dated = (entry) => new Date(entry.data.updatedDate ?? entry.data.pubDate ?? entry.data.sessionDate ?? 0);
const formatDate = (date) => Number.isFinite(date.valueOf())
  ? new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }).format(date)
  : 'Undated';
const imageFor = (entry) => {
  const image = entry?.data?.image;
  return typeof image === 'string' ? image : image?.src;
};
const kindClass = (type) => type.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const kindSymbol = (type) => ({
  Notebook: '¶',
  Project: '▦',
  Tool: '⌁',
  Reference: '§',
  Astrophotography: '✦',
}[type] ?? '•');

const allEntries = [
  ...blog.map((entry) => ({ entry, type: 'Notebook', href: `/notebook/${slugFor(entry)}` })),
  ...projects.map((entry) => ({ entry, type: 'Project', href: `/projects/${slugFor(entry)}` })),
  ...tools.map((entry) => ({ entry, type: 'Tool', href: `/tools/${slugFor(entry)}` })),
  ...docs.map((entry) => ({ entry, type: 'Reference', href: `/docs/${slugFor(entry)}` })),
  ...astrophotography.map((entry) => ({ entry, type: 'Astrophotography', href: `/astrophotography/${slugFor(entry)}` })),
].sort((a, b) => dated(b.entry).valueOf() - dated(a.entry).valueOf());

const seen = new Set();
const entries = allEntries.filter(({ entry, type }) => {
  const key = `${type}:${entry.data.title}`;
  if (seen.has(key)) return false;
  seen.add(key);
  return true;
});

const latest = entries.slice(0, 6);
const latestHref = latest[0]?.href ?? '/notebook';

const featuredProject = projects
  .filter(({ data }) => data.featured && data.image)
  .sort((a, b) => dated(b).valueOf() - dated(a).valueOf())[0];
const featuredAstro = [...astrophotography]
  .sort((a, b) => dated(b).valueOf() - dated(a).valueOf())[0];

const sections = [
  { code: 'P', title: 'Projects', href: '/projects', detail: 'Things I have built, am building or am planning to build.', tone: 'builds' },
  { code: 'N', title: 'Notebook', href: '/notebook', detail: 'Notes, investigations and occasional rabbit holes.', tone: 'mind' },
  { code: 'D', title: 'Documentation', href: '/docs', detail: 'References, manuals and things written down properly.', tone: 'code' },
  { code: 'T', title: 'Tools', href: '/tools', detail: 'Small utilities and instruments I needed.', tone: 'life' },
  { code: 'A', title: 'Astrophotography', href: '/astrophotography', detail: 'Sessions, images and processing notes.', tone: 'light' },
  { code: 'E', title: 'Education', href: '/education', detail: 'Teaching material I actually use.', tone: 'builds' },
  { code: 'P', title: 'Poetry', href: '/poetry', detail: 'The much older and rather different bit of the site.', tone: 'mind' },
];

const themes = [
  { title: 'Builds', href: '/projects', tone: 'builds' },
  { title: 'Code', href: '/docs', tone: 'code' },
  { title: 'Life', href: '/notebook', tone: 'life' },
  { title: 'Mind', href: '/poetry', tone: 'mind' },
  { title: 'Light', href: '/astrophotography', tone: 'light' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Chips’nCode"
      description="Things built, investigated, photographed, taught and occasionally overcomplicated."
    />
  </head>
  <body class="home-page">
    <Header />

    <main class="home-main">
      <section class="home-hero" aria-labelledby="home-hero-title">
        <Image
          class="home-hero__image"
          src={heroImage}
          alt="A radio, code-covered laptop, coffee, electronics and field notebook beneath the Milky Way"
          widths={[800, 1200, 1600, 2048]}
          sizes="(max-width: 1904px) calc(100vw - 64px), 1840px"
          loading="eager"
          fetchpriority="high"
        />
        <div class="home-hero__shade" aria-hidden="true"></div>
        <div class="home-hero__copy">
          <h1 id="home-hero-title">Chips’nCode</h1>
          <p>Chips’nCode is where I keep the things I build, investigate, photograph, teach and occasionally get distracted by.</p>
          <p>There is a lot of amateur radio and electronics here, alongside software, astronomy, teaching resources and whatever else I have wandered into lately.</p>
          <div class="home-hero__actions">
            <a class="home-action home-action--primary" href={latestHref}>Latest <span aria-hidden="true">→</span></a>
            <a class="home-action" href="/projects">Projects <span aria-hidden="true">→</span></a>
          </div>
          <nav class="theme-strip theme-strip--hero" aria-label="Browse by theme">
            {themes.map((theme) => (
              <a class={`theme-chip theme-chip--${theme.tone}`} href={theme.href}>
                <ThemeIcon name={theme.tone} />{theme.title}
              </a>
            ))}
          </nav>
        </div>
      </section>

      <section class="home-section" aria-labelledby="latest-title">
        <header class="home-section__heading">
          <h2 id="latest-title">Latest</h2>
          <a href="/notebook">View everything <span aria-hidden="true">→</span></a>
        </header>

        <div class="latest-grid">
          {latest.map(({ entry, type, href }) => {
            const image = imageFor(entry);
            return (
              <a class={`latest-card latest-card--${kindClass(type)}`} href={href}>
                <div class="latest-card__copy">
                  <span class="content-label">{type}</span>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                  <span class="latest-card__date">{formatDate(dated(entry))}</span>
                </div>
                {image ? (
                  <img class="latest-card__image" src={image} alt="" loading="lazy" decoding="async" />
                ) : (
                  <div class="latest-card__visual" aria-hidden="true">
                    <span class="filigree-letter">{kindSymbol(type)}</span>
                    <small>{type}</small>
                  </div>
                )}
                <span class="latest-card__arrow" aria-hidden="true">↗</span>
              </a>
            );
          })}
        </div>
      </section>

      <section class="home-section" aria-labelledby="explore-title">
        <header class="home-section__heading">
          <h2 id="explore-title">Explore</h2>
        </header>
        <nav class="explore-grid" aria-label="Site sections">
          {sections.map((section) => (
            <a class={`explore-card explore-card--${section.tone}`} href={section.href}>
              <span class="explore-card__code" aria-hidden="true">
                <span class="filigree-letter">{section.code}</span>
              </span>
              <span class="explore-card__copy">
                <strong>{section.title}</strong>
                <small>{section.detail}</small>
              </span>
              <span class="explore-card__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </section>

      <section class="home-section" aria-labelledby="featured-title">
        <header class="home-section__heading">
          <h2 id="featured-title">Featured</h2>
          <a href="/projects">More featured <span aria-hidden="true">→</span></a>
        </header>
        <div class="featured-grid">
          {featuredProject ? (
            <a class="featured-card" href={`/projects/${slugFor(featuredProject)}`}>
              <img src={imageFor(featuredProject)} alt="" loading="lazy" decoding="async" />
              <div>
                <span class="content-label">Featured project</span>
                <h3>{featuredProject.data.title}</h3>
                <p>{featuredProject.data.description}</p>
                <span class="featured-card__action">View project →</span>
              </div>
            </a>
          ) : null}

          {featuredAstro ? (
            <a class="featured-card" href={`/astrophotography/${slugFor(featuredAstro)}`}>
              <img src={imageFor(featuredAstro)} alt="" loading="lazy" decoding="async" />
              <div>
                <span class="content-label">Featured image</span>
                <h3>{featuredAstro.data.title}</h3>
                <p>{featuredAstro.data.description}</p>
                <span class="featured-card__action">View image →</span>
              </div>
            </a>
          ) : null}
        </div>
      </section>

      <section class="theme-browser" aria-labelledby="themes-title">
        <div>
          <h2 id="themes-title">Browse by theme</h2>
          <p>Follow an idea across projects, writing, tools, documentation and photographs.</p>
        </div>
        <nav class="theme-strip" aria-label="Browse site themes">
          {themes.map((theme) => (
            <a class={`theme-chip theme-chip--${theme.tone}`} href={theme.href}>
              <ThemeIcon name={theme.tone} />{theme.title}
            </a>
          ))}
        </nav>
        <a class="theme-browser__about" href="/about">About the site →</a>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body.home-page) {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--paper) 96%, var(--accent) 4%), var(--paper));
  }

  .home-main {
    width: min(100% - 64px, 1840px);
    max-width: none;
    margin-inline: auto;
    padding: 0 0 clamp(3rem, 7vw, 6rem);
  }

  .home-hero {
    position: relative;
    width: 100%;
    height: clamp(400px, 30vw, 460px);
    min-height: 0;
    margin-inline: auto;
    overflow: hidden;
    border-bottom: 1px solid rgba(246, 241, 231, 0.32);
    background: #07090c;
    color: #f6f1e7;
  }

  .home-hero__image,
  .home-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero__image {
    object-fit: cover;
    object-position: center 56%;
  }

  .home-hero__shade {
    background:
      linear-gradient(90deg, transparent 38%, rgba(4, 6, 9, 0.12) 52%, rgba(4, 6, 9, 0.82) 76%, rgba(4, 6, 9, 0.94) 100%),
      linear-gradient(0deg, rgba(4, 6, 9, 0.22), transparent 42%);
  }

  .home-hero__copy {
    position: relative;
    z-index: 1;
    width: min(47%, 590px);
    margin-left: auto;
    padding: clamp(2.2rem, 4vw, 4rem) clamp(2rem, 4vw, 4.5rem) 2rem;
  }

  .home-hero h1 {
    margin: 0 0 0.75rem;
    color: #f6f1e7;
    font-size: clamp(2.2rem, 3.5vw, 3.7rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .home-hero__copy > p {
    max-width: 50ch;
    margin: 0.55rem 0 0;
    color: rgba(246, 241, 231, 0.82);
    font-size: clamp(0.84rem, 1.1vw, 0.98rem);
    line-height: 1.55;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  .home-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-width: 112px;
    padding: 0.62rem 0.78rem;
    border: 1px solid rgba(246, 241, 231, 0.42);
    color: #f6f1e7;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .home-action--primary {
    border-color: #7065c7;
    background: #51479f;
  }

  .home-action:hover {
    border-color: #df916f;
    background: #df916f;
    color: #111318;
  }

  .theme-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .theme-strip--hero {
    margin-top: 1.15rem;
  }

  .theme-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    min-height: 2.35rem;
    padding: 0.42rem 0.68rem;
    border: 1px solid color-mix(in srgb, var(--theme-colour) 26%, transparent 74%);
    background: color-mix(in srgb, var(--theme-colour) 9%, transparent 91%);
    color: var(--theme-colour);
    font-size: 0.72rem;
    text-decoration: none;
  }

  .theme-strip--hero .theme-chip {
    border-color: color-mix(in srgb, var(--theme-colour) 42%, transparent 58%);
    background: color-mix(in srgb, #10151c 82%, var(--theme-colour) 18%);
  }

  .theme-chip:hover {
    background: color-mix(in srgb, var(--theme-colour) 18%, transparent 82%);
  }

  .theme-chip--builds,
  .explore-card--builds { --theme-colour: #61c989; }
  .theme-chip--code,
  .explore-card--code { --theme-colour: #6ca8ef; }
  .theme-chip--life,
  .explore-card--life { --theme-colour: #dfbd43; }
  .theme-chip--mind,
  .explore-card--mind { --theme-colour: #b788ed; }
  .theme-chip--light,
  .explore-card--light { --theme-colour: #60bdda; }

  .home-section {
    padding-top: clamp(1.35rem, 2.4vw, 2.25rem);
  }

  .home-section__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.65rem;
    padding: 0 0.5rem 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .home-section__heading h2,
  .theme-browser h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2.3vw, 1.9rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .home-section__heading a,
  .theme-browser__about {
    color: var(--link);
    font-size: 0.72rem;
    text-decoration: none;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .latest-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 124px;
    min-height: 176px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 72%, transparent 28%);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
  }

  .latest-card__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.85rem;
  }

  .content-label {
    align-self: flex-start;
    padding: 0.18rem 0.32rem;
    background: color-mix(in srgb, var(--card-tone, var(--tag-ink)) 14%, transparent 86%);
    color: var(--card-tone, var(--tag-ink));
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .latest-card h3,
  .featured-card h3 {
    margin: 0.65rem 0 0.45rem;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.22;
    letter-spacing: -0.025em;
  }

  .latest-card p,
  .featured-card p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-2);
    font-size: 0.68rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .latest-card__date {
    margin-top: auto;
    padding-top: 0.7rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .latest-card__image,
  .latest-card__visual {
    position: relative;
    align-self: start;
    width: 112px;
    height: 112px;
    margin: 0.75rem 0.75rem 0.75rem 0;
    border: 1px solid var(--border);
    aspect-ratio: 1;
  }

  .latest-card__image {
    object-fit: cover;
  }

  .latest-card__visual {
    --filigree-ink: var(--card-tone);
    --filigree-paper: var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    background:
      linear-gradient(135deg, transparent 49.5%, color-mix(in srgb, var(--card-tone) 28%, transparent) 50%, transparent 50.5%),
      repeating-linear-gradient(0deg, transparent 0 17px, color-mix(in srgb, var(--card-tone) 16%, transparent) 18px),
      color-mix(in srgb, var(--card-tone) 8%, var(--surface) 92%);
    color: var(--card-tone);
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--surface) 72%, transparent 28%),
      inset 0 0 0 4px color-mix(in srgb, var(--card-tone) 24%, transparent 76%);
  }

  .latest-card__visual span {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2.65rem;
    font-weight: 800;
    line-height: 1;
    transform: rotate(-1.5deg);
  }

  .latest-card__visual .filigree-letter {
    display: inline-block;
    background:
      repeating-radial-gradient(
        ellipse at 18% 52%,
        transparent 0 3px,
        color-mix(in srgb, var(--filigree-paper) 92%, transparent 8%) 3.5px 4.5px,
        transparent 5px 8px
      ),
      repeating-radial-gradient(
        ellipse at 82% 48%,
        transparent 0 4px,
        color-mix(in srgb, var(--filigree-paper) 82%, transparent 18%) 4.5px 5.5px,
        transparent 6px 10px
      ),
      repeating-linear-gradient(
        42deg,
        var(--filigree-ink) 0 2px,
        color-mix(in srgb, var(--filigree-paper) 76%, var(--filigree-ink) 24%) 2px 3px,
        var(--filigree-ink) 3px 6px
      );
    color: transparent;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 0.55px color-mix(in srgb, var(--filigree-ink) 78%, var(--text) 22%);
    filter: drop-shadow(0.8px 0.8px 0 color-mix(in srgb, var(--text) 38%, transparent 62%));
  }

  .latest-card__visual small {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .latest-card--notebook { --card-tone: #a47adc; }
  .latest-card--project { --card-tone: #51aa74; }
  .latest-card--tool { --card-tone: #c9a52e; }
  .latest-card--reference { --card-tone: #5f8fc9; }
  .latest-card--astrophotography { --card-tone: #52a8c3; }

  .latest-card__arrow {
    position: absolute;
    right: 0.45rem;
    bottom: 0.35rem;
    color: var(--text);
    font-size: 0.85rem;
  }

  .latest-card:hover,
  .featured-card:hover,
  .explore-card:hover {
    background: color-mix(in srgb, var(--tag-ink) 7%, var(--surface) 93%);
  }

  .latest-card:hover h3,
  .latest-card:hover .latest-card__arrow,
  .featured-card:hover h3,
  .explore-card:hover strong,
  .explore-card:hover .explore-card__arrow {
    color: var(--accent);
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .explore-card {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    gap: 0.75rem;
    min-height: 92px;
    padding: 0.8rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 68%, transparent 32%);
    color: var(--text);
    text-decoration: none;
  }

  .explore-card__code {
    --filigree-ink: var(--theme-colour);
    --filigree-paper: var(--surface);
    position: relative;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--theme-colour) 58%, transparent 42%);
    background: color-mix(in srgb, var(--theme-colour) 12%, var(--surface) 88%);
    box-shadow:
      inset 0 0 0 2px color-mix(in srgb, var(--surface) 76%, transparent 24%),
      inset 0 0 0 3px color-mix(in srgb, var(--theme-colour) 24%, transparent 76%);
    color: var(--theme-colour);
    font-family: var(--font-filigree);
    font-size: 1.55rem;
    font-weight: 400;
    font-synthesis: none;
    line-height: 1;
    transform: rotate(-1.5deg);
  }

  .explore-card__code .filigree-letter {
    color: var(--theme-colour);
    font-family: var(--font-filigree);
    font-size: 1.7rem;
    font-weight: 400;
    font-synthesis: none;
    line-height: 1;
    filter: none;
    text-shadow: none;
    -webkit-text-stroke: 0;
  }

  .explore-card__copy {
    display: grid;
    align-content: start;
    gap: 0.2rem;
  }

  .explore-card strong {
    font-size: 0.88rem;
  }

  .explore-card small {
    max-width: 30ch;
    color: var(--text-2);
    font-size: 0.66rem;
    line-height: 1.4;
  }

  .explore-card__arrow {
    align-self: center;
  }

  .explore-card:last-child:nth-child(3n + 1) {
    grid-column: 2;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .featured-card {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    min-height: 204px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 72%, transparent 28%);
    color: var(--text);
    text-decoration: none;
  }

  .featured-card > img {
    align-self: start;
    width: 180px;
    height: 180px;
    margin: 0.75rem 0 0.75rem 0.75rem;
    object-fit: cover;
    border: 1px solid var(--border);
    aspect-ratio: 1;
  }

  .featured-card > div {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 1rem;
  }

  .featured-card__action {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 1rem;
    color: var(--text);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .theme-browser {
    display: grid;
    grid-template-columns: minmax(230px, 0.8fr) minmax(0, 1.4fr) auto;
    gap: 1.5rem;
    align-items: center;
    margin-top: clamp(1.35rem, 2.4vw, 2.25rem);
    padding: 0.75rem 0.5rem;
