      .quick__link {
        display: inline-flex;
        align-items: center;
        padding: 0.55rem 0.8rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--surface) 92%, transparent 8%);
        text-decoration: none;
        color: var(--text);
        box-shadow: var(--shadow-sm);
      }

      .quick__link:hover {
        border-color: color-mix(in srgb, var(--accent) 20%, var(--border) 80%);
