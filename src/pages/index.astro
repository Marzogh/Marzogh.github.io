---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';

const title = 'Chips’nCode';
const description = 'A living technical playground — projects, tools, documentation, and education.';

const entryDateValue = (entry) =>
  new Date(entry?.data?.pubDate ?? entry?.data?.updatedDate ?? 0).valueOf();

// Latest content (update collection names here if yours differ)
const allBlog = await getCollection('blog', ({ data }) => !data.draft);
const latestBlog = [...allBlog]
  .sort((a, b) => entryDateValue(b) - entryDateValue(a))
  .slice(0, 5);

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const latestProjects = [...allProjects]
  .sort((a, b) => entryDateValue(b) - entryDateValue(a))
  .slice(0, 5);

const allTools = await getCollection('tools', ({ data }) => !data.draft);
const latestTools = [...allTools]
  .sort((a, b) => entryDateValue(b) - entryDateValue(a))
  .slice(0, 5);

const toTagLine = (entry) => {
  const tags = entry?.data?.tags;
  if (Array.isArray(tags) && tags.length) return tags.slice(0, 4).join(' · ');
  const desc = entry?.data?.description;
  if (typeof desc === 'string' && desc.trim()) return desc;
  return '';
};

const safeSlug = (entry) => {
  if (typeof entry?.slug === 'string' && entry.slug.trim()) return entry.slug;
  if (typeof entry?.id === 'string' && entry.id.trim()) {
    // Fallback: derive a usable path segment from the content entry id
    return entry.id
      .replace(/^\/+/, '')
      .replace(/\.(md|mdx)$/i, '');
  }
  return '';
};

// Unified index across collections we currently have wired here
// (If you add more collections later, extend this list.)
const normalize = (entry, kind) => {
  const title = entry?.data?.title ?? safeSlug(entry);
  const date = new Date(entry?.data?.pubDate ?? entry?.data?.updatedDate ?? 0);
  const tags = Array.isArray(entry?.data?.tags) ? entry.data.tags : [];
  const featured = Boolean(entry?.data?.featured || entry?.data?.pinned || entry?.data?.pin);
  const slug = safeSlug(entry);
  const url = kind === 'blog' ? `/notebook/${slug}` : `/projects/${slug}`;
  return { kind, title, date, tags, featured, url, raw: entry };
};

const allEntries = [
  ...allBlog.map((e) => normalize(e, 'blog')),
  ...allProjects.map((e) => normalize(e, 'projects')),
];

const PILL_TAGS = ['Builds', 'Code', 'Life', 'Mind', 'Light'];

const byPill = Object.fromEntries(
  PILL_TAGS.map((pill) => {
    const items = allEntries
      .filter((e) => e.tags.includes(pill))
      .sort((a, b) => {
        // Featured first, then newest
        if (a.featured !== b.featured) return a.featured ? -1 : 1;
        return b.date.valueOf() - a.date.valueOf();
      });
    return [pill, items];
  })
);

const spotlight = (pill) => byPill[pill].slice(0, 3);
const rest = (pill) => byPill[pill].slice(3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />

    <main class="page" id="top">
      <!-- HERO (banner-driven) -->
      <section class="hero" aria-label="Site introduction">
        <div class="hero__bg" aria-hidden="true"></div>
        <div class="hero__inner">
          <div class="hero__content">
            <h1 class="hero__title">Chips’nCode</h1>
            <p class="hero__subtitle">
              Signals in silicon, code in carbon, light, life, and the planetary systems that tie these together — welcome to the ramblings of an easily distracted mind.
            </p>

            <div class="hero__actions">
              <a class="btn btn--primary" href="/projects">Browse projects</a>
              <a class="btn" href="/notebook">Read the latest</a>
            </div>

            <nav class="hero__meta" aria-label="Explore by theme">
              <a class="chip" href="#pill-builds">Builds</a>
              <a class="chip" href="#pill-code">Code</a>
              <a class="chip" href="#pill-life">Life</a>
              <a class="chip" href="#pill-mind">Mind</a>
              <a class="chip" href="#pill-light">Light</a>
            </nav>
          </div>
        </div>
      </section>

      <section class="home-masonry" aria-label="Homepage highlights" data-masonry data-randomize="true">
        <section class="home-card dash__col home-card--writing" aria-label="Latest writing">
          <div class="dash__head">
            <h2 class="dash__title">Latest writing</h2>
            <a class="dash__more" href="/notebook">All posts →</a>
          </div>

          <ul class="dash__list">
            {latestBlog.map((post) => (
              <li>
                <a href={`/notebook/${safeSlug(post)}`}>{post.data?.title ?? safeSlug(post)}</a>
                {toTagLine(post) ? <span class="dash__sub">{toTagLine(post)}</span> : null}
              </li>
            ))}
          </ul>
        </section>

        <section class="home-card dash__col home-card--projects" aria-label="Featured projects">
          <div class="dash__head">
            <h2 class="dash__title">Projects &amp; builds</h2>
            <a class="dash__more" href="/projects">All projects →</a>
          </div>

          <ul class="dash__list">
            {latestProjects.map((proj) => (
              <li>
                <a href={`/projects/${safeSlug(proj)}`}>{proj.data?.title ?? safeSlug(proj)}</a>
                {toTagLine(proj) ? <span class="dash__sub">{toTagLine(proj)}</span> : null}
              </li>
            ))}
          </ul>
        </section>

        <section class="home-card dash__col dash__col--edu home-card--education" aria-label="Education">
          <div class="dash__head">
            <h2 class="dash__title">Education</h2>
            <a class="dash__more" href="/education">Education hub →</a>
          </div>

          <div class="edu__stack">
            <div class="edu__block">
              <div class="edu__label">For students</div>
              <a class="edu__link" href="/tags/student-resources">Scaffolded lessons &amp; exemplars</a>
              <div class="edu__note">Clear steps, checkpoints, and clean UI.</div>
            </div>

            <div class="edu__block">
              <div class="edu__label">For teachers</div>
              <a class="edu__link" href="/tags/teaching-resources">Planning resources &amp; templates</a>
              <div class="edu__note">Reusable structures, rubrics, and workflows.</div>
            </div>

            <div class="edu__block">
              <div class="edu__label">Tools</div>
              <a class="edu__link" href="/tags/interactive-utilities">Interactive utilities</a>
              <div class="edu__note">Small helpers that save time and reduce friction.</div>
            </div>
          </div>
        </section>

        <section class="home-card dash__col home-card--tools" aria-label="Latest tools">
          <div class="dash__head">
            <h2 class="dash__title">Latest tools</h2>
            <a class="dash__more" href="/tools">All tools →</a>
          </div>

          <ul class="dash__list">
            {latestTools.map((tool) => (
              <li>
                <a href={`/tools/${safeSlug(tool)}`}>{tool.data?.title ?? safeSlug(tool)}</a>
                {toTagLine(tool) ? <span class="dash__sub">{toTagLine(tool)}</span> : null}
              </li>
            ))}
          </ul>
        </section>

        <a class="home-card feature__tile feature__tile--wide home-card--feature" href="/projects" aria-label="Featured build">
          <div class="feature__kicker">Featured</div>
          <div class="feature__title">Builds worth bookmarking</div>
          <div class="feature__text">Hardware experiments, antenna work, field kits, and practical write-ups.</div>
          <div class="feature__cta">Explore projects →</div>
        </a>

        <a class="home-card feature__tile feature__tile--astro home-card--astro" href="/astrophotography" aria-label="Featured astrophotography">
          <div class="feature__kicker">Featured</div>
          <div class="feature__title">Astrophotography logs</div>
          <div class="feature__text">Sessions, calibration, processing pipelines, and gear notes.</div>
          <div class="feature__cta">View astrophotography →</div>
        </a>
      </section>

      <!-- PILL VIEWS (all posts by elemental tags) -->
      <section class="pills" aria-label="Browse by elemental themes">
        <div class="pills__head">
          <h2 class="pills__title">Browse by theme</h2>
          <p class="pills__desc">Showing everything tagged with this theme. Spotlight items are newest (and any pinned/featured posts).</p>
        </div>

        <div class="pills__grid">
          {PILL_TAGS.map((pill) => (
            <section
              class="pill"
              id={`pill-${pill.toLowerCase()}`}
              aria-label={`${pill} posts`}
            >
              <div class="pill__top">
                <h3 class="pill__title">{pill}</h3>
                <div class="pill__right">
                  <span class="pill__count">{byPill[pill].length} item{byPill[pill].length === 1 ? '' : 's'}</span>
                  <a class="pill__close" href="#top" aria-label="Hide theme panel">Close</a>
                </div>
              </div>

              {byPill[pill].length === 0 ? (
                <div class="pill__empty">Nothing tagged <strong>{pill}</strong> yet — soon.</div>
              ) : (
                <>
                  <div class="pill__spotlight" aria-label={`${pill} spotlight`}>
                    {spotlight(pill).map((e) => (
                      <a class="spot" href={e.url}>
                        <div class="spot__row">
                          <span class="spot__title">{e.title}</span>
                          {e.featured ? <span class="spot__badge">Featured</span> : null}
                        </div>
                        <div class="spot__meta">
                          <span class="spot__kind">{e.kind === 'blog' ? 'Post' : 'Project'}</span>
                          <span class="spot__dot">•</span>
                          <span class="spot__date">{Number.isFinite(e.date.valueOf()) ? e.date.toLocaleDateString('en-AU', { year: 'numeric', month: 'short', day: 'numeric' }) : ''}</span>
                        </div>
                      </a>
                    ))}
                  </div>

                  {rest(pill).length ? (
                    <details class="pill__more">
                      <summary>Show all {pill.toLowerCase()} ({rest(pill).length} more)</summary>
                      <ul class="pill__list">
                        {rest(pill).map((e) => (
                          <li>
                            <a href={e.url}>{e.title}</a>
                            <span class="pill__sub">{e.kind === 'blog' ? 'Post' : 'Project'}</span>
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : null}
                </>
              )}
            </section>
          ))}
        </div>
      </section>
    </main>

    <Footer />

    <script src="/scripts/masonry-grid.js" defer></script>

    <style>
      /* PILL VIEWS */
      .pills {
        margin-top: 1.25rem;
        /* Hidden until a pill is targeted */
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-4px);
        transition: opacity 160ms ease, transform 160ms ease;
      }

      /* Reveal the entire section when any pill panel is targeted */
      .pills:has(.pill:target) {
        max-height: 10000px;
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
      }

      .pills__head {
        margin-bottom: 0.75rem;
      }

      .pills__title {
        margin: 0 0 0.25rem;
        font-size: 1.15rem;
        letter-spacing: -0.01em;
        color: var(--text);
      }

      .pills__desc {
        margin: 0;
        color: var(--muted);
        max-width: 80ch;
      }

      .pills__grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr;
      }

      @media (min-width: 900px) {
        .pills__grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (min-width: 1200px) {
        .pills__grid {
          grid-template-columns: repeat(5, minmax(0, 1fr));
        }
      }

      .pill {
        border: 1px solid var(--border);
        border-radius: 16px;
        background: color-mix(in srgb, var(--surface) 92%, transparent 8%);
        box-shadow: var(--shadow-sm);
        padding: 0.95rem;
        scroll-margin-top: 92px;
        display: none;
      }

      .pill:target {
        display: block;
      }

      /* If someone jumps to the section without a target, keep it tidy */
      .pills__grid {
        grid-template-columns: 1fr;
      }

      .pill__top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.6rem;
        margin-bottom: 0.65rem;
        flex-wrap: wrap;
      }

      .pill__right {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        flex: 0 0 auto;
      }

      .pill__close {
        display: inline-flex;
        align-items: center;
        padding: 0.22rem 0.55rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--surface) 78%, transparent 22%);
        color: var(--text);
        text-decoration: none;
        font-weight: 650;
        font-size: 0.88rem;
      }

      .pill__close:hover {
        border-color: color-mix(in srgb, var(--accent) 22%, var(--border) 78%);
        color: var(--link-hover);
      }

      .pill__title {
        margin: 0;
        font-size: 1.02rem;
        letter-spacing: -0.01em;
        color: var(--text);
        white-space: nowrap;
      }

      .pill__count {
        color: var(--muted);
        font-size: 0.9rem;
        white-space: nowrap;
        flex: 0 0 auto;
      }

      .pill__empty {
        color: var(--muted);
        font-size: 0.95rem;
        padding: 0.4rem 0;
      }

      .pill__spotlight {
        display: grid;
        gap: 0.6rem;
      }

      .spot {
        display: block;
        padding: 0.7rem 0.75rem;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--surface-2) 88%, transparent 12%);
        text-decoration: none;
        color: var(--text);
      }

      .spot:hover {
        border-color: color-mix(in srgb, var(--accent) 22%, var(--border) 78%);
      }

      .spot__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }

      .spot__title {
        font-weight: 800;
        letter-spacing: -0.01em;
      }

      .spot__badge {
        font-size: 0.75rem;
        padding: 0.18rem 0.45rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        color: var(--text-2);
        background: color-mix(in srgb, var(--surface) 80%, transparent 20%);
        white-space: nowrap;
      }

      .spot__meta {
        margin-top: 0.28rem;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .spot__dot {
        opacity: 0.75;
      }

      .pill__more {
        margin-top: 0.7rem;
        border-top: 1px dashed var(--border);
        padding-top: 0.65rem;
      }

      .pill__more summary {
        cursor: pointer;
        color: var(--link);
        font-weight: 700;
        list-style: none;
      }

      .pill__more summary::-webkit-details-marker {
        display: none;
      }

      .pill__more summary:hover {
        color: var(--link-hover);
        text-decoration: underline;
      }

      .pill__list {
        list-style: none;
        margin: 0.6rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.45rem;
      }

      .pill__list li {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.6rem;
      }

      .pill__list a {
        color: var(--text);
        text-decoration: none;
        font-weight: 650;
      }

      .pill__list a:hover {
        color: var(--link-hover);
      }

      .pill__sub {
        color: var(--muted);
        font-size: 0.88rem;
        white-space: nowrap;
      }

      @media (max-width: 900px) {
        .pill {
          scroll-margin-top: 120px;
        }
      }
      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1.25rem 1rem 3.5rem;
      }

      /* HERO */
      .hero {
        position: relative;
        width: min(100%, 1220px);
        margin-inline: auto;
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: var(--shadow-md);
      }

      .hero__bg {
        position: absolute;
        inset: 0;
        /* NOTE: place Banner.png in /public/Banner.png */
        background-image:
          linear-gradient(
            to left,
            rgba(0, 0, 0, 0.00) 0%,
            rgba(0, 0, 0, 0.10) 26%,
            rgba(0, 0, 0, 0.34) 52%,
            rgba(0, 0, 0, 0.62) 78%,
            rgba(0, 0, 0, 0.78) 100%
          ),
          url('/Banner.png');
        background-size: cover;
        background-position: center;
        filter: saturate(1.05);
      }

      :global(html[data-theme="light"]) .hero__bg {
        background-image:
          linear-gradient(
            to left,
            rgba(255, 255, 255, 0.82) 0%,
            rgba(255, 255, 255, 0.66) 28%,
            rgba(255, 255, 255, 0.34) 52%,
            rgba(255, 255, 255, 0.12) 70%,
            rgba(255, 255, 255, 0.00) 82%
          ),
          url('/Banner.png');
      }

      @media (prefers-color-scheme: light) {
        :global(html:not([data-theme="dark"])) .hero__bg {
          background-image:
            linear-gradient(
              to left,
              rgba(255, 255, 255, 0.82) 0%,
              rgba(255, 255, 255, 0.66) 28%,
              rgba(255, 255, 255, 0.34) 52%,
              rgba(255, 255, 255, 0.12) 70%,
              rgba(255, 255, 255, 0.00) 82%
            ),
            url('/Banner.png');
        }
      }

      .hero__inner {
        position: relative;
        padding: 2.5rem 2rem;
        min-height: 310px;
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
      }

      .hero__content {
        max-width: 640px;
        text-align: right;
        padding: 0.55rem 0.65rem;
        border-radius: 16px;
        backdrop-filter: blur(6px);
      }

      /* LIGHT MODE: add a gentle translucent panel so text stays readable over the banner */

      /* (Removed light-mode translucent panel for hero__content) */

      .hero__title {
        margin: 0 0 0.5rem;
        font-size: clamp(2rem, 3vw, 3rem);
        letter-spacing: -0.02em;
        color: var(--text);
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.18), 0 10px 22px rgba(0, 0, 0, 0.18);
      }

      .hero__subtitle {
        margin: 0 0 1.25rem;
        color: var(--text-2);
        max-width: 60ch;
        font-size: 1.05rem;
        line-height: 1.55;
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.14), 0 8px 18px rgba(0, 0, 0, 0.16);
      }

      /* LIGHT MODE: bump contrast a touch for the subtitle */
      :global(html[data-theme="light"]) .hero__subtitle {
        color: color-mix(in srgb, var(--text) 86%, black 14%);
      }

      @media (prefers-color-scheme: light) {
        :global(html:not([data-theme="dark"])) .hero__subtitle {
          color: color-mix(in srgb, var(--text) 86%, black 14%);
        }
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1rem;
        justify-content: flex-end;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.65rem 0.95rem;
        border-radius: 12px;
        border: 1px solid var(--border-2);
        background: color-mix(in srgb, var(--surface) 85%, transparent 15%);
        color: var(--text);
        text-decoration: none;
        box-shadow: var(--shadow-sm);
      }

      .btn:hover {
        border-color: color-mix(in srgb, var(--accent) 22%, var(--border-2) 78%);
      }

      .btn--primary {
        background: var(--accent);
        color: var(--accent-ink);
        border-color: color-mix(in srgb, var(--accent) 70%, black 30%);
      }

      .btn--primary:hover {
        filter: brightness(1.03);
      }

      .hero__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: flex-end;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        padding: 0.28rem 0.55rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--surface) 70%, transparent 30%);
        color: var(--text-2);
        font-size: 0.85rem;
        text-decoration: none;
        cursor: pointer;
      }

      .chip:hover {
        border-color: color-mix(in srgb, var(--accent) 22%, var(--border) 78%);
        color: var(--text);
      }

      .chip:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--accent) 50%, transparent 50%);
        outline-offset: 2px;
      }

      .home-masonry {
        width: min(100%, 1180px);
        margin: 1.25rem auto 0;
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr;
      }

      .home-card {
        min-width: 0;
      }

      @media (min-width: 720px) {
        .home-masonry {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .home-card--education,
        .home-card--feature {
          grid-column: span 2;
        }
      }

      @media (min-width: 980px) {
        .home-masonry[data-masonry-ready='true'] {
          grid-template-columns: repeat(6, minmax(0, 1fr));
          grid-auto-flow: dense;
          grid-auto-rows: 12px;
          align-items: start;
        }

        .home-card--writing,
        .home-card--projects,
        .home-card--education,
        .home-card--elsewhere,
        .home-card--astro {
          grid-column: span 2;
        }

        .home-card--feature {
          grid-column: span 3;
        }
      }

      .dash__col {
        border: 1px solid var(--border);
        border-radius: 16px;
        background: color-mix(in srgb, var(--surface) 92%, transparent 8%);
        box-shadow: var(--shadow-sm);
        padding: 1rem;
        position: relative;
        overflow: hidden;
      }

      .dash__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }

      .dash__title {
        margin: 0;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        color: var(--text);
      }

      .dash__more {
        color: var(--link);
        text-decoration: none;
        font-size: 0.95rem;
        white-space: nowrap;
      }

      .dash__more:hover {
        text-decoration: underline;
      }

      .dash__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.75rem;
      }

      .dash__list li {
        display: grid;
        gap: 0.2rem;
      }

      .dash__list a {
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .dash__list a:hover {
        color: var(--link-hover);
      }

      .dash__sub {
