      .feature__tile--astro {
        background:
          radial-gradient(700px 280px at 0% 0%, rgba(147, 197, 253, 0.16), transparent 55%),
          radial-gradient(700px 280px at 100% 10%, rgba(34, 197, 94, 0.10), transparent 55%),
          color-mix(in srgb, var(--surface) 92%, transparent 8%);
