        margin: 0 0 0.45rem;
      }

      .feature__text {
        margin: 0 0 0.85rem;
        color: var(--text-2);
        max-width: 62ch;
      }

      .feature__cta {
        font-weight: 700;
        color: var(--link);
      }

      .quick__grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        position: relative;
        z-index: 1;
      }

      .pills {
        width: min(100%, 980px);
        margin-inline: auto;
