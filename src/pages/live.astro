---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LiveSignals from '../components/LiveSignals';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Local Signals — Chips’nCode"
      description="Weather and bird activity from my local Raspberry Pi ecosystem."
    />
  </head>
  <body>
    <Header />

    <main class="live-page">
      <section class="live-hero">
        <p class="live-kicker">Field telemetry</p>
        <h1>Local Signals</h1>
        <p>A live-ish look at what the weather and birds are doing here today.</p>
      </section>

      <LiveSignals client:load />
    </main>

    <Footer />
  </body>
</html>

<style>
  .live-page {
    --live-ink: #0f1b3d;
    --live-slate: #44506c;
    --live-blue: #2553cc;
    --live-cyan: #0c7a86;
    --live-amber: #a76511;
    --live-rose: #b9234a;
    --live-shell: #f7f9ff;
    max-width: min(1180px, calc(100% - 2 * var(--space-5)));
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .live-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.6rem, 2.5vw, 2.4rem);
    background:
      radial-gradient(900px 280px at 5% -15%, rgba(37, 83, 204, 0.26), transparent 62%),
      radial-gradient(800px 300px at 105% 120%, rgba(12, 122, 134, 0.22), transparent 58%),
      linear-gradient(135deg, #ffffff, #f4f8ff 58%, #eef6ff);
    box-shadow: 0 18px 36px rgba(15, 23, 42, 0.08);
  }

  .live-kicker {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--live-ink) 62%, #fff 38%);
    font-weight: 700;
  }

  .live-hero h1 {
    margin: 0;
    max-width: 13ch;
    color: var(--live-ink);
    font-size: clamp(2.2rem, 6.4vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .live-hero p {
    margin: 0;
    color: var(--live-slate);
    max-width: 56ch;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }

  :global(.live-signals) {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  :global(.live-signals__section) {
    display: grid;
    gap: 12px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.5));
    border-top: 2px solid color-mix(in srgb, var(--live-blue) 30%, var(--border) 70%);
    padding: 0.9rem 0.2rem 0.2rem;
    grid-column: span 12;
  }

  :global(.live-signals__section--weather) {
    grid-column: span 6;
  }

  :global(.live-signals__section--birds) {
    grid-column: span 6;
    border-top-color: color-mix(in srgb, var(--live-cyan) 36%, var(--border) 64%);
  }

  :global(.live-signals__section--species),
  :global(.live-signals__section--detections) {
    grid-column: span 6;
  }

  :global(.live-signals__section--location) {
    grid-column: span 12;
  }

  :global(.live-signals__card-header) {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: 0 0.35rem;
  }

  :global(.live-signals__card-header h2) {
    margin: 0;
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--live-ink);
  }

  :global(.live-signals__status) {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 0.82rem;
    font-weight: 700;
    border: 1px solid;
  }
  :global(.live-signals__stamp) {
    margin: 0;
    font-size: 0.84rem;
    color: var(--muted);
  }

  :global(.live-signals__status--ok) {
    background: color-mix(in srgb, var(--live-cyan) 13%, #fff 87%);
    border-color: color-mix(in srgb, var(--live-cyan) 38%, var(--border) 62%);
  }

  :global(.live-signals__status--stale) {
    background: color-mix(in srgb, var(--live-amber) 16%, var(--surface) 84%);
    border-color: color-mix(in srgb, var(--live-amber) 40%, var(--border) 60%);
  }

  :global(.live-signals__status--bad) {
    background: color-mix(in srgb, var(--live-rose) 14%, var(--surface) 86%);
    border-color: color-mix(in srgb, var(--live-rose) 40%, var(--border) 60%);
  }

  :global(.live-signals__stats) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--live-blue) 20%, var(--border) 80%);
    border-radius: 10px;
    overflow: hidden;
  }

  :global(.live-signals__stats div) {
    border: 0;
    padding: 12px;
    background: rgba(255, 255, 255, 0.88);
  }

  :global(.live-signals__stats dt) {
    margin: 0;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  :global(.live-signals__stats dd) {
    margin: 6px 0 0;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--live-ink);
    font-weight: 700;
  }

  :global(.live-signals__updated) {
    margin: 0;
    padding: 0 0.35rem;
    color: var(--muted);
    font-size: 0.93rem;
  }

  :global(.live-signals__species-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--live-cyan) 26%, var(--border) 74%);
  }

  :global(.live-signals__species-item) {
    border-bottom: 1px solid color-mix(in srgb, var(--live-cyan) 20%, var(--border) 80%);
    padding: 12px;
    background: rgba(255, 255, 255, 0.7);
    display: grid;
    grid-template-columns: 80px 1fr;
    column-gap: 12px;
    row-gap: 6px;
    align-items: start;
  }

  :global(.live-signals__species-image) {
    width: 80px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--live-blue) 20%, var(--border) 80%);
    background: #eef3fb;
  }

  :global(.live-signals__species-head) {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  :global(.live-signals__species-head strong) {
    color: var(--text);
  }

  :global(.live-signals__species-head span),
  :global(.live-signals__meter-label),
  :global(.live-signals__species-item p) {
    margin: 0;
    color: var(--text-2);
    grid-column: 2;
  }

  :global(.live-signals__meter) {
    width: 100%;
    height: 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--live-blue) 9%, #fff 91%);
    margin-top: 8px;
    overflow: hidden;
  }

  :global(.live-signals__meter span) {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--live-blue), var(--live-teal));
    transition: width 400ms ease;
  }

  :global(.live-signals__meter-label) {
    margin-top: 8px;
    font-size: 0.9rem;
  }

  :global(.live-signals__detections) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--live-cyan) 22%, var(--border) 78%);
  }

  :global(.live-signals__detections li) {
    display: grid;
    gap: 4px;
    border-bottom: 1px solid color-mix(in srgb, var(--live-cyan) 18%, var(--border) 82%);
    border-left: 0;
    padding: 10px 6px;
    background: rgba(255, 255, 255, 0.7);
  }

  :global(.live-signals__source) {
    color: var(--muted);
    font-size: 0.9rem;
  }

  :global(.live-signals__privacy) {
    color: var(--muted);
    margin: 0;
  }

  :global(.live-signals__location a) {
    font-weight: 700;
  }

  :global(.live-signals__map) {
    width: 100%;
    min-height: 300px;
    border: 1px solid color-mix(in srgb, var(--live-blue) 18%, var(--border) 82%);
    border-radius: 8px;
  }

  :global(:root[data-theme="dark"] .live-hero) {
    background:
      radial-gradient(900px 280px at 5% -15%, rgba(56, 189, 248, 0.22), transparent 62%),
      radial-gradient(800px 300px at 105% 120%, rgba(45, 212, 191, 0.18), transparent 58%),
      linear-gradient(135deg, #091327, #0b1a35 58%, #102345);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.35);
  }

  :global(:root[data-theme="dark"] .live-kicker) {
    color: #9db3d9;
  }

  :global(:root[data-theme="dark"] .live-hero h1) {
    color: #e7efff;
  }

  :global(:root[data-theme="dark"] .live-hero p) {
    color: #bdd0ee;
  }

  :global(:root[data-theme="dark"] .live-signals__section) {
    background: linear-gradient(180deg, rgba(10, 19, 38, 0.8), rgba(11, 24, 45, 0.75));
    border-top-color: rgba(118, 156, 221, 0.55);
  }

  :global(:root[data-theme="dark"] .live-signals__section--birds) {
    border-top-color: rgba(94, 197, 188, 0.55);
  }

  :global(:root[data-theme="dark"] .live-signals__card-header h2) {
    color: #e5eeff;
  }

  :global(:root[data-theme="dark"] .live-signals__stamp),
  :global(:root[data-theme="dark"] .live-signals__updated),
  :global(:root[data-theme="dark"] .live-signals__source) {
    color: #9fb4d8;
  }

  :global(:root[data-theme="dark"] .live-signals__stats) {
    border-color: rgba(93, 126, 180, 0.55);
  }

  :global(:root[data-theme="dark"] .live-signals__stats div) {
    background: rgba(11, 24, 46, 0.88);
  }

  :global(:root[data-theme="dark"] .live-signals__stats dt) {
    color: #8ea3c8;
  }

  :global(:root[data-theme="dark"] .live-signals__stats dd) {
    color: #edf3ff;
  }

  :global(:root[data-theme="dark"] .live-signals__species-list) {
    border-top-color: rgba(93, 177, 172, 0.5);
  }

  :global(:root[data-theme="dark"] .live-signals__species-item) {
    border-bottom-color: rgba(86, 145, 171, 0.5);
    background: rgba(9, 22, 43, 0.7);
  }

  :global(:root[data-theme="dark"] .live-signals__species-image) {
    border-color: rgba(90, 123, 178, 0.55);
    background: #10243f;
  }

  :global(:root[data-theme="dark"] .live-signals__species-head strong),
  :global(:root[data-theme="dark"] .live-signals__detections li strong),
  :global(:root[data-theme="dark"] .live-signals__location h2) {
    color: #e7efff;
  }

  :global(:root[data-theme="dark"] .live-signals__species-head span),
  :global(:root[data-theme="dark"] .live-signals__meter-label),
  :global(:root[data-theme="dark"] .live-signals__species-item p),
  :global(:root[data-theme="dark"] .live-signals__detections li span),
  :global(:root[data-theme="dark"] .live-signals__location p) {
    color: #bfd0ea;
  }

  :global(:root[data-theme="dark"] .live-signals__meter) {
    background: rgba(68, 96, 143, 0.4);
  }

  :global(:root[data-theme="dark"] .live-signals__detections) {
    border-top-color: rgba(93, 177, 172, 0.5);
  }

  :global(:root[data-theme="dark"] .live-signals__detections li) {
    border-bottom-color: rgba(90, 123, 178, 0.4);
    background: rgba(9, 22, 43, 0.72);
  }

  :global(:root[data-theme="dark"] .live-signals__map) {
    border-color: rgba(90, 123, 178, 0.6);
  }

  @media (max-width: 980px) {
    :global(.live-signals__section--weather),
    :global(.live-signals__section--birds),
    :global(.live-signals__section--species),
    :global(.live-signals__section--detections) {
      grid-column: span 12;
    }
  }

  @media (max-width: 760px) {
    .live-page {
      max-width: min(1100px, calc(100% - 1.4rem));
      gap: var(--space-5);
    }

    :global(.live-signals__stats) {
      grid-template-columns: 1fr;
    }

    :global(.live-signals__card-header h2) {
      font-size: clamp(1.4rem, 7vw, 2rem);
    }

    :global(.live-signals__species-item) {
      grid-template-columns: 1fr;
    }

    :global(.live-signals__species-image),
    :global(.live-signals__species-head),
    :global(.live-signals__species-head span),
    :global(.live-signals__meter-label),
    :global(.live-signals__species-item p) {
      grid-column: 1;
    }

    :global(.live-signals__map) {
      min-height: 220px;
    }
  }
</style>
