---
import { getCollection, getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { isPublishedEntryData } from '../../utils/publishing';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => isPublishedEntryData(data));
	return posts.map((post) => ({
		// For a `[...slug]` route, `params.slug` should be a single string (may contain `/`).
		params: { slug: post.id },
	}));
}

const { slug } = Astro.params;
if (!slug) {
	throw new Error('Missing route parameter: slug');
}

const post = await getEntry('blog', slug);
if (!post) {
	throw new Error(`Notebook entry not found: ${slug}`);
}

if (!isPublishedEntryData(post.data)) {
	throw new Error(`Notebook entry is not published yet: ${slug}`);
}

const { Content, headings } = await render(post);
---

<BlogPost {...post.data} pullQuotes={post.data.pullQuotes} headings={headings}>
	<Content />
</BlogPost>
