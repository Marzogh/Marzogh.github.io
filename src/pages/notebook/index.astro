---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import EditorialEntryRow from '../../components/EditorialEntryRow.astro';
import EditorialHeading from '../../components/EditorialHeading.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import CliShell from '../../components/CliShell.astro';
import { toTagSlug } from '../../utils/tags';
import { isPublishedEntryData } from '../../utils/publishing';

const posts = (await getCollection('blog', ({ data }) => isPublishedEntryData(data))).sort((a, b) => {
  const aTime = a.data.pubDate ? a.data.pubDate.getTime() : 0;
  const bTime = b.data.pubDate ? b.data.pubDate.getTime() : 0;
  if (bTime !== aTime) return bTime - aTime;
  return a.data.title.localeCompare(b.data.title);
});

const featuredPosts = posts.filter((post) => post.data.featured);
const nonFeaturedPosts = posts.filter((post) => !post.data.featured);
const topCandidates = featuredPosts.length ? [...featuredPosts, ...nonFeaturedPosts] : posts;
const leadPost = topCandidates[0] ?? null;
const supportingPosts = topCandidates.slice(1, 3);
const topIds = new Set([leadPost?.id, ...supportingPosts.map((post) => post.id)].filter(Boolean));
const archivePosts = posts.filter((post) => !topIds.has(post.id));
const totalFeatured = featuredPosts.length;

function postDateValue(post: (typeof posts)[number]) {
  const candidate = post.data.updatedDate ?? post.data.pubDate ?? null;
  return candidate instanceof Date ? candidate.valueOf() : 0;
}

function formatDateStamp(value: number) {
  if (!value) return 'n/a';
  return new Date(value).toISOString().slice(0, 10);
}

function postSection(post: (typeof posts)[number]) {
  if (post.data.featured) return 'Featured';
  const firstTag = post.data.tags?.[0];
  return firstTag ? `Tag: ${firstTag}` : 'Notebook';
}

const cliEntries = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  url: `/notebook/${post.id}`,
  section: postSection(post),
  description: post.data.description ?? '',
  tags: post.data.tags ?? [],
  updated: postDateValue(post),
  featured: Boolean(post.data.featured),
}));

const notebookSections = [...new Set(cliEntries.map((entry) => entry.section))];
const notebookTags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))];
const latestPostUpdated = cliEntries.length ? Math.max(...cliEntries.map((entry) => entry.updated)) : 0;

const cliManual = {
  stat: { name: 'stat', synopsis: 'stat', description: 'Show top-level stats for Notebook.', examples: ['stat'], seeAlso: ['help', 'ls', 'man'] },
  help: { name: 'help', synopsis: 'help [command]', description: 'List commands or command help.', examples: ['help', 'help ls'], seeAlso: ['man', 'ls', 'grep'] },
  ls: { name: 'ls', synopsis: 'ls [section]', description: 'List notebook sections or entries in one section.', examples: ['ls', 'ls Featured'], seeAlso: ['cd', 'pwd', 'grep'] },
  cd: { name: 'cd', synopsis: 'cd <section> | cd /', description: 'Change virtual section context.', examples: ['cd Featured', 'cd /'], seeAlso: ['pwd', 'ls'] },
  pwd: { name: 'pwd', synopsis: 'pwd', description: 'Print current virtual path.', examples: ['pwd'], seeAlso: ['cd', 'ls'] },
  cat: { name: 'cat', synopsis: 'cat <post-id|title>', description: 'Show summary for a notebook entry.', examples: ['cat configuring-github-pages-custom-domain-with-squarespace'], seeAlso: ['open', 'man', 'grep'] },
  open: { name: 'open', synopsis: 'open <post-id|title>', description: 'Open a notebook entry.', examples: ['open charlieplexing-6-leds-on-an-attiny85'], seeAlso: ['cat', 'man'] },
  grep: { name: 'grep', synopsis: 'grep <query>', description: 'Search title, description, section, and tags.', examples: ['grep github', 'grep radio'], seeAlso: ['find', 'tag', 'ls'] },
  find: { name: 'find', synopsis: 'find <query>', description: 'Alias for grep.', examples: ['find design'], seeAlso: ['grep', 'tag'] },
  tag: { name: 'tag', synopsis: 'tag <name>', description: 'List entries by tag match.', examples: ['tag github-pages', 'tag electronics'], seeAlso: ['grep', 'ls'] },
  man: { name: 'man', synopsis: 'man [command|topic]', description: 'Open manual pages for commands or notebook entries.', examples: ['man', 'man ls', 'man github'], seeAlso: ['help', 'cat', 'open'] },
  history: { name: 'history', synopsis: 'history', description: 'Show shell command history.', examples: ['history'], seeAlso: ['clear'] },
  clear: { name: 'clear', synopsis: 'clear', description: 'Clear shell output.', examples: ['clear'], seeAlso: ['history'] },
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Notebook — Chips’nCode" description="Essays, field notes, technical write-ups, poetry, reflections, and whatever else deserves to be written down." />
  </head>
  <body>
    <Header />

    <main class="blog-index">
      <PageHeader
        kicker="Notebook / field notes"
        title="Rabbit holes, documented for posterity."
        lede="Technical write-ups, field notes, reflections, and overcomplicated answers to questions that were supposed to be simple."
        variant="index-rail"
        id="notebook-title"
        stats={[
          { label: 'Published', value: posts.length },
          { label: 'Featured', value: totalFeatured },
          { label: 'Tags in use', value: notebookTags.length },
          { label: 'Last updated', value: formatDateStamp(latestPostUpdated) },
        ]}
      />

      {posts.length === 0 ? (
        <div class="panel panel--soft empty">
          <p class="empty-title">Nothing published yet.</p>
          <p class="empty-sub">
            When you publish a post it will appear here automatically. Mark a post as <code>featured: true</code>
            if you want it to compete for one of the top story slots.
          </p>
        </div>
      ) : (
        <>
          {leadPost ? (
            <section class="front-shelf" aria-labelledby="blog-featured-heading">
              <EditorialHeading kicker="Front shelf" title="Featured writing" id="blog-featured-heading" align="split" />

              <div class="front-shelf__layout">
                <article class="notebook-lead">
                  <div class="notebook-lead__meta">
                    <p class="editorial-meta">Notebook {leadPost.data.featured ? '/ Featured' : '/ Latest'}</p>
                    {leadPost.data.pubDate ? <span><FormattedDate date={leadPost.data.pubDate} /></span> : null}
                  </div>
                  <h2><a href={`/notebook/${leadPost.id}`}>{leadPost.data.title}</a></h2>
                  {leadPost.data.description ? <p>{leadPost.data.description}</p> : null}
                  {leadPost.data.tags?.length ? (
                    <div class="notebook-lead__tags">
                      {leadPost.data.tags.slice(0, 5).map((tag) => (
                        <a href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>
                      ))}
                    </div>
                  ) : null}
                  <a class="notebook-lead__open" href={`/notebook/${leadPost.id}`}>Read entry →</a>
                </article>

                <aside class="editorial-list front-shelf__support" aria-label="Supporting posts">
                  {supportingPosts.map((post, index) => (
                    <EditorialEntryRow
                      index={String(index + 2).padStart(2, '0')}
                      meta={`Notebook${post.data.featured ? ' / Featured' : ''}${post.data.pubDate ? ` / ${formatDateStamp(post.data.pubDate.valueOf())}` : ''}`}
                      title={post.data.title}
                      href={`/notebook/${post.id}`}
                      description={post.data.description}
                    />
                  ))}
                </aside>
              </div>
            </section>
          ) : null}

          {archivePosts.length ? (
            <section class="archive" aria-labelledby="blog-archive-heading">
              <aside class="archive__rail">
                <p class="editorial-kicker">Archive</p>
                <h2 id="blog-archive-heading">Everything else</h2>
                <p class="archive__note">The complete notebook, ordered from newest to oldest.</p>
                <nav class="archive__tags" aria-label="Browse notebook tags">
                  {notebookTags.slice(0, 8).map((tag) => (
                    <a href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>
                  ))}
                </nav>
              </aside>

              <div class="editorial-list archive__entries" tabindex="0" aria-label="Notebook archive entries">
                {archivePosts.map((post, index) => (
                  <EditorialEntryRow
                    index={String(index + supportingPosts.length + 2).padStart(2, '0')}
                    meta={`Notebook${post.data.pubDate ? ` / ${formatDateStamp(post.data.pubDate.valueOf())}` : ''}`}
                    title={post.data.title}
                    href={`/notebook/${post.id}`}
                    description={post.data.description}
                  />
                ))}
              </div>
            </section>
          ) : null}
        </>
      )}
    </main>

    <Footer />

    <div class="edge-drawer-instance">
      <input id="notebook-query-toggle" class="edge-drawer-toggle edge-drawer-toggle--query" type="checkbox" />
      <label
        for="notebook-query-toggle"
        class="edge-drawer-tab"
        data-drawer-name="Notebook Query"
        aria-label="Open notebook query drawer"
      >
        Notebook Query
      </label>

      <div class="edge-drawer-overlay edge-drawer-overlay--query" data-edge-drawer="notebook-query-toggle">
        <label for="notebook-query-toggle" class="edge-drawer-backdrop" aria-label="Close notebook query drawer"></label>
        <aside class="edge-drawer-panel edge-drawer-panel--query" role="dialog" aria-modal="true" aria-label="Notebook query drawer">
          <label for="notebook-query-toggle" class="edge-drawer-close edge-drawer-close--query" aria-label="Close notebook query drawer">×</label>
          <CliShell
            shellId="notebook-cli"
            shellTitle="notebook.query"
            initialCommand="stat"
            entries={cliEntries}
            commandManual={cliManual}
            statsLines={[
              { label: 'published_posts', value: posts.length },
              { label: 'sections', value: notebookSections.length },
              { label: 'tags_in_use', value: notebookTags.length },
              { label: 'featured_posts', value: totalFeatured },
              { label: 'last_updated', value: formatDateStamp(latestPostUpdated) },
            ]}
            presets={['ls', 'grep github', 'tag electronics', 'man ls', 'open charlieplexing']}
          />
        </aside>
      </div>
    </div>
  </body>
</html>

<style>
  .blog-index {
    max-width: min(1380px, calc(100% - 2 * var(--space-5)));
  }

  .notebook-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: end;
    margin-bottom: var(--space-5);
  }

  .section-head h2,
  .section-head p {
    margin: 0;
  }

  .section-head p {
    max-width: 40ch;
    color: var(--text-2);
  }

  .eyebrow--accent,
  .eyebrow--muted {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow--accent {
    color: var(--coral);
  }

  .eyebrow--muted {
    color: var(--muted);
  }

  .feature-band {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .feature-band__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: var(--space-5);
    align-items: start;
  }

  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(280px, 0.96fr);
    gap: var(--space-5);
    align-items: stretch;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface-raised) 96%, transparent 4%), color-mix(in srgb, var(--surface) 92%, var(--surface-raised) 8%));
  }

  .lead--textOnly {
    grid-template-columns: 1fr;
    background:
      radial-gradient(620px 200px at top left, rgba(37, 99, 235, 0.08), transparent 68%),
      radial-gradient(420px 180px at bottom right, rgba(20, 184, 166, 0.06), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(248, 250, 252, 0.96));
  }

  .lead__media,
  .supportCard__media,
  .archiveRow__media {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--surface);
  }

  .lead__media {
    min-height: 100%;
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
  }

  .lead__media :global(picture),
  .supportCard__media :global(picture),
  .archiveRow__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lead__media :global(img),
  .supportCard__media :global(img),
  .archiveRow__media :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .lead__copy,
  .supportCard__copy,
  .archiveRow__copy {
    min-width: 0;
  }

  .lead__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    justify-content: center;
  }

  .lead__kickers,
  .supportCard__meta,
  .archiveRow__meta,
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .lead__date,
  .supportCard__date,
  .archiveRow__date {
    font-size: 0.94rem;
    color: var(--muted);
  }

  .lead__title,
  .lead__desc,
  .supportCard__title,
  .supportCard__desc,
  .archiveRow__title,
  .archiveRow__desc {
    margin: 0;
  }

  .lead__title {
    font-size: clamp(2rem, 2.6vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lead__title a,
  .supportCard__title a,
  .archiveRow__title a {
    color: inherit;
    text-decoration: none;
  }

  .lead__title a:hover,
  .supportCard__title a:hover,
  .archiveRow__title a:hover {
    color: var(--accent);
  }

  .lead__desc {
    max-width: 38ch;
    color: var(--text-2);
    font-size: clamp(1rem, 1.15vw, 1.15rem);
  }

  .supportRail {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    align-self: start;
    grid-auto-rows: max-content;
  }

  .supportCard {
    display: grid;
    grid-template-columns: minmax(160px, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-4);
    align-items: stretch;
    align-self: start;
    text-decoration: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(248, 250, 252, 0.94)),
      rgba(255, 255, 255, 0.88);
  }

  .supportCard--textOnly {
    grid-template-columns: 1fr;
    background:
      radial-gradient(440px 160px at top left, rgba(37, 99, 235, 0.06), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(248, 250, 252, 0.96));
  }

  .supportCard__media {
    border-radius: 14px;
    min-height: 100%;
  }

  .supportCard__copy {
    display: grid;
    gap: var(--space-3);
    align-content: center;
  }

  .supportCard--textOnly .supportCard__copy {
    align-content: start;
    padding-top: 0.2rem;
  }

  .supportCard__title {
    font-size: clamp(1.24rem, 1.45vw, 1.6rem);
    line-height: 1.12;
    text-wrap: balance;
  }

  .supportCard__desc {
    color: var(--text-2);
    font-size: 0.98rem;
  }

  .archive {
    display: grid;
    gap: var(--space-5);
  }

  .section-head--archive {
    align-items: start;
  }

  .archiveList {
    display: grid;
    gap: 1rem;
  }

  .archiveRow {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: stretch;
    padding: 0.95rem 0;
    border-top: 1px solid color-mix(in srgb, var(--border) 84%, transparent 16%);
  }

  .archiveRow--textOnly {
    grid-template-columns: 1fr;
    padding-left: 0.2rem;
  }

  .archiveRow:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .archiveRow__media {
    border-radius: 16px;
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow-sm);
  }

  .archiveRow__copy {
    display: grid;
    gap: 0.5rem;
    align-content: center;
  }

  .archiveRow--textOnly .archiveRow__copy {
    align-content: start;
  }

  .archiveRow__title {
    font-size: 1.28rem;
    line-height: 1.14;
    text-wrap: balance;
  }

  .archiveRow__desc {
    max-width: 60ch;
    color: var(--text-2);
  }

  .empty {
    padding: var(--space-6);
  }

  .empty-title {
    margin: 0 0 0.4rem 0;
    font-weight: 700;
    color: var(--text);
  }

  .empty-sub {
    margin: 0;
    color: var(--text-2);
    max-width: 80ch;
  }

  @media (max-width: 1240px) {
    .notebook-hero {
      grid-template-columns: 1fr;
    }

    .feature-band__grid,
    .lead {
      grid-template-columns: 1fr;
    }

    .lead__desc {
      max-width: none;
    }
  }

  @media (max-width: 980px) {
    .section-head {
      flex-direction: column;
      align-items: start;
    }

    .section-head p {
      max-width: none;
    }
  }

  @media (max-width: 820px) {
    .supportCard,
    .archiveRow {
      grid-template-columns: 1fr;
    }

    .supportCard__media,
    .archiveRow__media {
      aspect-ratio: 16 / 9;
    }
  }

  /* Editorial framework composition */
  .blog-index {
    width: min(100%, 1320px);
    max-width: 1320px;
    padding-top: 0;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .notebook-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .notebook-intro__copy h1 {
    max-width: 900px;
    margin: 0.85rem 0 1.2rem;
    font-size: clamp(3.7rem, 7.5vw, 7.4rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .notebook-intro__copy > p:last-child {
    max-width: 62ch;
    margin: 0;
    color: var(--text-2);
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
  }

  .notebook-stats {
    margin: 0;
    border-top: 1px solid var(--text);
  }

  .notebook-stats div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .notebook-stats dt,
  .notebook-stats dd {
    margin: 0;
  }

  .notebook-stats dt {
    color: var(--muted);
  }

  .notebook-stats dd {
    color: var(--text);
    text-align: right;
  }

  .front-shelf {
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }

  .notebook-lead {
    position: relative;
    padding: clamp(2rem, 5vw, 4rem) 0;
    border-bottom: 1px solid var(--text);
  }

  .notebook-lead__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .notebook-lead h2 {
    max-width: 900px;
    margin: 1rem 0 1rem;
    font-size: clamp(1.75rem, 2.5vw, 2.4rem);
    line-height: 1.02;
    letter-spacing: -0.042em;
  }

  .notebook-lead h2 a {
    color: inherit;
    text-decoration: none;
  }

  .notebook-lead h2 a:hover {
    color: var(--accent);
  }

  .notebook-lead > p {
    max-width: 66ch;
    margin: 0;
    color: var(--text-2);
    font-size: 1.05rem;
  }

  .notebook-lead__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .notebook-lead__tags a {
    color: var(--tag-ink);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .notebook-lead__open {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--text);
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  .archive {
    display: block;
  }

  .archive__note {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .front-shelf__layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(340px, 5fr);
    border-bottom: 1px solid var(--text);
  }

  .front-shelf__layout .notebook-lead {
    padding: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 4vw, 4rem) clamp(2rem, 4vw, 3.5rem) 0;
    border-right: 1px solid var(--border);
    border-bottom: 0;
  }

  .front-shelf__support {
    align-self: stretch;
    padding-left: clamp(1.5rem, 3vw, 3rem);
  }

  .front-shelf__support :global(.editorial-row) {
    grid-template-columns: 30px minmax(0, 1fr) 24px;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  .front-shelf__support :global(.editorial-row__title) {
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
  }

  .front-shelf__support :global(.editorial-row__description) {
    font-size: 0.86rem;
  }

  .archive {
    display: grid;
    grid-template-columns: minmax(220px, 0.34fr) minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--text);
  }

  .archive__rail {
    position: sticky;
    top: 112px;
  }

  .archive__rail h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(2rem, 3vw, 2.8rem);
    letter-spacing: -0.045em;
  }

  .archive__tags {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .archive__tags a {
    width: fit-content;
    color: var(--tag-ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-decoration: none;
  }

  .archive__tags a:hover {
    color: var(--accent);
  }

  .archive__entries {
    border-top: 0;
    max-height: min(62vh, 620px);
    overflow-y: auto;
    overscroll-behavior: contain;
