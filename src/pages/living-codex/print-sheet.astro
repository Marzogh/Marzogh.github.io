---
---
<head>
  <link rel="icon" type="image/png" sizes="32x32" href="/living-codex/assets/rahu-favicon.png" />
  <link rel="apple-touch-icon" href="/living-codex/assets/rahu-favicon.png" />
</head>

<main class="lcx-print-shell">
  <div class="lcx-print-toolbar" id="lcx-print-toolbar">
    <button id="lcx-print-btn" type="button">Print / Save as PDF</button>
    <input id="lcx-zip-input" type="file" accept=".zip,application/zip" />
    <button id="lcx-load-zip-btn" type="button">Load ZIP</button>
    <span id="lcx-print-status">Load a ZIP from the project page first.</span>
  </div>
  <div id="lcx-print-root"></div>
</main>
<script type="module" src="/scripts/living-codex-print-sheet.mjs"></script>

<style>
  :global(html), :global(body) {
    margin: 0;
    padding: 0;
    background: #f4f6fb;
    color: #1b2432;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  }

  .lcx-print-shell {
    width: min(100%, 980px);
    margin: 0 auto;
    padding: 1rem;
    display: grid;
    gap: 0.8rem;
  }

  .lcx-print-toolbar {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    position: sticky;
    top: 0.5rem;
    z-index: 20;
    background: #ffffff;
    border: 1px solid #d7deea;
    border-radius: 0.6rem;
    padding: 0.55rem 0.7rem;
  }

  .lcx-print-toolbar button {
    border: 1px solid #c8d1df;
    border-radius: 0.55rem;
    padding: 0.42rem 0.7rem;
    background: #f7f9fd;
    color: #1b2432;
    font-weight: 600;
    cursor: pointer;
  }

  .lcx-print-toolbar span {
    color: #4a5568;
    font-size: 0.92rem;
  }

  @media print {
    .lcx-print-toolbar { display: none; }
    .lcx-print-shell { width: auto; margin: 0; padding: 0; }
  }
</style>
