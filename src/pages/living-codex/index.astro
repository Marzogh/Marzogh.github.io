---
const destination = 'https://chipsncode.com/The-Living-Codex/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={destination} />
    <title>The Living Codex has moved</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>The Living Codex has moved to <a href={destination}>{destination}</a>.</p>
  </body>
</html>
