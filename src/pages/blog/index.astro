---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import IndexHeader from '../../components/IndexHeader.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => {
  const aTime = a.data.pubDate ? a.data.pubDate.getTime() : 0;
  const bTime = b.data.pubDate ? b.data.pubDate.getTime() : 0;
  if (bTime !== aTime) return bTime - aTime;
  return a.data.title.localeCompare(b.data.title);
});

const featuredPosts = posts.filter((post) => post.data.featured);
const nonFeaturedPosts = posts.filter((post) => !post.data.featured);
const topCandidates = featuredPosts.length ? [...featuredPosts, ...nonFeaturedPosts] : posts;
const leadPost = topCandidates[0] ?? null;
const supportingPosts = topCandidates.slice(1, 3);
const topIds = new Set([leadPost?.id, ...supportingPosts.map((post) => post.id)].filter(Boolean));
const archivePosts = posts.filter((post) => !topIds.has(post.id));
const totalFeatured = featuredPosts.length;

function pickThumb(data: any) {
  return data.thumbnail ?? data.thumb ?? data.cover ?? data.coverImage ?? data.heroImage ?? data.image ?? null;
}

function imageSizes(kind: 'lead' | 'support' | 'archive') {
  if (kind === 'lead') return '(max-width: 920px) 100vw, (max-width: 1240px) 58vw, 720px';
  if (kind === 'support') return '(max-width: 920px) 100vw, (max-width: 1240px) 42vw, 520px';
  return '(max-width: 720px) 100vw, (max-width: 1120px) 42vw, 360px';
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Blog — Chips’nCode" description="Technical essays, field notes, experiments, and reflections." />
  </head>
  <body>
    <Header />

    <main class="blog-index">
      <IndexHeader
        eyebrow="Notebook"
        title="Blog"
        lede="Technical essays, field notes, experiments, long-form write-ups, and the occasional deep dive into something that refused to behave."
        terminalTitle="blog.index"
        statusLines={[
          { label: 'published_posts', value: posts.length },
          { label: 'featured_posts', value: totalFeatured },
          { label: 'top_slots_used', value: `${Math.min(posts.length, 3)}/3` },
        ]}
      />

      {posts.length === 0 ? (
        <div class="panel panel--soft empty">
          <p class="empty-title">Nothing published yet.</p>
          <p class="empty-sub">
            When you publish a post it will appear here automatically. Mark a post as <code>featured: true</code>
            if you want it to compete for one of the top story slots.
          </p>
        </div>
      ) : (
        <>
          {leadPost ? (
            <section class="feature-band" aria-labelledby="blog-featured-heading">
              <div class="section-head">
                <div>
                  <p class="eyebrow eyebrow--accent">Front Shelf</p>
                  <h2 id="blog-featured-heading">Featured writing</h2>
                </div>
              </div>

              <div class="feature-band__grid">
                <article class:list={['lead panel', !pickThumb(leadPost.data) && 'lead--textOnly']}>
                  {pickThumb(leadPost.data) ? (
                    <a class="lead__media" href={`/blog/${leadPost.id}`} aria-label={`Open post: ${leadPost.data.title}`}>
                      {typeof pickThumb(leadPost.data) === 'string' ? (
                        <img src={pickThumb(leadPost.data)} alt="" loading="eager" decoding="async" />
                      ) : (
                        <Image
                          src={pickThumb(leadPost.data)}
                          alt=""
                          widths={[720, 1080, 1440]}
                          sizes={imageSizes('lead')}
                        />
                      )}
                    </a>
                  ) : null}

                  <div class="lead__copy">
                    <div class="lead__kickers">
                      <span class="pill">{leadPost.data.featured ? 'Lead feature' : 'Latest post'}</span>
                      {leadPost.data.featured ? <span class="pill pill--coral">Featured</span> : null}
                      {leadPost.data.pubDate ? (
                        <span class="lead__date">
                          <FormattedDate date={leadPost.data.pubDate} />
                        </span>
                      ) : null}
                    </div>

                    <h3 class="lead__title">
                      <a href={`/blog/${leadPost.id}`}>{leadPost.data.title}</a>
                    </h3>

                    {leadPost.data.description ? <p class="lead__desc">{leadPost.data.description}</p> : null}

                    {leadPost.data.tags?.length ? (
                      <div class="tag-row">
                        {leadPost.data.tags.slice(0, 4).map((tag) => <span class="tagChip">#{tag}</span>)}
                      </div>
                    ) : null}

                  </div>
                </article>

                <div class="supportRail" aria-label="Supporting posts">
                  {supportingPosts.map((post) => {
                    const thumb = pickThumb(post.data);

                    return (
                      <article class:list={['supportCard panel panel--soft', !thumb && 'supportCard--textOnly']}>
                        {thumb ? (
                          <a class="supportCard__media" href={`/blog/${post.id}`} aria-label={`Open post: ${post.data.title}`}>
                            {typeof thumb === 'string' ? (
                              <img src={thumb} alt="" loading="lazy" decoding="async" />
                            ) : (
                              <Image
                                src={thumb}
                                alt=""
                                widths={[520, 720, 960]}
                                sizes={imageSizes('support')}
                              />
                            )}
                          </a>
                        ) : null}

                        <div class="supportCard__copy">
                          <div class="supportCard__meta">
                            {post.data.featured ? <span class="pill pill--coral">Featured</span> : <span class="pill">Recent</span>}
                            {post.data.pubDate ? (
                              <span class="supportCard__date">
                                <FormattedDate date={post.data.pubDate} />
                              </span>
                            ) : null}
                          </div>

                          <h3 class="supportCard__title">
                            <a href={`/blog/${post.id}`}>{post.data.title}</a>
                          </h3>

                          {post.data.description ? <p class="supportCard__desc">{post.data.description}</p> : null}
                        </div>
                      </article>
                    );
                  })}
                </div>
              </div>
            </section>
          ) : null}

          {archivePosts.length ? (
            <section class="archive" aria-labelledby="blog-archive-heading">
              <div class="section-head section-head--archive">
                <div>
                  <p class="eyebrow eyebrow--muted">Archive</p>
                  <h2 id="blog-archive-heading">Everything else</h2>
                </div>
                <p>Older posts fall into a denser archive so the page can stay readable as it grows.</p>
              </div>

              <div class="archiveList">
                {archivePosts.map((post) => {
                  const thumb = pickThumb(post.data);

                  return (
                    <article class:list={['archiveRow', !thumb && 'archiveRow--textOnly']}>
                      {thumb ? (
                        <a class="archiveRow__media" href={`/blog/${post.id}`} aria-label={`Open post: ${post.data.title}`}>
                          {typeof thumb === 'string' ? (
                            <img src={thumb} alt="" loading="lazy" decoding="async" />
                          ) : (
                            <Image
                              src={thumb}
                              alt=""
                              widths={[360, 520, 720]}
                              sizes={imageSizes('archive')}
                            />
                          )}
                        </a>
                      ) : null}

                      <div class="archiveRow__copy">
                        <div class="archiveRow__meta">
                          {post.data.pubDate ? (
                            <span class="archiveRow__date">
                              <FormattedDate date={post.data.pubDate} />
                            </span>
                          ) : null}
                          {post.data.featured ? <span class="pill pill--coral">Featured</span> : null}
                        </div>

                        <h3 class="archiveRow__title">
                          <a href={`/blog/${post.id}`}>{post.data.title}</a>
                        </h3>

                        {post.data.description ? <p class="archiveRow__desc">{post.data.description}</p> : null}
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          ) : null}
        </>
      )}
    </main>

    <Footer />
  </body>
</html>

<style>
  .blog-index {
    max-width: min(1380px, calc(100% - 2 * var(--space-5)));
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: end;
    margin-bottom: var(--space-5);
  }

  .section-head h2,
  .section-head p {
    margin: 0;
  }

  .section-head p {
    max-width: 40ch;
    color: var(--text-2);
  }

  .eyebrow--accent,
  .eyebrow--muted {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow--accent {
    color: var(--coral);
  }

  .eyebrow--muted {
    color: var(--muted);
  }

  .feature-band {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .feature-band__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: var(--space-5);
    align-items: start;
  }

  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(280px, 0.96fr);
    gap: var(--space-5);
    align-items: stretch;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface-raised) 96%, transparent 4%), color-mix(in srgb, var(--surface) 92%, var(--surface-raised) 8%));
  }

  .lead--textOnly {
    grid-template-columns: 1fr;
    background:
      radial-gradient(620px 200px at top left, rgba(37, 99, 235, 0.08), transparent 68%),
      radial-gradient(420px 180px at bottom right, rgba(20, 184, 166, 0.06), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(248, 250, 252, 0.96));
  }

  .lead__media,
  .supportCard__media,
  .archiveRow__media {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--surface);
  }

  .lead__media {
    min-height: 100%;
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
  }

  .lead__media :global(picture),
  .supportCard__media :global(picture),
  .archiveRow__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lead__media :global(img),
  .supportCard__media :global(img),
  .archiveRow__media :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .lead__copy,
  .supportCard__copy,
  .archiveRow__copy {
    min-width: 0;
  }

  .lead__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    justify-content: center;
  }

  .lead__kickers,
  .supportCard__meta,
  .archiveRow__meta,
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .lead__date,
  .supportCard__date,
  .archiveRow__date {
    font-size: 0.94rem;
    color: var(--muted);
  }

  .lead__title,
  .lead__desc,
  .supportCard__title,
  .supportCard__desc,
  .archiveRow__title,
  .archiveRow__desc {
    margin: 0;
  }

  .lead__title {
    font-size: clamp(2rem, 2.6vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lead__title a,
  .supportCard__title a,
  .archiveRow__title a {
    color: inherit;
    text-decoration: none;
  }

  .lead__title a:hover,
  .supportCard__title a:hover,
  .archiveRow__title a:hover {
    color: var(--accent);
  }

  .lead__desc {
    max-width: 38ch;
    color: var(--text-2);
    font-size: clamp(1rem, 1.15vw, 1.15rem);
  }

  .tagChip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.34rem 0.62rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-glass);
    color: var(--text-2);
    font-size: 0.82rem;
    line-height: 1;
  }

  .supportRail {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    align-self: start;
    grid-auto-rows: max-content;
  }

  .supportCard {
    display: grid;
    grid-template-columns: minmax(160px, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-4);
    align-items: stretch;
    align-self: start;
    text-decoration: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(248, 250, 252, 0.94)),
      rgba(255, 255, 255, 0.88);
  }

  .supportCard--textOnly {
    grid-template-columns: 1fr;
    background:
      radial-gradient(440px 160px at top left, rgba(37, 99, 235, 0.06), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(248, 250, 252, 0.96));
  }

  .supportCard__media {
    border-radius: 14px;
    min-height: 100%;
  }

  .supportCard__copy {
    display: grid;
    gap: var(--space-3);
    align-content: center;
  }

  .supportCard--textOnly .supportCard__copy {
    align-content: start;
    padding-top: 0.2rem;
  }

  .supportCard__title {
    font-size: clamp(1.24rem, 1.45vw, 1.6rem);
    line-height: 1.12;
    text-wrap: balance;
  }

  .supportCard__desc {
    color: var(--text-2);
    font-size: 0.98rem;
  }

  .archive {
    display: grid;
    gap: var(--space-5);
  }

  .section-head--archive {
    align-items: start;
  }

  .archiveList {
    display: grid;
    gap: 1rem;
  }

  .archiveRow {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: stretch;
    padding: 0.95rem 0;
    border-top: 1px solid color-mix(in srgb, var(--border) 84%, transparent 16%);
  }

  .archiveRow--textOnly {
    grid-template-columns: 1fr;
    padding-left: 0.2rem;
  }

  .archiveRow:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .archiveRow__media {
    border-radius: 16px;
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow-sm);
  }

  .archiveRow__copy {
    display: grid;
    gap: 0.5rem;
    align-content: center;
  }

  .archiveRow--textOnly .archiveRow__copy {
    align-content: start;
  }

  .archiveRow__title {
    font-size: 1.28rem;
    line-height: 1.14;
    text-wrap: balance;
  }

  .archiveRow__desc {
    max-width: 60ch;
    color: var(--text-2);
  }

  .empty {
    padding: var(--space-6);
  }

  .empty-title {
    margin: 0 0 0.4rem 0;
    font-weight: 700;
    color: var(--text);
  }

  .empty-sub {
    margin: 0;
    color: var(--text-2);
    max-width: 80ch;
  }

  @media (max-width: 1240px) {
    .feature-band__grid,
    .lead {
      grid-template-columns: 1fr;
    }

    .lead__desc {
      max-width: none;
    }
  }

  @media (max-width: 980px) {
    .section-head {
      flex-direction: column;
      align-items: start;
    }

    .section-head p {
      max-width: none;
    }
  }

  @media (max-width: 820px) {
    .supportCard,
    .archiveRow {
      grid-template-columns: 1fr;
    }

    .supportCard__media,
    .archiveRow__media {
      aspect-ratio: 16 / 9;
    }
  }
</style>
