---
const target = '/notebook';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>Notebook</a>.</p>
    <script is:inline>
      window.location.replace('/notebook');
    </script>
  </body>
</html>
