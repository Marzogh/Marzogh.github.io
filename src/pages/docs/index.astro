---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getDocSectionMeta } from '../../utils/docs';

const docs = (await getCollection('docs', ({ data }) => !data.draft)).sort((a, b) => {
  const aSection = getDocSectionMeta(a.data.section);
  const bSection = getDocSectionMeta(b.data.section);
  const aRank = aSection.label === 'Site Meta' ? Number.MAX_SAFE_INTEGER : aSection.rank;
  const bRank = bSection.label === 'Site Meta' ? Number.MAX_SAFE_INTEGER : bSection.rank;
  const sectionOrder = aRank - bRank;
  if (sectionOrder) return sectionOrder;
  const order = (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER);
  return order || a.data.title.localeCompare(b.data.title);
});

const toDateValue = (doc: (typeof docs)[number]) => (doc.data.updatedDate ?? doc.data.pubDate)?.valueOf() ?? 0;
const formatDate = (doc: (typeof docs)[number]) => {
  const date = doc.data.updatedDate ?? doc.data.pubDate;
  return date ? new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }).format(date) : 'Undated';
};

const getDocKind = (doc: (typeof docs)[number]) => {
  const section = getDocSectionMeta(doc.data.section).label;
  const tags = new Set((doc.data.tags ?? []).map((tag) => tag.toLowerCase()));
  if (tags.has('protocol')) return 'Protocol';
  if (tags.has('setup') || tags.has('tutorial') || section === 'Platform Guides') return 'Guide';
  if (section === 'Reference' || tags.has('reference') || tags.has('field-reference')) return 'Reference';
  if (section === 'Arduino Notes' || tags.has('electronics') || tags.has('hardware')) return 'Hardware';
  if (section === 'Site Meta') return tags.has('archive') ? 'Archive' : 'Site system';
  return 'Documentation';
};

const sectionBuckets = docs.reduce<Array<{ label: string; description: string; items: typeof docs }>>((groups, doc) => {
  const meta = getDocSectionMeta(doc.data.section);
  const current = groups[groups.length - 1];
  if (!current || current.label !== meta.label) groups.push({ label: meta.label, description: meta.description, items: [doc] });
  else current.items.push(doc);
  return groups;
}, []);

const recommended = [...docs]
  .sort((a, b) => Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured)) || toDateValue(b) - toDateValue(a))
  .slice(0, 3);

const searchRows = docs.map((doc) => ({
  id: doc.id,
  terms: `${doc.data.title} ${doc.data.description} ${doc.data.section ?? ''} ${getDocKind(doc)} ${(doc.data.tags ?? []).join(' ')}`.toLowerCase(),
}));
---

<!doctype html>
<html lang="en">
  <head><BaseHead title="Documentation — Chips’nCode" description="Guides, field references, protocols, manuals, and preserved technical notes." /></head>
  <body>
    <Header />
    <main class="docs-library">
      <header class="docs-library__header">
        <div>
          <p class="editorial-kicker">Reference library</p>
          <h1>Documentation</h1>
          <p>Guides, field references, protocols, manuals, and technical material written to be found again.</p>
        </div>
        <dl>
          <div><dt>Documents</dt><dd>{docs.length}</dd></div>
          <div><dt>Sections</dt><dd>{sectionBuckets.length}</dd></div>
          <div><dt>Updated</dt><dd>{formatDate([...docs].sort((a, b) => toDateValue(b) - toDateValue(a))[0])}</dd></div>
        </dl>
      </header>

      <section class="docs-find" aria-labelledby="docs-find-title">
        <div>
          <p class="editorial-kicker">Find something</p>
          <h2 id="docs-find-title">Search the library</h2>
        </div>
        <label>
          <span class="sr-only">Search documentation</span>
          <input type="search" placeholder="Try a radio, protocol, platform, or task…" autocomplete="off" data-doc-search />
        </label>
      </section>

      <section class="docs-shelf" aria-labelledby="docs-shelf-title">
        <div class="docs-section-heading">
          <p class="editorial-kicker">Front shelf</p>
          <h2 id="docs-shelf-title">Useful now</h2>
        </div>
        <div class="docs-shelf__grid">
          {recommended.map((doc) => (
            <a href={`/docs/${doc.id}`}>
              <span>{getDocKind(doc)}</span>
              <h3>{doc.data.title}</h3>
              <p>{doc.data.description}</p>
              <small>{formatDate(doc)} <i aria-hidden="true">→</i></small>
            </a>
          ))}
        </div>
      </section>

      <section class="docs-catalogue" aria-labelledby="docs-catalogue-title">
        <aside>
          <p class="editorial-kicker">Browse by section</p>
          <nav aria-label="Filter documentation">
            <button class="is-active" type="button" data-doc-filter="all">All <span>{docs.length}</span></button>
            {sectionBuckets.map((section) => <button type="button" data-doc-filter={section.label}>{section.label} <span>{section.items.length}</span></button>)}
          </nav>
        </aside>

        <div class="docs-catalogue__body">
          <div class="docs-section-heading docs-section-heading--catalogue">
            <p class="editorial-kicker">Directory</p>
            <h2 id="docs-catalogue-title">All documentation</h2>
            <p data-doc-count>{docs.length} documents</p>
          </div>

          <div class="docs-groups">
            {sectionBuckets.map((section) => (
              <section class="docs-group" data-doc-group={section.label}>
                <header><div><h3>{section.label}</h3><p>{section.description}</p></div><span>{section.items.length}</span></header>
                <div>
                  {section.items.map((doc) => (
                    <a href={`/docs/${doc.id}`} data-doc-row={doc.id}>
                      <span class="docs-row__kind">{getDocKind(doc)}</span>
                      <span class="docs-row__copy"><strong>{doc.data.title}</strong><small>{doc.data.description}</small></span>
                      <span class="docs-row__date">{formatDate(doc)}</span>
                      <span class="docs-row__arrow" aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
          <p class="docs-no-results" hidden data-doc-empty>No documentation matches that search.</p>
        </div>
      </section>
    </main>
    <Footer />

    <script is:inline define:vars={{ searchRows }}>
      (() => {
        const input = document.querySelector('[data-doc-search]');
        const buttons = Array.from(document.querySelectorAll('[data-doc-filter]'));
        const rows = Array.from(document.querySelectorAll('[data-doc-row]'));
        const groups = Array.from(document.querySelectorAll('[data-doc-group]'));
        const count = document.querySelector('[data-doc-count]');
        const empty = document.querySelector('[data-doc-empty]');
        const terms = new Map((searchRows || []).map((row) => [row.id, row.terms]));
        let section = 'all';

        const update = () => {
          const query = input?.value.trim().toLowerCase() || '';
          let shown = 0;
          rows.forEach((row) => {
            const group = row.closest('[data-doc-group]')?.getAttribute('data-doc-group') || '';
            const matchesSection = section === 'all' || section === group;
            const matchesQuery = !query || (terms.get(row.getAttribute('data-doc-row')) || '').includes(query);
            row.hidden = !(matchesSection && matchesQuery);
            if (!row.hidden) shown += 1;
          });
          groups.forEach((group) => { group.hidden = !group.querySelector('[data-doc-row]:not([hidden])'); });
          if (count) count.textContent = `${shown} document${shown === 1 ? '' : 's'}`;
          if (empty) empty.hidden = shown !== 0;
        };

        buttons.forEach((button) => button.addEventListener('click', () => {
          section = button.getAttribute('data-doc-filter') || 'all';
          buttons.forEach((item) => item.classList.toggle('is-active', item === button));
          update();
        }));
        input?.addEventListener('input', update);
      })();
    </script>
  </body>
</html>

<style>
  .docs-library { width: min(1320px, calc(100% - 4rem)); max-width: 1320px; padding: clamp(2rem, 5vw, 4.5rem) 0 clamp(5rem, 9vw, 8rem); }
  .docs-library__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; padding-bottom: clamp(1.5rem, 3vw, 2.5rem); border-bottom: 1px solid var(--text); }
  .docs-library__header h1 { margin: 0.45rem 0 0; font-size: clamp(3rem, 7vw, 6.8rem); line-height: 0.9; letter-spacing: -0.055em; }
  .docs-library__header > div > p:last-child { max-width: 64ch; margin: 1.2rem 0 0; color: var(--text-2); font-size: clamp(1rem, 1.3vw, 1.18rem); }
  .docs-library__header dl { display: grid; grid-template-columns: repeat(3, auto); margin: 0; border-block: 1px solid var(--border); }
  .docs-library__header dl div { display: grid; gap: 0.25rem; padding: 0.65rem 0.9rem; border-left: 1px solid var(--border); }
  .docs-library__header dt { color: var(--muted); font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .docs-library__header dd { margin: 0; color: var(--text); font-size: 0.86rem; font-weight: 650; }

  .docs-find { display: grid; grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr); gap: 1.5rem; align-items: end; padding: 1.1rem 0; border-bottom: 1px solid var(--border); }
  .docs-find h2 { margin: 0.25rem 0 0; font-size: 1.15rem; }
  .docs-find input { width: 100%; min-height: 3rem; padding: 0.65rem 0; border: 0; border-bottom: 1px solid var(--text); border-radius: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 1rem; }
  .docs-find input:focus { border-bottom-color: var(--accent); box-shadow: 0 1px 0 var(--accent); }

  .docs-section-heading { display: grid; grid-template-columns: 180px minmax(0, 1fr); align-items: baseline; padding-bottom: 0.85rem; border-bottom: 1px solid var(--text); }
  .docs-section-heading h2 { margin: 0; font-size: clamp(1.65rem, 3vw, 2.7rem); letter-spacing: -0.035em; }
  .docs-shelf { margin-top: clamp(2.5rem, 5vw, 4.5rem); }
  .docs-shelf__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--border); }
  .docs-shelf__grid > a { display: flex; flex-direction: column; min-width: 0; min-height: 245px; padding: 1.2rem; border-left: 1px solid var(--border); color: inherit; text-decoration: none; }
  .docs-shelf__grid > a:first-child { border-left: 0; }
  .docs-shelf__grid > a:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .docs-shelf__grid span { color: var(--accent); font-family: var(--font-mono); font-size: 0.63rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .docs-shelf__grid h3 { margin: 0.7rem 0 0; font-size: 1.3rem; line-height: 1.08; }
  .docs-shelf__grid p { margin: 0.75rem 0 1rem; color: var(--text-2); font-size: 0.9rem; line-height: 1.5; }
  .docs-shelf__grid small { display: flex; justify-content: space-between; gap: 1rem; margin-top: auto; color: var(--muted); font-family: var(--font-mono); font-size: 0.64rem; }
  .docs-shelf__grid i { color: var(--text); font-size: 1rem; font-style: normal; }

  .docs-catalogue { display: grid; grid-template-columns: minmax(180px, 220px) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; margin-top: clamp(3rem, 7vw, 6rem); }
  .docs-catalogue > aside { position: sticky; top: calc(var(--header-height, 4.5rem) + 1rem); }
  .docs-catalogue > aside nav { display: grid; margin-top: 0.75rem; border-top: 1px solid var(--text); }
  .docs-catalogue > aside button { display: flex; justify-content: space-between; gap: 1rem; padding: 0.68rem 0; border: 0; border-bottom: 1px solid var(--border); border-radius: 0; background: transparent; color: var(--text-2); font-size: 0.76rem; text-align: left; cursor: pointer; }
  .docs-catalogue > aside button:hover, .docs-catalogue > aside button.is-active { padding-left: 0.55rem; background: color-mix(in srgb, var(--accent) 6%, transparent); color: var(--text); box-shadow: inset 2px 0 0 var(--accent); }
  .docs-catalogue > aside button span { color: var(--muted); font-family: var(--font-mono); font-size: 0.62rem; }
  .docs-section-heading--catalogue { grid-template-columns: 1fr auto; }
  .docs-section-heading--catalogue .editorial-kicker { grid-column: 1 / -1; margin-bottom: 0.25rem; }
  .docs-section-heading--catalogue > p:last-child { margin: 0; color: var(--muted); font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; }

  .docs-group { margin-top: 2rem; }
  .docs-group > header { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; padding-bottom: 0.65rem; border-bottom: 1px solid var(--border); }
  .docs-group > header h3, .docs-group > header p { margin: 0; }
  .docs-group > header h3 { font-size: 1.2rem; }
  .docs-group > header p { max-width: 72ch; margin-top: 0.2rem; color: var(--muted); font-size: 0.8rem; }
  .docs-group > header > span { color: var(--muted); font-family: var(--font-mono); font-size: 0.63rem; }
  .docs-group [data-doc-row] { display: grid; grid-template-columns: 85px minmax(0, 1fr) 90px 22px; gap: 1rem; align-items: start; padding: 1rem 0; border-bottom: 1px solid var(--border); color: inherit; text-decoration: none; }
  .docs-group [data-doc-row]:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .docs-row__kind, .docs-row__date { color: var(--muted); font-family: var(--font-mono); font-size: 0.62rem; text-transform: uppercase; }
  .docs-row__copy { display: grid; gap: 0.28rem; }
  .docs-row__copy strong { line-height: 1.2; }
  .docs-row__copy small { color: var(--text-2); font-size: 0.82rem; line-height: 1.45; }
  .docs-row__arrow { justify-self: end; color: var(--accent); }
  .docs-no-results { padding: 2rem 0; color: var(--muted); }

  @media (max-width: 820px) {
    .docs-library { width: min(100% - 2rem, 1320px); }
    .docs-library__header { grid-template-columns: 1fr; }
    .docs-library__header dl { grid-template-columns: repeat(3, 1fr); }
    .docs-find { grid-template-columns: 1fr; gap: 0.7rem; }
    .docs-section-heading { grid-template-columns: 1fr; gap: 0.3rem; }
    .docs-shelf__grid { grid-template-columns: 1fr; }
    .docs-shelf__grid > a { min-height: 0; border-top: 1px solid var(--border); border-left: 0; }
    .docs-catalogue { grid-template-columns: 1fr; gap: 1.5rem; }
    .docs-catalogue > aside { position: static; }
    .docs-catalogue > aside nav { display: flex; overflow-x: auto; border-bottom: 1px solid var(--border); }
    .docs-catalogue > aside button { flex: 0 0 auto; padding: 0.65rem 0.75rem; border-bottom: 0; white-space: nowrap; }
    .docs-catalogue > aside button:hover, .docs-catalogue > aside button.is-active { padding-left: 0.75rem; box-shadow: inset 0 -2px 0 var(--accent); }
    .docs-group [data-doc-row] { grid-template-columns: 70px minmax(0, 1fr) 20px; gap: 0.75rem; }
    .docs-row__date { display: none; }
  }
</style>
