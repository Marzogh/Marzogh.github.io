---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import CliShell from '../../components/CliShell.astro';
import { getDocSectionMeta } from '../../utils/docs';
import { toTagSlug } from '../../utils/tags';

const docs = (await getCollection('docs', ({ data }) => !data.draft)).sort((a, b) => {
  const aSection = getDocSectionMeta(a.data.section);
  const bSection = getDocSectionMeta(b.data.section);
  const aIsSiteMeta = aSection.label === 'Site Meta';
  const bIsSiteMeta = bSection.label === 'Site Meta';
  if (aIsSiteMeta !== bIsSiteMeta) return aIsSiteMeta ? 1 : -1;
  if (aSection.rank !== bSection.rank) return aSection.rank - bSection.rank;
  const orderCompare = (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER);
  if (orderCompare !== 0) return orderCompare;
  return a.data.title.localeCompare(b.data.title);
});

function toDateValue(doc: (typeof docs)[number]) {
  const candidate = doc.data.updatedDate ?? doc.data.pubDate ?? null;
  return candidate instanceof Date ? candidate.valueOf() : 0;
}

function formatDateStamp(value: number) {
  if (!value) return 'n/a';
  return new Date(value).toISOString().slice(0, 10);
}

function getDocKind(doc: (typeof docs)[number]) {
  const section = getDocSectionMeta(doc.data.section).label;
  const tags = new Set((doc.data.tags ?? []).map((tag) => tag.toLowerCase()));

  if (tags.has('protocol')) return 'Protocol reference';
  if (tags.has('setup') || tags.has('tutorial') || section === 'Platform Guides') return 'Setup guide';
  if (section === 'Reference' || tags.has('reference') || tags.has('field-reference') || tags.has('pinout')) return 'Reference';
  if (section === 'Arduino Notes' || tags.has('electronics') || tags.has('hardware')) return 'Hardware note';
  if (section === 'Site Meta' || tags.has('website') || tags.has('design-system')) return 'Site meta';
  return 'Guide';
}

const docsByFresh = [...docs].sort((a, b) => toDateValue(b) - toDateValue(a));
const latestDocUpdated = docsByFresh[0] ? toDateValue(docsByFresh[0]) : 0;
const latestDocs = docsByFresh.slice(0, 3);

const usefulNow = [
  ...docs.filter((doc) => doc.data.featured),
  ...docs.filter((doc) => ['Reference', 'Setup guide', 'Protocol reference'].includes(getDocKind(doc))),
].filter((doc, idx, arr) => arr.findIndex((d) => d.id === doc.id) === idx).slice(0, 3);

const quickPaths = [
  {
    label: 'Field references',
    description: 'Bench and field lookups: radios, pinouts, menus, and compact tables.',
    preset: 'kind:reference',
    docs: docs.filter((doc) => getDocKind(doc) === 'Reference').slice(0, 2),
  },
  {
    label: 'Setup guides',
    description: 'Procedural notes for getting machines, networks, and tools behaving.',
    preset: 'kind:setup',
    docs: docs.filter((doc) => getDocKind(doc) === 'Setup guide').slice(0, 2),
  },
  {
    label: 'Hardware notes',
    description: 'Electronics-facing notes for boards, wiring, storage, and bench work.',
    preset: 'kind:hardware',
    docs: docs.filter((doc) => getDocKind(doc) === 'Hardware note').slice(0, 2),
  },
  {
    label: 'Protocol references',
    description: 'Wire-level notes, packet formats, and implementation details.',
    preset: 'kind:protocol',
    docs: docs.filter((doc) => getDocKind(doc) === 'Protocol reference').slice(0, 2),
  },
  {
    label: 'Site notes',
    description: 'Architecture, design language, and maintenance notes for this site.',
    preset: 'kind:site',
    docs: docs.filter((doc) => getDocKind(doc) === 'Site meta').slice(0, 2),
  },
].filter((path) => path.docs.length > 0);

const sectionBuckets = docs.reduce<
  Array<{
    section: string;
    description: string;
    items: typeof docs;
  }>
>((groups, doc) => {
  const sectionMeta = getDocSectionMeta(doc.data.section);
  const current = groups[groups.length - 1];

  if (!current || current.section !== sectionMeta.label) {
    groups.push({ section: sectionMeta.label, description: sectionMeta.description, items: [doc] });
    return groups;
  }

  current.items.push(doc);
  return groups;
}, []);

const tagCounts = docs.reduce<Map<string, { label: string; count: number }>>((map, doc) => {
  for (const tag of doc.data.tags ?? []) {
    const slug = toTagSlug(tag);
    const current = map.get(slug);
    map.set(slug, { label: tag, count: (current?.count ?? 0) + 1 });
  }
  return map;
}, new Map());

const popularTags = [...tagCounts.entries()]
  .sort((a, b) => b[1].count - a[1].count || a[1].label.localeCompare(b[1].label))
  .slice(0, 8)
  .map(([slug, info]) => ({ slug, label: info.label, count: info.count }));

const docKindCounts = docs.reduce<Map<string, number>>((map, doc) => {
  const kind = getDocKind(doc);
  map.set(kind, (map.get(kind) ?? 0) + 1);
  return map;
}, new Map());

const docKindFilters = [
  { label: 'All', value: 'all', count: docs.length },
  ...[...docKindCounts.entries()].sort((a, b) => a[0].localeCompare(b[0])).map(([label, count]) => ({ label, value: label, count })),
];

const cliEntries = docs.map((doc) => ({
  title: doc.data.title,
  url: `/docs/${doc.id}`,
  id: doc.id,
  section: getDocSectionMeta(doc.data.section).label,
  description: doc.data.description,
  tags: doc.data.tags ?? [],
  updated: toDateValue(doc),
  featured: Boolean(doc.data.featured),
}));

const cliManual = {
  stat: { name: 'stat', synopsis: 'stat', description: 'Show top-level index stats.', examples: ['stat'], seeAlso: ['help', 'ls', 'man'] },
  help: { name: 'help', synopsis: 'help [command]', description: 'Display command list or help.', examples: ['help', 'help ls'], seeAlso: ['man', 'ls', 'grep'] },
  ls: { name: 'ls', synopsis: 'ls [section]', description: 'List sections or docs in a section.', examples: ['ls', 'ls "Reference"'], seeAlso: ['cd', 'pwd', 'grep'] },
  cd: { name: 'cd', synopsis: 'cd <section> | cd /', description: 'Change virtual section context.', examples: ['cd "Site Meta"', 'cd /'], seeAlso: ['pwd', 'ls'] },
  grep: { name: 'grep', synopsis: 'grep <query>', description: 'Search title, description, section, and tags.', examples: ['grep terminal'], seeAlso: ['find', 'tag', 'ls'] },
  find: { name: 'find', synopsis: 'find <query>', description: 'Alias for grep.', examples: ['find setup'], seeAlso: ['grep', 'tag'] },
  tag: { name: 'tag', synopsis: 'tag <name>', description: 'List docs by tag match.', examples: ['tag tutorial'], seeAlso: ['grep', 'ls'] },
  open: { name: 'open', synopsis: 'open <doc-id|title>', description: 'Open a document page.', examples: ['open eduroam-on-the-rpi'], seeAlso: ['cat', 'man'] },
  man: { name: 'man', synopsis: 'man [command|topic]', description: 'Open manual pages.', examples: ['man', 'man ls'], seeAlso: ['help', 'cat', 'open'] },
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Documentation — Chips’nCode" description="Structured guides, reference notes, and practical technical manuals." />
  </head>
  <body>
    <Header />
    <main class="docs-index">
      {docs.length === 0 ? (
        <div class="panel panel--soft empty">
          <p class="empty-title">Documentation coming soon.</p>
          <p class="empty-sub">Publish docs entries with a <code>section</code> field to keep this page structured.</p>
        </div>
      ) : (
        <>
          <IndexHeader eyebrow="Documentation" title="Documentation" lede="Structured guides, reference notes, and practical technical manuals." terminalTitle="docs.index" />

          <section class="docs-search-row panel panel--soft" aria-labelledby="docs-search-heading">
            <div class="docs-search-row__head">
              <h2 id="docs-search-heading">Find a document</h2>
              <p>{docs.length} published notes across {sectionBuckets.length} sections.</p>
            </div>
            <label class="docs-search-field">
              <span>Search docs</span>
              <input type="search" data-docs-search placeholder="Search FT-857D, eduroam, pinout, protocol..." autocomplete="off" />
            </label>
            <div class="docs-inline-meta">
              <span><strong>Recommended reads:</strong> {usefulNow.map((doc, i) => <><a href={`/docs/${doc.id}`}>{doc.data.title}</a>{i < usefulNow.length - 1 ? ' · ' : ''}</>)}</span>
              <span><strong>Recently updated:</strong> {latestDocs.map((doc, i) => <><a href={`/docs/${doc.id}`}>{doc.data.title}</a>{i < latestDocs.length - 1 ? ' · ' : ''}</>)}</span>
              <span><strong>Popular tags:</strong> {popularTags.slice(0, 5).map((tag, i) => <><a href={`/tags/${tag.slug}`}>#{tag.label}</a>{i < Math.min(popularTags.length, 5) - 1 ? ' · ' : ''}</>)}</span>
            </div>
          </section>

          <section class="quick-paths" aria-labelledby="quick-paths-heading">
            <div class="section-heading">
              <h2 id="quick-paths-heading">Quick paths</h2>
              <p>Start from the kind of thing you need.</p>
            </div>
            <div class="quick-path-grid">
              {quickPaths.map((path) => (
                <button type="button" class="quick-path" data-docs-preset={path.preset} data-path-tone={path.preset}>
                  <h3>{path.label}</h3>
                  <p>{path.description}</p>
                  <small>{path.docs.map((doc) => doc.data.title).join(' · ')}</small>
                </button>
              ))}
            </div>
          </section>

          <section class="docs-directory" id="directory" aria-labelledby="directory-heading">
            <div class="docs-directory__head">
              <h2 id="directory-heading">Browse the library</h2>
              <p>Filter quickly, then scan compact rows.</p>
            </div>

            <div class="docs-filterbar" aria-label="Filter documentation directory">
              {docKindFilters.map((filter, index) => (
                <button class:list={[index === 0 && 'is-active']} type="button" data-doc-kind-filter={filter.value}>
                  {filter.label} <span>{filter.count}</span>
                </button>
              ))}
            </div>

            <p class="docs-result-count" data-docs-result-count>{docs.length} documents shown</p>

            <div class="docs-sections">
              {sectionBuckets.map((group) => (
                <section class="doc-section" aria-label={group.section} data-doc-section>
                  <header class="doc-section__head">
                    <div>
                      <h3>{group.section}</h3>
                      <p>{group.description}</p>
                    </div>
                    <span>{group.items.length} docs</span>
                  </header>

                  <div class="doc-rows">
                    {group.items.map((doc) => (
                      <a
                        class="doc-row"
                        href={`/docs/${doc.id}`}
                        data-doc-row
                        data-doc-kind={getDocKind(doc)}
                        data-doc-terms={`${doc.data.title} ${doc.data.description} ${getDocSectionMeta(doc.data.section).label} ${getDocKind(doc)} ${(doc.data.tags ?? []).join(' ')}`.toLowerCase()}
                      >
                        <span class="doc-row__title">{doc.data.title}</span>
                        <span class:list={['doc-row__kind', `doc-row__kind--${getDocKind(doc).toLowerCase().replace(/\s+/g, '-')}`]}>{getDocKind(doc)}</span>
                        <span class="doc-row__tags">{(doc.data.tags ?? []).slice(0, 2).map((t) => `#${t}`).join(' · ')}</span>
                      </a>
                    ))}
                  </div>
                </section>
              ))}
            </div>

            <p class="docs-empty-results" data-docs-empty-results hidden>
              No resources match those filters. Try clearing the filter or search by broader topic.
            </p>
          </section>
        </>
      )}
    </main>

    <Footer />

    <div class="edge-drawer-instance">
      <input id="docs-query-toggle" class="edge-drawer-toggle edge-drawer-toggle--query" type="checkbox" />
      <label for="docs-query-toggle" class="edge-drawer-tab" data-drawer-name="Docs Query" aria-label="Open docs query drawer">Docs Query</label>

      <div class="edge-drawer-overlay edge-drawer-overlay--query" data-edge-drawer="docs-query-toggle">
        <label for="docs-query-toggle" class="edge-drawer-backdrop" aria-label="Close docs query drawer"></label>
        <aside class="edge-drawer-panel edge-drawer-panel--query" role="dialog" aria-modal="true" aria-label="Docs query drawer">
          <label for="docs-query-toggle" class="edge-drawer-close edge-drawer-close--query">Close</label>
          <CliShell
            shellId="docs-cli"
            shellTitle="docs.query"
            initialCommand="stat"
            entries={cliEntries}
            commandManual={cliManual}
            statsLines={[
              { label: 'published_docs', value: docs.length },
              { label: 'sections', value: sectionBuckets.length },
              { label: 'tags_in_use', value: tagCounts.size },
              { label: 'featured_docs', value: docs.filter((doc) => doc.data.featured).length },
              { label: 'last_updated', value: formatDateStamp(latestDocUpdated) },
            ]}
            presets={['ls', 'cd "Platform Guides"', 'grep setup', 'tag tutorial', 'man ls']}
          />
        </aside>
      </div>
    </div>
  </body>
</html>

<script is:inline>
  (() => {
    const search = document.querySelector('[data-docs-search]');
    const rows = Array.from(document.querySelectorAll('[data-doc-row]'));
    const sections = Array.from(document.querySelectorAll('[data-doc-section]'));
    const filters = Array.from(document.querySelectorAll('[data-doc-kind-filter]'));
    const presets = Array.from(document.querySelectorAll('[data-docs-preset]'));
    const count = document.querySelector('[data-docs-result-count]');
    const empty = document.querySelector('[data-docs-empty-results]');
    const drawerToggle = document.getElementById('docs-query-toggle');
    let activeKind = 'all';

    if (!rows.length) return;

    const aliases = {
      'kind:reference': 'Reference',
      'kind:setup': 'Setup guide',
      'kind:hardware': 'Hardware note',
      'kind:protocol': 'Protocol reference',
      'kind:site': 'Site meta',
    };

    const setActiveFilter = (kind) => {
      activeKind = kind;
      filters.forEach((filter) => filter.classList.toggle('is-active', filter.getAttribute('data-doc-kind-filter') === kind));
    };

    const update = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      let shown = 0;

      rows.forEach((row) => {
        const terms = row.getAttribute('data-doc-terms') ?? '';
        const kind = row.getAttribute('data-doc-kind') ?? '';
        const kindMatch = activeKind === 'all' || activeKind === kind;
        const queryMatch = !query || terms.includes(query);
        const visible = kindMatch && queryMatch;
        row.hidden = !visible;
        if (visible) shown += 1;
      });

      sections.forEach((section) => {
        const visibleRows = section.querySelectorAll('[data-doc-row]:not([hidden])').length;
        section.hidden = visibleRows === 0;
      });

      if (count) count.textContent = `${shown} document${shown === 1 ? '' : 's'} shown`;
      if (empty) empty.hidden = shown !== 0;
    };

    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        setActiveFilter(filter.getAttribute('data-doc-kind-filter') || 'all');
        update();
      });
    });

    search?.addEventListener('input', update);

    const jumpToResults = () => {
      const libraryHeading = document.getElementById('directory-heading');
      libraryHeading?.scrollIntoView({ behavior: 'smooth', block: 'start' });

      const firstVisibleSection = sections.find((section) => !section.hidden);
      if (firstVisibleSection) {
        setTimeout(() => {
          firstVisibleSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 120);
      }
    };

    presets.forEach((preset) => {
      preset.addEventListener('click', () => {
        const target = aliases[preset.getAttribute('data-docs-preset') || ''] || 'all';
        setActiveFilter(target);
        if (search) search.value = '';
        update();
        jumpToResults();
      });
    });

    update();
  })();
</script>

<style>
  .docs-index { max-width: min(1180px, calc(100% - 2 * var(--space-5))); display: grid; gap: var(--space-5); }
  .empty { padding: var(--space-6); }
  .empty-title { margin: 0 0 0.4rem; font-weight: 700; color: var(--text); }
  .empty-sub { margin: 0; color: var(--text-2); max-width: 80ch; }

  .docs-search-row { display: grid; gap: 0.9rem; padding: 1rem 1.1rem; }
  .docs-search-row__head h2, .docs-search-row__head p { margin: 0; }
  .docs-search-row__head p { color: var(--text-2); font-size: 0.92rem; margin-top: 0.28rem; }
  .docs-search-field { display: grid; gap: 0.34rem; }
  .docs-search-field span {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .docs-search-field input {
    min-height: 52px;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border) 72%);
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface-raised) 96%, white 4%);
    color: var(--text);
    padding: 0.72rem 0.86rem;
    font-size: 1.02rem;
  }
  .docs-search-field input:focus {
    outline: 2px solid color-mix(in srgb, var(--accent) 34%, transparent 66%);
    outline-offset: 2px;
  }

  .docs-inline-meta { display: grid; gap: 0.24rem; font-size: 0.88rem; color: var(--text-2); }
  .docs-inline-meta a { color: var(--link); text-decoration: none; }

  .section-heading { display: grid; gap: 0.2rem; margin-bottom: 0.15rem; }
  .section-heading h2, .section-heading p { margin: 0; }
  .section-heading h2 { font-size: 1rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .section-heading p { color: var(--text-2); font-size: 0.9rem; }

  .quick-path-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.58rem; align-items: stretch; }
  .quick-path {
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 12px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--path-accent, var(--accent)) 12%, var(--surface-raised) 88%), var(--surface-raised));
    color: var(--text);
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.35rem;
    cursor: pointer;
    min-height: 0;
    width: 100%;
  }
  .quick-path h3, .quick-path p, .quick-path small { margin: 0; }
  .quick-path > * { width: 100%; }
  .quick-path h3 { font-size: 1rem; line-height: 1.2; font-weight: 780; text-align: left; color: color-mix(in srgb, var(--path-accent, var(--accent)) 62%, var(--text) 38%); }
  .quick-path p { color: var(--text-2); font-size: 0.88rem; line-height: 1.32; text-align: left; }
  .quick-path small { color: var(--muted); font-size: 0.8rem; line-height: 1.24; text-align: left; }
  .quick-path:hover {
    border-color: color-mix(in srgb, var(--path-accent, var(--accent)) 38%, var(--border) 62%);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--path-accent, var(--accent)) 22%, var(--surface-raised) 78%), var(--surface-raised));
  }
  .quick-path:hover h3 { color: var(--path-accent, var(--accent)); }
  .quick-path[data-path-tone="kind:reference"] { --path-accent: #14b8a6; }
  .quick-path[data-path-tone="kind:setup"] { --path-accent: #3b82f6; }
  .quick-path[data-path-tone="kind:hardware"] { --path-accent: #f97316; }
  .quick-path[data-path-tone="kind:protocol"] { --path-accent: #a855f7; }
  .quick-path[data-path-tone="kind:site"] { --path-accent: #22c55e; }
  .quick-path-grid .quick-path:last-child:nth-child(odd) { grid-column: 1 / -1; }

  .docs-directory { display: grid; gap: 0.8rem; }
  .docs-directory__head h2, .docs-directory__head p { margin: 0; }
  .docs-directory__head p { color: var(--text-2); margin-top: 0.25rem; }

  .docs-filterbar { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .docs-filterbar button { border: 1px solid var(--border); border-radius: 999px; background: var(--surface-raised); color: var(--text-2); padding: 0.34rem 0.72rem; cursor: pointer; }
  .docs-filterbar button.is-active, .docs-filterbar button:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 38%, var(--border) 62%); }

  .docs-result-count { margin: 0; color: var(--text-2); font-size: 0.9rem; }

  .doc-section { border-top: 1px solid var(--border); padding-top: 0.6rem; margin-top: 0.35rem; }
  .doc-section__head { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .doc-section__head h3, .doc-section__head p { margin: 0; }
  .doc-section__head p { color: var(--text-2); font-size: 0.9rem; margin-top: 0.22rem; }
  .doc-section__head > span { color: var(--muted); font-size: 0.85rem; }

  .doc-rows { margin-top: 0.5rem; }
  .doc-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(120px, 0.6fr) minmax(0, 1fr);
    gap: 0.8rem;
    text-decoration: none;
    color: inherit;
    padding: 0.6rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent 30%);
  }
  .doc-row:hover { background: color-mix(in srgb, var(--accent) 10%, transparent 90%); }
  .doc-row__title { font-weight: 700; line-height: 1.24; }
  .doc-row__kind { color: color-mix(in srgb, var(--accent) 44%, var(--text-2) 56%); font-size: 0.9rem; }
  .doc-row__kind--reference { color: #0f766e; }
  .doc-row__kind--setup-guide { color: #2563eb; }
  .doc-row__kind--hardware-note { color: #c2410c; }
  .doc-row__kind--protocol-reference { color: #7e22ce; }
  .doc-row__kind--site-meta { color: #15803d; }
  .doc-row__tags { color: var(--muted); font-size: 0.88rem; }

  .docs-empty-results { margin: 0.5rem 0 0; color: var(--text-2); }

  .edge-drawer-tab { opacity: 0.78; }
  .edge-drawer-tab:hover { opacity: 1; }

  @media (max-width: 860px) {
    .docs-index { max-width: calc(100% - 2 * var(--space-4)); }
    .quick-path-grid { grid-template-columns: 1fr; }
    .quick-path-grid .quick-path:last-child:nth-child(odd) { grid-column: auto; }
    .quick-path { min-height: 0; }
    .doc-row { grid-template-columns: 1fr; gap: 0.24rem; }
    .doc-row__kind, .doc-row__tags { font-size: 0.84rem; }
  }
</style>
