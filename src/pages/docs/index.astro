---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import { getDocSectionMeta } from '../../utils/docs';
import { toTagSlug } from '../../utils/tags';

const docs = (await getCollection('docs', ({ data }) => !data.draft)).sort((a, b) => {
  const aSection = getDocSectionMeta(a.data.section);
  const bSection = getDocSectionMeta(b.data.section);

  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1;
  }

  if (aSection.rank !== bSection.rank) {
    return aSection.rank - bSection.rank;
  }

  const orderCompare = (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER);
  if (orderCompare !== 0) return orderCompare;

  return a.data.title.localeCompare(b.data.title);
});

const leadDoc = docs[0] ?? null;
const shelfDocs = leadDoc ? docs.slice(1) : docs;

const docGroups = shelfDocs.reduce<
  Array<{
    section: string;
    items: typeof docs;
  }>
>((groups, doc) => {
  const section = getDocSectionMeta(doc.data.section).label;
  const currentGroup = groups[groups.length - 1];

  if (!currentGroup || currentGroup.section !== section) {
    groups.push({ section, items: [doc] });
    return groups;
  }

  currentGroup.items.push(doc);
  return groups;
}, []);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Documentation — Chips’nCode"
      description="Structured guides, technical documentation, and deep dives."
    />
  </head>
  <body>
    <Header />
    <main class="docs-index">
      <IndexHeader
        eyebrow="Documentation"
        title="Documentation"
        lede="Structured guides, reference notes, and longer-lived technical manuals. This page should read more like a library than a pile."
        terminalTitle="docs.index"
        statusLines={[
          { label: 'published_docs', value: docs.length },
          { label: 'sections', value: [...new Set(docs.map((doc) => doc.data.section))].length },
          { label: 'featured_docs', value: docs.filter((doc) => doc.data.featured).length },
        ]}
      />

      {docs.length === 0 ? (
        <div class="panel panel--soft empty">
          <p class="empty-title">Documentation coming soon.</p>
          <p class="empty-sub">
            Publish docs entries with a <code>section</code> and optional <code>order</code> field to keep this page structured as the collection grows.
          </p>
        </div>
      ) : (
        <>
          {leadDoc ? (
            <section class="doc-leadBand" aria-labelledby="docs-lead-heading">
              <div class="section-head">
                <div>
                  <p class="eyebrow eyebrow--accent">Reference Shelf</p>
                  <h2 id="docs-lead-heading">Lead document</h2>
                </div>
              </div>

              <article class="doc-lead panel">
                <div class="doc-lead__copy">
                  <div class="doc-lead__meta">
                    <span class="pill">{leadDoc.data.featured ? 'Featured guide' : 'Guide'}</span>
                    <span class="pill pill--soft">{getDocSectionMeta(leadDoc.data.section).label}</span>
                    {leadDoc.data.tags?.slice(0, 2).map((tag) => (
                      <a class="pill pill--link" href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>
                    ))}
                  </div>

                  <h3 class="doc-lead__title">
                    <a href={`/docs/${leadDoc.id}`}>{leadDoc.data.title}</a>
                  </h3>

                  <p class="doc-lead__desc">{leadDoc.data.description}</p>
                </div>

                <div class="doc-lead__aside">
                  <p class="doc-lead__label">Section</p>
                  <p class="doc-lead__value">{getDocSectionMeta(leadDoc.data.section).label}</p>
                  <p class="doc-lead__note">{getDocSectionMeta(leadDoc.data.section).description}</p>
                </div>
              </article>
            </section>
          ) : null}

          <div class="doc-groups">
            {docGroups.map((group) => (
              <section class="doc-group" aria-label={group.section}>
                <div class="doc-group__header">
                  <div class="doc-group__intro">
                    <h2 class="doc-group__title">{group.section}</h2>
                    <p class="doc-group__desc">{getDocSectionMeta(group.section).description}</p>
                  </div>
                  <span class="pill">{group.items.length} item{group.items.length === 1 ? '' : 's'}</span>
                </div>

                <div class="doc-shelf">
                  {group.items.map((doc, index) => (
                    <article
                      class:list={['doc-card', index === 0 && group.items.length > 1 && 'doc-card--wide']}
                    >
                      <div class="doc-card__meta">
                        {doc.data.featured ? <span class="pill pill--coral">Featured</span> : <span class="pill">Doc</span>}
                        {doc.data.tags?.slice(0, 2).map((tag) => (
                          <a class="pill pill--link" href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>
                        ))}
                      </div>
                      <h3 class="doc-card__title">
                        <a href={`/docs/${doc.id}`}>{doc.data.title}</a>
                      </h3>
                      <p class="doc-card__desc">{doc.data.description}</p>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>
  .docs-index {
    max-width: min(1280px, calc(100% - 2 * var(--space-5)));
  }

  .empty {
    padding: var(--space-6);
  }

  .empty-title {
    margin: 0 0 0.4rem;
    font-weight: 700;
    color: var(--text);
  }

  .empty-sub {
    margin: 0;
    color: var(--text-2);
    max-width: 80ch;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .section-head h2 {
    margin: 0;
  }

  .eyebrow--accent {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral);
  }

  .doc-leadBand {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .doc-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    gap: var(--space-5);
    background:
      radial-gradient(760px 220px at top right, rgba(37, 99, 235, 0.08), transparent 68%),
      radial-gradient(480px 180px at bottom left, rgba(20, 184, 166, 0.06), transparent 72%),
      var(--surface-raised);
  }

  .doc-lead__copy,
  .doc-lead__aside {
    min-width: 0;
  }

  .doc-lead__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .doc-lead__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill--soft {
    background: var(--surface-glass);
  }

  .pill--link {
    text-decoration: none;
    transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
  }

  .pill--link:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border) 58%);
    background: color-mix(in srgb, var(--surface-raised) 66%, var(--accent) 34%);
  }

  .doc-lead__title,
  .doc-lead__desc {
    margin: 0;
  }

  .doc-lead__title {
    font-size: clamp(2rem, 3vw, 3.3rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .doc-lead__title a,
  .doc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .doc-lead__title a:hover,
  .doc-card:hover .doc-card__title a {
    color: var(--accent);
  }

  .doc-lead__desc {
    max-width: 46ch;
    color: var(--text-2);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
  }

  .doc-lead__aside {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--surface-glass);
    border: 1px solid var(--border);
  }

  .doc-lead__label,
  .doc-lead__value,
  .doc-lead__note {
    margin: 0;
  }

  .doc-lead__label {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .doc-lead__value {
    font-weight: 700;
    font-size: 1.12rem;
  }

  .doc-lead__note {
    color: var(--text-2);
    font-size: 0.96rem;
  }

  .doc-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .doc-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .doc-group__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-3);
  }

  .doc-group__intro {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .doc-group__title,
  .doc-group__desc {
    margin: 0;
  }

  .doc-group__desc {
    max-width: 72ch;
    color: var(--text-2);
  }

  .doc-shelf {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    align-items: start;
  }

  .doc-card {
    display: flex;
    flex-direction: column;
    align-self: start;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(460px 120px at top right, rgba(37, 99, 235, 0.08), transparent 72%),
      radial-gradient(360px 110px at top left, rgba(45, 255, 178, 0.08), transparent 74%),
      var(--surface-raised);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease;
  }

  .doc-card--wide {
    grid-column: span 2;
  }

  .doc-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--accent) 24%, var(--border) 76%);
  }

  .doc-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .doc-card__title,
  .doc-card__desc {
    margin: 0;
  }

  .doc-card__title {
    font-size: 1.25rem;
    line-height: 1.16;
    text-wrap: balance;
  }

  .doc-card__desc {
    color: var(--text-2);
  }

  @media (max-width: 960px) {
    .doc-lead {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 780px) {
    .docs-index {
      max-width: calc(100% - 2 * var(--space-4));
    }

    .doc-card--wide {
      grid-column: auto;
    }
  }
</style>
