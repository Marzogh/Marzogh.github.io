---
import { getCollection, getEntry, render } from 'astro:content';
import DocsPost from '../../layouts/DocsPost.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing route parameter: slug');

const entry = await getEntry('docs', slug);
if (!entry) throw new Error(`Doc entry not found: ${slug}`);

const { Content, headings } = await render(entry);
---

<DocsPost {...entry.data} slug={slug} headings={headings}>
  <Content />
</DocsPost>
