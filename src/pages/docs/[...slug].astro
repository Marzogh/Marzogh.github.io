---
import { getCollection, getEntry, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { toTagSlug } from '../../utils/tags';

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing route parameter: slug');
}

const entry = await getEntry('docs', slug);

if (!entry) {
  throw new Error(`Doc entry not found: ${slug}`);
}

const { Content } = await render(entry);
const headerStyle = entry.data.headerStyle ?? 'plain';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={entry.data.title} description={entry.data.description} />
  </head>
  <body>
    <Header />
    <main class:list={['docs-page', slug === 'zenit-12xp' && 'docs-page--zenit']}>
      <article class:list={['docs-entry', slug === 'zenit-12xp' && 'docs-entry--zenit']}>
        <a href="/docs" class="docs-back">
          ← Back to Docs
        </a>

        <header class:list={['docs-hero', headerStyle === 'panel' && 'panel', headerStyle === 'plain' && 'docs-hero--plain', headerStyle === 'tool' && 'docs-hero--tool']}>
          <div class="docs-hero__eyebrow">
            {entry.data.section ? <span class="pill">{entry.data.section}</span> : null}
            {entry.data.featured ? <span class="pill pill--coral">Featured</span> : null}
          </div>

          <h1 class="docs-title">{entry.data.title}</h1>

          {entry.data.description ? (
            <p class="docs-description">{entry.data.description}</p>
          ) : null}

          <div class="docs-meta">
            {entry.data.pubDate ? (
              <span class="docs-meta__item">
                Published <FormattedDate date={entry.data.pubDate} />
              </span>
            ) : null}
            {entry.data.updatedDate ? (
              <span class="docs-meta__item">
                Updated <FormattedDate date={entry.data.updatedDate} />
              </span>
            ) : null}
          </div>

          {entry.data.tags?.length ? (
            <div class="docs-tags" aria-label="Document tags">
              {entry.data.tags.map((tag) => (
                <a class="tagLink" href={`/tags/${toTagSlug(tag)}`}>#{tag}</a>
              ))}
            </div>
          ) : null}
        </header>

        <div class="docs-body">
          <div class="prose prose--docs">
            <Content />
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .docs-page {
    max-width: min(1360px, calc(100% - 2 * var(--space-5)));
  }

  .docs-page--zenit {
    position: relative;
    isolation: isolate;
  }

  .docs-page--zenit::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(22, 117, 224, 0.22), rgba(12, 86, 190, 0.18)),
      url('/docs/zenit-12xp/blueprints/zenit-blueprint-exploded-p6.webp') center top / cover no-repeat,
      #cfe1f8;
    filter: saturate(118%) contrast(104%);
  }

  .docs-page--zenit::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(246, 250, 255, 0.9) 0%,
        rgba(247, 251, 255, 0.9) 26%,
        rgba(247, 251, 255, 0.88) 58%,
        rgba(246, 250, 255, 0.9) 100%
      );
  }

  .docs-page--zenit > * {
    position: relative;
    z-index: 1;
  }

  :global(html.dark) .docs-page--zenit::after,
  :global(html[data-theme='dark']) .docs-page--zenit::after,
  :global(body.dark) .docs-page--zenit::after {
    background:
      linear-gradient(
        180deg,
        rgba(5, 11, 22, 0.78) 0%,
        rgba(8, 15, 30, 0.82) 45%,
        rgba(10, 18, 34, 0.86) 100%
      ),
      radial-gradient(circle at 24% 14%, rgba(255, 255, 255, 0.16), transparent 48%),
      radial-gradient(circle at 78% 28%, rgba(125, 211, 252, 0.13), transparent 52%);
    backdrop-filter: blur(6px) saturate(98%);
  }

  .docs-entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .docs-entry--zenit {
    gap: 0.65rem;
  }

  .docs-entry--zenit .docs-back {
    margin-top: 0;
  }

  .docs-entry--zenit .docs-hero {
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 0 0.45rem !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .docs-entry--zenit .docs-title {
    display: block !important;
    color: #0f172a !important;
    -webkit-text-fill-color: #0f172a !important;
    opacity: 1 !important;
    visibility: visible !important;
    text-shadow: none !important;
  }

  .docs-entry--zenit .docs-description,
  .docs-entry--zenit .docs-meta,
  .docs-entry--zenit .docs-tags,
  .docs-entry--zenit .docs-hero__eyebrow {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .docs-back {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .docs-back:hover {
    color: var(--accent);
  }

  .docs-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    background:
      radial-gradient(700px 220px at top right, rgba(37, 99, 235, 0.08), transparent 68%),
      radial-gradient(540px 180px at top left, rgba(251, 113, 133, 0.07), transparent 72%),
      #fff;
  }

  .docs-hero--plain {
    position: relative;
    padding: 0 0 var(--space-3);
    margin: 0;
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .docs-hero--tool {
    position: relative;
    gap: 0.7rem;
    padding: 0 0 var(--space-2);
    margin: 0;
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .docs-hero--tool::after {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 0.4rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 24%, transparent 76%), color-mix(in srgb, var(--border) 72%, transparent 28%));
  }

  .docs-hero--plain::after {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 24%, transparent 76%), color-mix(in srgb, var(--border) 72%, transparent 28%));
  }

  .docs-hero__eyebrow,
  .docs-tags,
  .docs-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .docs-hero__eyebrow {
    gap: 8px;
  }

  .docs-title {
    margin: 0;
  }

  .docs-hero--plain .docs-title {
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .docs-hero--tool .docs-title {
    max-width: 16ch;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .docs-description {
    margin: 0;
    max-width: 68ch;
    color: var(--text-2);
  }

  .docs-hero--plain .docs-description {
    font-size: clamp(1rem, 1.2vw, 1.14rem);
  }

  .docs-hero--tool .docs-description {
    max-width: 62ch;
    font-size: 1rem;
  }

  .docs-hero--tool .docs-tags {
    display: none;
  }

  .docs-meta {
    gap: 0.85rem;
  }

  .docs-meta__item {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .tagLink {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
  }

  .tagLink:hover {
    color: var(--accent);
  }

  .docs-body {
    padding-top: var(--space-2);
  }

  .prose--docs {
    color: var(--text-2);
  }

  .prose--docs::before {
    content: "";
    display: block;
    width: 84px;
    height: 4px;
    margin-bottom: var(--space-5);
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--coral) 70%, #fff 30%));
  }

  .prose--docs :global(h2) {
    margin-top: 2.2rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--border);
  }

  .prose--docs :global(h2:first-of-type) {
    margin-top: 0;
  }

  .prose--docs :global(h3) {
    margin-top: 1.5rem;
  }

  .prose--docs :global(ul),
  .prose--docs :global(ol) {
    margin-bottom: 1.35rem;
  }

  .prose--docs :global(li + li) {
    margin-top: 0.35rem;
  }

  .prose--docs :global(table) {
    display: table;
    width: auto;
    max-width: 100%;
    table-layout: auto;
    margin: 1.4rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .prose--docs :global(th),
  .prose--docs :global(td) {
    min-width: 0;
  }

  .prose--docs :global(th) {
    background: var(--surface-accent-soft);
  }

  .prose--docs :global(.callout) {
    margin: 1.4rem 0;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface-raised);
    box-shadow: var(--shadow-sm);
  }

  .prose--docs :global(.callout > :last-child) {
    margin-bottom: 0;
  }

  .prose--docs :global(.callout--note) {
    background: var(--surface-accent-soft);
    border-left: 4px solid var(--accent);
  }

  .prose--docs :global(.callout--warm) {
    background: var(--surface-coral-soft);
    border-left: 4px solid var(--coral);
  }

  .prose--docs :global(.doc-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.4rem 0;
  }

  .prose--docs :global(.doc-card) {
    padding: 1rem 1.05rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-sm);
  }

  .prose--docs :global(.doc-card h3),
  .prose--docs :global(.doc-card h4),
  .prose--docs :global(.doc-card p:last-child) {
    margin-bottom: 0;
  }

  .prose--docs :global(.compact-list) {
    margin: 0;
    padding-left: 1.1rem;
  }

  @media (max-width: 720px) {
    .docs-page {
      max-width: calc(100% - 2 * var(--space-4));
    }

    .docs-title {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .prose--docs :global(.doc-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
