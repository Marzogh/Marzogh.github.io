---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const sessions = (await getCollection('astrophotography', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.sessionDate?.valueOf() ?? 0) - (a.data.sessionDate?.valueOf() ?? 0)
);

function pickThumb(data: any) {
  // Prefer a dedicated thumbnail if your collection schema provides one.
  // Fall back to common cover fields (heroImage/coverImage) if present.
  return data.thumbnail ?? data.thumb ?? data.cover ?? data.coverImage ?? data.heroImage ?? data.image ?? null;
}

function formatSessionDate(d: any) {
  if (!d) return null;
  const date = d instanceof Date ? d : new Date(d);
  if (Number.isNaN(date.valueOf())) return null;
  return date.toLocaleDateString('en-AU', { year: 'numeric', month: 'short', day: '2-digit' });
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Astrophotography — Chips’nCode"
      description="Imaging sessions, gear notes, processing workflows, and astrophotography experiments."
    />
  </head>
  <body class="theme-photo">
    <Header />

    <main>
      <header class="page-header">
        <h1 class="page-title">Astrophotography</h1>
        <p class="page-lede">
          Sessions, targets, gear configurations, calibration details, and processing pipelines — written so future-me can
          reproduce the results.
        </p>
      </header>

      {sessions.length === 0 ? (
        <div class="panel panel--soft empty">
          <p class="empty-title">First light soon ✨</p>
          <p class="empty-sub">
            When you add a session, give it a <code>thumbnail</code> (preferred) or <code>heroImage</code> in the frontmatter and it’ll
            show up here automatically.
          </p>
        </div>
      ) : (
        <section class="grid" aria-label="Astrophotography sessions">
          {sessions.map((session) => {
            const thumb = pickThumb(session.data);
            const dateLabel = formatSessionDate(session.data.sessionDate);

            return (
              <a href={`/astrophotography/${session.id}`} class="card" aria-label={`Open session: ${session.data.title}`}>
                <div class="thumb" aria-hidden="true">
                  {thumb ? (
                    typeof thumb === 'string' ? (
                      <img src={thumb} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <Image
                        src={thumb}
                        alt=""
                        widths={[480, 720, 960]}
                        sizes="(max-width: 520px) 100vw, (max-width: 920px) 50vw, 33vw"
                      />
                    )
                  ) : (
                    <div class="thumb-placeholder">
                      <div class="stars" />
                      <div class="thumb-label">No thumbnail yet</div>
                    </div>
                  )}
                </div>

                <div class="card-body">
                  <h2 class="card-title">{session.data.title}</h2>

                  <div class="card-meta">
                    {session.data.target ? (
                      <span class="pill">🎯 {session.data.target}</span>
                    ) : (
                      <span class="pill">📷 Session</span>
                    )}
                    {dateLabel ? <span class="pill">🗓 {dateLabel}</span> : null}
                  </div>

                  {session.data.description ? <p class="card-desc">{session.data.description}</p> : null}
                </div>
              </a>
            );
          })}
        </section>
      )}
    </main>

    <Footer />
  </body>
</html>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .page-title {
    margin: 0;
  }

  .page-lede {
    margin: 0;
    max-width: 75ch;
    color: var(--text-2);
  }

  .empty {
    padding: var(--space-6);
  }

  .empty-title {
    margin: 0 0 0.4rem 0;
    font-weight: 700;
    color: var(--text);
  }

  .empty-sub {
    margin: 0;
    color: var(--text-2);
    max-width: 80ch;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-5);
  }

  /* Responsive card span: 12 → 6 → 4 columns */
  .card {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(11, 16, 32, 0.92), rgba(7, 10, 18, 0.98));
    box-shadow: var(--shadow-sm);
    transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--accent) 25%, var(--border) 75%);
  }

  .thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    overflow: hidden;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }

  .thumb-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-5);
    background: radial-gradient(900px 260px at 25% 25%, rgba(79, 70, 229, 0.18), transparent 55%),
      radial-gradient(700px 240px at 75% 55%, rgba(34, 197, 94, 0.10), transparent 55%),
      #0b1020;
    color: rgba(229, 231, 235, 0.92);
  }

  .stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(255,255,255,0.55) 1px, transparent 2px),
      radial-gradient(circle at 75% 35%, rgba(255,255,255,0.45) 1px, transparent 2px),
      radial-gradient(circle at 55% 70%, rgba(255,255,255,0.35) 1px, transparent 2px),
      radial-gradient(circle at 35% 80%, rgba(255,255,255,0.35) 1px, transparent 2px);
    background-size: 240px 160px;
    opacity: 0.55;
  }

  .thumb-label {
    position: relative;
    z-index: 1;
    font-size: 0.95rem;
    border: 1px solid rgba(229, 231, 235, 0.22);
    background: rgba(11, 16, 32, 0.35);
    padding: 10px 12px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
  }

  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.22;
    color: var(--text);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .card-desc {
    margin: 0;
    color: var(--text-2);
  }

  @media (min-width: 740px) {
    .card {
      grid-column: span 6;
    }
  }

  @media (min-width: 1040px) {
    .card {
      grid-column: span 4;
    }
  }
</style>
