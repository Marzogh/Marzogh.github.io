---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const sessions = await getCollection('astrophotography', ({ data }) => !data.draft);

  return sessions.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing route parameter: slug');
}

const entry = await getEntry('astrophotography', slug);

if (!entry) {
  throw new Error(`Astrophotography entry not found: ${slug}`);
}

const { Content } = await render(entry);
const hero = entry.data.image ?? entry.data.gallery?.[0] ?? null;
const gallery = entry.data.gallery ?? [];
const hasGallery = gallery.length > 1;
const isTransitSession = slug === 'iss-over-the-moon';
const headerStyle = entry.data.headerStyle ?? 'panel';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={entry.data.title} description={entry.data.description} />
  </head>
  <body class="theme-photo">
    <Header />

    <main class="astro-page">
      <article class="astro-session">
        <div class="astro-back">
          <a href="/astrophotography" class="astro-back-link">
            ← Back to Astrophotography
          </a>
        </div>

        <header class:list={['astro-hero', headerStyle === 'panel' && 'panel', headerStyle === 'plain' && 'astro-hero--plain']}>
          {headerStyle === 'panel' ? (
            <div class="astro-hero__visual">
              {hero ? (
                <Image
                  class="astro-hero__image"
                  src={hero}
                  alt={entry.data.title}
                  widths={[720, 1080, 1440]}
                  sizes="(max-width: 960px) 100vw, 58vw"
                />
              ) : (
                <div class="astro-hero__placeholder">No lead image yet</div>
              )}
            </div>
          ) : null}

          <div class="astro-hero__meta">
            <div class="astro-kickers">
              <span class="pill">Astrophotography</span>
              {entry.data.target ? <span class="pill pill--coral">{entry.data.target}</span> : null}
            </div>

            <h1 class="astro-title">{entry.data.title}</h1>
            <p class="astro-description">{entry.data.description}</p>

            <div class="astro-meta-grid">
              {entry.data.sessionDate ? (
                <div class="astro-meta-card">
                  <div class="astro-meta-card__label">Session Date</div>
                  <div class="astro-meta-card__value"><FormattedDate date={entry.data.sessionDate} /></div>
                </div>
              ) : null}
              {entry.data.location ? (
                <div class="astro-meta-card">
                  <div class="astro-meta-card__label">Location</div>
                  <div class="astro-meta-card__value">{entry.data.location}</div>
                </div>
              ) : null}
              {entry.data.camera ? (
                <div class="astro-meta-card">
                  <div class="astro-meta-card__label">Camera</div>
                  <div class="astro-meta-card__value">{entry.data.camera}</div>
                </div>
              ) : null}
              {entry.data.lensOrTelescope ? (
                <div class="astro-meta-card">
                  <div class="astro-meta-card__label">Lens / Scope</div>
                  <div class="astro-meta-card__value">{entry.data.lensOrTelescope}</div>
                </div>
              ) : null}
              {entry.data.mount ? (
                <div class="astro-meta-card">
                  <div class="astro-meta-card__label">Support</div>
                  <div class="astro-meta-card__value">{entry.data.mount}</div>
                </div>
              ) : null}
              {typeof entry.data.totalIntegrationMinutes === 'number' ? (
                <div class="astro-meta-card">
                  <div class="astro-meta-card__label">Integration</div>
                  <div class="astro-meta-card__value">{entry.data.totalIntegrationMinutes} min</div>
                </div>
              ) : null}
            </div>
          </div>
        </header>

        {headerStyle === 'plain' && hero ? (
          <figure class="astro-hero-media">
            <Image
              class="astro-hero__image"
              src={hero}
              alt={entry.data.title}
              widths={[720, 1080, 1440]}
              sizes="(max-width: 960px) 100vw, 72vw"
            />
          </figure>
        ) : null}

        {hasGallery ? (
          <section class="astro-gallery panel panel--soft" aria-label="Session gallery">
            <div class="astro-gallery__head">
              <h2>{isTransitSession ? 'Transit Sequence' : 'Gallery'}</h2>
              <p>{isTransitSession ? 'The keeper frames from the crossing.' : 'Selected frames from the session.'}</p>
            </div>
            <div class="astro-gallery__grid">
              {gallery.map((image, index) => (
                <figure class={`astro-gallery__item ${index === 0 ? 'astro-gallery__item--lead' : ''}`}>
                  <Image
                    src={image}
                    alt={`${entry.data.title} frame ${index + 1}`}
                    widths={[520, 900, 1200]}
                    sizes={index === 0 ? '(max-width: 960px) 100vw, 52vw' : '(max-width: 960px) 100vw, 26vw'}
                  />
                </figure>
              ))}
            </div>
          </section>
        ) : null}

        <section class="astro-content">
          <div class="astro-content__main panel panel--soft">
            <div class="prose astro-prose">
              <Content />
            </div>
          </div>

          <aside class="astro-side panel">
            <div class="astro-side__section">
              <h2 class="astro-side__title">Capture Stack</h2>
              <dl class="astro-facts">
                {entry.data.camera ? (
                  <>
                    <dt>Camera</dt>
                    <dd>{entry.data.camera}</dd>
                  </>
                ) : null}
                {entry.data.lensOrTelescope ? (
                  <>
                    <dt>Lens / Telescope</dt>
                    <dd>{entry.data.lensOrTelescope}</dd>
                  </>
                ) : null}
                {entry.data.mount ? (
                  <>
                    <dt>Support</dt>
                    <dd>{entry.data.mount}</dd>
                  </>
                ) : null}
                {entry.data.location ? (
                  <>
                    <dt>Location</dt>
                    <dd>{entry.data.location}</dd>
                  </>
                ) : null}
              </dl>
            </div>

            {entry.data.processing?.length ? (
              <div class="astro-side__section">
                <h2 class="astro-side__title">Processing / Method</h2>
                <div class="astro-process">
                  {entry.data.processing.map((step) => (
                    <div class="astro-process__step">{step}</div>
                  ))}
                </div>
              </div>
            ) : null}

            {entry.data.filters?.length ? (
              <div class="astro-side__section">
                <h2 class="astro-side__title">Filters</h2>
                <div class="astro-tags">
                  {entry.data.filters.map((filter) => (
                    <span class="pill">{filter}</span>
                  ))}
                </div>
              </div>
            ) : null}
          </aside>
        </section>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .astro-page {
    max-width: min(1260px, calc(100% - 2 * var(--space-5)));
  }

  .astro-session {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .astro-back-link {
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--muted);
  }

  .astro-back-link:hover {
    color: var(--accent);
  }

  .astro-hero {
    min-width: 0;
  }

  .astro-hero.panel {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.9fr);
    gap: var(--space-5);
    align-items: stretch;
    background:
      radial-gradient(900px 260px at 15% 0%, rgba(45, 255, 178, 0.08), transparent 70%),
      radial-gradient(700px 240px at 85% 10%, rgba(96, 165, 250, 0.10), transparent 72%),
      linear-gradient(180deg, rgba(10, 14, 26, 0.92), rgba(7, 10, 18, 0.96));
  }

  .astro-hero--plain {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0 0 var(--space-4);
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .astro-hero--plain::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--leaf) 26%, transparent 74%),
      color-mix(in srgb, var(--accent) 24%, transparent 76%),
      color-mix(in srgb, var(--border) 72%, transparent 28%)
    );
  }

  .astro-hero__visual {
    min-height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(229, 231, 235, 0.18);
    background: #050814;
    box-shadow: var(--shadow-md);
  }

  .astro-hero__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .astro-hero-media {
    margin: 0;
    max-width: min(980px, 100%);
    margin-left: auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(229, 231, 235, 0.18);
    background: #050814;
    box-shadow: var(--shadow-md);
  }

  .astro-hero__placeholder {
    display: grid;
    place-items: center;
    min-height: 420px;
    color: rgba(231, 236, 245, 0.85);
    background: radial-gradient(circle at top, rgba(77, 101, 169, 0.22), transparent 50%), #050814;
  }

  .astro-hero__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .astro-kickers,
  .astro-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .astro-title,
  .astro-description {
    margin: 0;
  }

  .astro-title {
    font-size: clamp(2.4rem, 4vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .astro-description {
    max-width: 32ch;
    font-size: 1.05rem;
    color: var(--text-2);
  }

  .astro-hero--plain .astro-description {
    max-width: 42ch;
    font-size: clamp(1rem, 1.15vw, 1.1rem);
  }

  .astro-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .astro-meta-card {
    padding: 0.95rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
  }

  .astro-meta-card__label {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }

  .astro-meta-card__value {
    color: var(--text);
    font-weight: 700;
    line-height: 1.35;
  }

  .astro-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .astro-gallery__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: end;
  }

  .astro-gallery__head h2,
  .astro-gallery__head p {
    margin: 0;
  }

  .astro-gallery__head p {
    color: var(--muted);
  }

  .astro-gallery__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 0.85fr));
    gap: var(--space-4);
  }

  .astro-gallery__item {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(229, 231, 235, 0.18);
    background: #050814;
  }

  .astro-gallery__item :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .astro-gallery__item--lead {
    grid-row: span 2;
  }

  .astro-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-5);
    align-items: start;
  }

  .astro-side {
    position: sticky;
    top: 92px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    background:
      linear-gradient(180deg, rgba(9, 14, 28, 0.95), rgba(7, 10, 18, 0.98));
  }

  .astro-side__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .astro-side__title {
    margin: 0;
    font-size: 1.02rem;
  }

  .astro-facts {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .astro-facts dt {
    margin: 0 0 0.2rem 0;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .astro-facts dd {
    margin: 0;
    color: var(--text);
    font-weight: 700;
  }

  .astro-process {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .astro-process__step {
    padding: 0.85rem 0.9rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-2);
  }

  .astro-prose {
    max-width: 72ch;
  }

  .astro-prose :global(img) {
    margin: 1.6rem 0;
    box-shadow: var(--shadow-md);
  }

  .astro-prose :global(.astro-split) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: start;
    margin: 1.8rem 0;
  }

  .astro-prose :global(.astro-split > *) {
    min-width: 0;
  }

  .astro-prose :global(.astro-note) {
    padding: 1rem 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(229, 231, 235, 0.18);
    background: rgba(8, 15, 32, 0.62);
    color: rgba(231, 236, 245, 0.92);
  }

  .astro-prose :global(.astro-note h3),
  .astro-prose :global(.astro-note p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 980px) {
    .astro-page {
      max-width: calc(100% - 2 * var(--space-4));
    }

    .astro-hero.panel,
    .astro-content,
    .astro-gallery__grid,
    .astro-prose :global(.astro-split) {
      grid-template-columns: 1fr;
    }

    .astro-gallery__item--lead {
      grid-row: auto;
    }

    .astro-side {
      position: static;
    }
  }
</style>
