---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import { toTagSlug } from '../../utils/tags';

const education = (await getCollection('education', ({ data }) => !data.draft && data.showInIndex !== false)).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER) ||
    (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);
const educationSubjects = [...new Set(education.map((item) => item.data.subject).filter(Boolean))];

const featuredEducation = education.filter((item) => item.data.featured);
const leadItem = featuredEducation[0] ?? education[0] ?? null;
const shelfItems = education.filter((item) => item.id !== leadItem?.id);
const supportItems = shelfItems.slice(0, 2);
const archiveItems = shelfItems.slice(2);
const availableTagSlugs = new Set(
  education.flatMap((item) => (Array.isArray(item.data.tags) ? item.data.tags : [])).map((tag) => toTagSlug(tag))
);

function pickThumb(data: any) {
  return data.thumbnail ?? data.thumb ?? data.cover ?? data.coverImage ?? data.heroImage ?? data.image ?? null;
}

function formatTaxonomyLabel(value?: string | null) {
  if (!value) return null;
  return value
    .split('-')
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
}

function getTagHref(value?: string | null) {
  if (!value) return null;
  const slug = toTagSlug(value);
  return availableTagSlugs.has(slug) ? `/tags/${slug}` : null;
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Education — Chips’nCode"
      description="Teaching resources, lesson structures, curriculum design, and educational experiments."
    />
  </head>
  <body class="theme-edu">
    <Header />

    <main class="education-index">
      <IndexHeader
        eyebrow="Education"
        title="Education"
        lede="Teaching resources, lesson structures, curriculum design, and classroom experiments — written clearly, with just enough personality."
        terminalTitle="education.index"
        statusLines={[
          { label: 'resources', value: education.length },
          { label: 'featured_items', value: education.filter((item) => item.data.featured).length },
          { label: 'subjects', value: educationSubjects.length },
        ]}
      />

      {education.length === 0 ? (
        <div class="panel panel--soft empty">
          <p class="empty-title">Education resources coming soon.</p>
          <p class="empty-sub">
            Add entries to your <code>education</code> collection and they’ll appear here automatically.
          </p>
        </div>
      ) : (
        <>
          {leadItem ? (
            <section class="edu-featureBand" aria-labelledby="education-featured-heading">
              <div class="section-head">
                <div>
                  <p class="eyebrow eyebrow--accent">Teaching Shelf</p>
                  <h2 id="education-featured-heading">Featured resource</h2>
                </div>
              </div>

              <div class="edu-featureBand__grid">
                <article class:list={['edu-lead panel', !pickThumb(leadItem.data) && 'edu-lead--textOnly']}>
                  {pickThumb(leadItem.data) ? (
                    <a class="edu-lead__media" href={`/education/${leadItem.id}`} aria-label={`Open education resource: ${leadItem.data.title}`}>
                      <img
                        src={typeof pickThumb(leadItem.data) === 'string' ? pickThumb(leadItem.data) : pickThumb(leadItem.data).src ?? pickThumb(leadItem.data)}
                        alt=""
                        loading="eager"
                        decoding="async"
                      />
                    </a>
                  ) : null}

                  <div class="edu-lead__copy">
                    <div class="edu-lead__meta">
                      <span class="pill">{leadItem.data.featured ? 'Lead resource' : 'Latest resource'}</span>
                      {leadItem.data.subject ? (
                        getTagHref(leadItem.data.subject) ? (
                          <a class="pill pill--soft pill--link" href={getTagHref(leadItem.data.subject)!}>
                            {formatTaxonomyLabel(leadItem.data.subject)}
                          </a>
                        ) : (
                          <span class="pill pill--soft">{formatTaxonomyLabel(leadItem.data.subject)}</span>
                        )
                      ) : null}
                      {leadItem.data.level ? (
                        getTagHref(leadItem.data.level) ? (
                          <a class="pill pill--link" href={getTagHref(leadItem.data.level)!}>
                            {formatTaxonomyLabel(leadItem.data.level)}
                          </a>
                        ) : (
                          <span class="pill">{formatTaxonomyLabel(leadItem.data.level)}</span>
                        )
                      ) : null}
                    </div>

                    <h3 class="edu-lead__title">
                      <a href={`/education/${leadItem.id}`}>{leadItem.data.title}</a>
                    </h3>

                    {leadItem.data.description ? <p class="edu-lead__desc">{leadItem.data.description}</p> : null}
                  </div>
                </article>

                {supportItems.length ? (
                  <div class="edu-supportRail" aria-label="Supporting resources">
                    {supportItems.map((item) => {
                      const thumb = pickThumb(item.data);
                      return (
                        <a
                          href={`/education/${item.id}`}
                          class:list={['edu-support panel panel--soft', !thumb && 'edu-support--textOnly']}
                          aria-label={`Open education resource: ${item.data.title}`}
                        >
                          {thumb ? (
                            <div class="edu-support__media" aria-hidden="true">
                              <img
                                src={typeof thumb === 'string' ? thumb : thumb.src ?? thumb}
                                alt=""
                                loading="lazy"
                                decoding="async"
                              />
                            </div>
                          ) : null}

                          <div class="edu-support__copy">
                            <div class="edu-support__meta">
                              {item.data.subject ? (
                                getTagHref(item.data.subject) ? (
                                  <a class="pill pill--link" href={getTagHref(item.data.subject)!}>
                                    {formatTaxonomyLabel(item.data.subject)}
                                  </a>
                                ) : (
                                  <span class="pill">{formatTaxonomyLabel(item.data.subject)}</span>
                                )
                              ) : (
                                <span class="pill">Resource</span>
                              )}
                              {item.data.level ? (
                                getTagHref(item.data.level) ? (
                                  <a class="pill pill--soft pill--link" href={getTagHref(item.data.level)!}>
                                    {formatTaxonomyLabel(item.data.level)}
                                  </a>
                                ) : (
                                  <span class="pill pill--soft">{formatTaxonomyLabel(item.data.level)}</span>
                                )
                              ) : null}
                            </div>
                            <h3 class="edu-support__title">{item.data.title}</h3>
                            {item.data.description ? <p class="edu-support__desc">{item.data.description}</p> : null}
                          </div>
                        </a>
                      );
                    })}
                  </div>
                ) : null}
              </div>
            </section>
          ) : null}

          {archiveItems.length ? (
            <section class="edu-archive" aria-labelledby="education-archive-heading">
              <div class="section-head section-head--archive">
                <div>
                  <p class="eyebrow eyebrow--muted">Archive</p>
                  <h2 id="education-archive-heading">Everything else</h2>
                </div>
              </div>

              <div class="edu-archiveGrid">
                {archiveItems.map((item) => {
                  const thumb = pickThumb(item.data);

                  return (
                    <a href={`/education/${item.id}`} class:list={['edu-card', !thumb && 'edu-card--textOnly']} aria-label={`Open education resource: ${item.data.title}`}>
                      {thumb ? (
                        <div class="edu-card__media" aria-hidden="true">
                          <img
                            src={typeof thumb === 'string' ? thumb : thumb.src ?? thumb}
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      ) : null}

                      <div class="edu-card__body">
                        <div class="edu-card__meta">
                          <span class="pill">Resource</span>
                          {item.data.subject ? (
                            getTagHref(item.data.subject) ? (
                              <a class="pill pill--soft pill--link" href={getTagHref(item.data.subject)!}>
                                {formatTaxonomyLabel(item.data.subject)}
                              </a>
                            ) : (
                              <span class="pill pill--soft">{formatTaxonomyLabel(item.data.subject)}</span>
                            )
                          ) : null}
                        </div>

                        <h3 class="edu-card__title">{item.data.title}</h3>
                        {item.data.description ? <p class="edu-card__desc">{item.data.description}</p> : null}
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          ) : null}
        </>
      )}
    </main>

    <Footer />
  </body>
</html>

<style>
  .education-index {
    max-width: min(1320px, calc(100% - 2 * var(--space-5)));
  }

  .empty {
    padding: var(--space-6);
  }

  .empty-title {
    margin: 0 0 0.4rem 0;
    font-weight: 700;
    color: var(--text);
  }

  .empty-sub {
    margin: 0;
    color: var(--text-2);
    max-width: 80ch;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .section-head h2 {
    margin: 0;
  }

  .eyebrow--accent,
  .eyebrow--muted {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow--accent {
    color: color-mix(in srgb, var(--accent) 54%, var(--text) 46%);
  }

  .eyebrow--muted {
    color: var(--muted);
  }

  .edu-featureBand {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .edu-featureBand__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: var(--space-5);
    align-items: start;
  }

  .edu-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(280px, 0.96fr);
    gap: var(--space-5);
    background:
      radial-gradient(680px 220px at top left, rgba(20, 184, 166, 0.08), transparent 68%),
      radial-gradient(480px 180px at bottom right, rgba(37, 99, 235, 0.06), transparent 72%),
      var(--surface-raised);
  }

  .edu-lead--textOnly {
    grid-template-columns: 1fr;
  }

  .edu-lead__media,
  .edu-support__media,
  .edu-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--surface);
  }

  .edu-lead__media {
    border-radius: 18px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  .edu-lead__media img,
  .edu-support__media img,
  .edu-card__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .edu-lead__copy,
  .edu-support__copy,
  .edu-card__body {
    min-width: 0;
  }

  .edu-lead__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    justify-content: center;
  }

  .edu-lead__meta,
  .edu-support__meta,
  .edu-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .education-index .pill {
    background: color-mix(in srgb, var(--surface-raised) 72%, var(--text) 28%);
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--border) 58%, var(--text) 42%);
  }

  .pill--soft {
    background: color-mix(in srgb, var(--surface) 86%, var(--accent) 14%);
    color: var(--text);
    border-color: color-mix(in srgb, var(--border) 70%, var(--accent) 30%);
  }

  .pill--link {
    text-decoration: none;
    transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
  }

  .pill--link:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border) 58%);
    background: color-mix(in srgb, var(--surface-raised) 66%, var(--accent) 34%);
  }

  .edu-lead__title,
  .edu-lead__desc,
  .edu-support__title,
  .edu-support__desc,
  .edu-card__title,
  .edu-card__desc {
    margin: 0;
  }

  .edu-lead__title {
    font-size: clamp(2rem, 2.8vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .edu-lead__title a,
  .edu-support__title,
  .edu-card__title {
    color: inherit;
    text-decoration: none;
  }

  .edu-lead__desc {
    max-width: 40ch;
    color: var(--text-2);
    font-size: clamp(1rem, 1.1vw, 1.15rem);
  }

  .edu-supportRail {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .edu-support {
    display: grid;
    grid-template-columns: minmax(160px, 0.78fr) minmax(0, 1.22fr);
    gap: var(--space-4);
    text-decoration: none;
    color: inherit;
    align-self: start;
  }

  .edu-support--textOnly {
    grid-template-columns: 1fr;
  }

  .edu-support__media {
    aspect-ratio: 16 / 11;
    border-radius: 14px;
  }

  .edu-support__copy {
    display: grid;
    gap: var(--space-3);
    align-content: center;
  }

  .edu-support--textOnly .edu-support__copy {
    align-content: start;
  }

  .edu-support__title,
  .edu-card__title {
    font-size: clamp(1.2rem, 1.35vw, 1.55rem);
    line-height: 1.14;
    text-wrap: balance;
  }

  .edu-support__desc,
  .edu-card__desc {
    color: var(--text-2);
  }

  .edu-archive {
    display: grid;
    gap: var(--space-5);
  }

  .edu-archiveGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    align-items: start;
  }

  .edu-card {
    display: flex;
    flex-direction: column;
    align-self: start;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease;
  }

  .edu-card--textOnly {
    background:
      radial-gradient(480px 160px at top left, rgba(20, 184, 166, 0.06), transparent 72%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(248, 250, 252, 0.96));
  }

  .edu-card:hover,
  .edu-support:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--accent) 22%, var(--border) 78%);
  }

  .edu-card__media {
    aspect-ratio: 16 / 9;
  }

  .edu-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (max-width: 980px) {
    .edu-featureBand__grid,
    .edu-lead {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 780px) {
    .education-index {
      max-width: calc(100% - 2 * var(--space-4));
    }

    .edu-support {
      grid-template-columns: 1fr;
    }
  }
</style>
