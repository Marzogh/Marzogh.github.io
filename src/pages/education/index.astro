---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import EducationSubjectGatewayBand from '../../components/education/EducationSubjectGatewayBand.astro';
import { YEAR9_DIGITECH_RESOURCES } from '../../data/educationYear9DigitalTechnologies';
import {
  educationPathFromId,
  getEducationLevelLabel,
} from '../../utils/education';
import { EDUCATION_VISIBLE } from '../../utils/siteVisibility';

if (!EDUCATION_VISIBLE) {
  return Astro.redirect('/404', 302);
}

interface SearchRow {
  href: string;
  title: string;
  subject: string;
  level: string;
  description: string;
  search: string;
}

const entries = await getCollection('education', ({ data }) => !data.draft && data.showInLanding !== false);

const canonicalDigitechHref = (slug: string, sourceSlug?: string) => {
  if (sourceSlug === 'welcome-to-unit-1-all-about-python.html') {
    return '/education/digital-technologies/year-9/unit-1';
  }
  if (sourceSlug === 'welcome-to-unit-2-making-python-interact-with-the-real-world.html') {
    return '/education/digital-technologies/year-9/unit-2';
  }
  return `/education/${slug}`;
};

const searchRows: SearchRow[] = [
  ...entries.map((entry) => ({
    href: educationPathFromId(entry.id),
    title: entry.data.title,
    subject: entry.data.subject ?? 'general',
    level: entry.data.level ?? '',
    description: entry.data.description ?? '',
    search: `${entry.data.title} ${entry.data.description ?? ''} ${entry.data.subject ?? ''} ${entry.data.level ?? ''} ${(entry.data.tags ?? []).join(' ')}`.toLowerCase(),
  })),
  ...YEAR9_DIGITECH_RESOURCES.map((resource) => ({
    href: canonicalDigitechHref(resource.slug, resource.sourceSlug),
    title: resource.title,
    subject: 'digital-technologies',
    level: 'year-9',
    description: resource.description,
    search: `${resource.title} ${resource.description} digital technologies year 9 ${resource.tags.join(' ')}`.toLowerCase(),
  })),
];

const biologyLevels = [...new Set(entries.filter((entry) => entry.data.subject === 'biology').map((entry) => entry.data.level).filter(Boolean))]
  .map((level) => ({ href: `/education/biology#${level}`, label: getEducationLevelLabel(level) }));

const mathematicsLevels = [...new Set(entries.filter((entry) => entry.data.subject === 'mathematics').map((entry) => entry.data.level).filter(Boolean))]
  .map((level) => ({ href: `/education/mathematics#${level}`, label: getEducationLevelLabel(level) }));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Education — Chips’nCode" description="Education." />
  </head>
  <body class="theme-edu">
    <Header />
    <main class="edu-index-page">
      <header class="edu-index-header">
        <h1>Education</h1>
      </header>

      <section class="edu-index-search" aria-label="Search education">
        <label class="edu-index-search__label" for="edu-search">Search</label>
        <div class="edu-index-search__body">
          <input id="edu-search" type="search" placeholder="Search lessons, notes, worksheets, labs" data-edu-search />
          <div class="edu-index-results" data-edu-results hidden>
            <p class="edu-index-results__count" data-edu-results-count></p>
            <ul data-edu-results-list></ul>
          </div>
        </div>
      </section>

      <section class="edu-index-subjects" aria-label="Education subjects">
        <EducationSubjectGatewayBand
          title="Digital Technologies"
          href="/education/digital-technologies"
          context={['Subject']}
          previewLinks={[
            { href: '/education/digital-technologies', label: 'Year 9' },
          ]}
        />

        <EducationSubjectGatewayBand
          title="Biology"
          href="/education/biology"
          context={['Subject']}
          previewLinks={biologyLevels}
        />

        <EducationSubjectGatewayBand
          title="Mathematics"
          href="/education/mathematics"
          context={['Subject']}
          previewLinks={mathematicsLevels}
        />
      </section>
    </main>

    <Footer />

    <script is:inline define:vars={{ searchRows }}>
      (() => {
        const searchEl = document.querySelector('[data-edu-search]');
        const resultsWrap = document.querySelector('[data-edu-results]');
        const resultsCount = document.querySelector('[data-edu-results-count]');
        const resultsList = document.querySelector('[data-edu-results-list]');
        const rows = searchRows || [];

        const render = (query) => {
          if (!resultsWrap || !resultsCount || !resultsList) return;
          const q = query.trim().toLowerCase();

          if (!q) {
            resultsWrap.hidden = true;
            resultsList.innerHTML = '';
            resultsCount.textContent = '';
            return;
          }

          const matches = rows.filter((row) => row.search.includes(q)).slice(0, 18);
          resultsWrap.hidden = false;
          resultsCount.textContent = `${matches.length} match${matches.length === 1 ? '' : 'es'}`;
          resultsList.innerHTML = matches.map((row) => `
            <li>
              <a href="${row.href}">
                <strong>${row.title}</strong>
                <span>${row.subject === 'digital-technologies' ? 'Digital Technologies' : row.subject.charAt(0).toUpperCase() + row.subject.slice(1).replace(/-/g, ' ')}</span>
                ${row.level ? `<em>${row.level.replace(/^year-/i, 'Year ')}</em>` : ''}
              </a>
            </li>
          `).join('');
        };

        searchEl?.addEventListener('input', () => render(searchEl.value));
      })();
    </script>
  </body>
</html>

<style>
  .edu-index-page {
    width: min(1320px, calc(100% - 4rem));
    margin: 0 auto;
    padding: 3rem 0 5rem;
    display: grid;
    gap: 1.8rem;
  }

  .edu-index-header h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .edu-index-search {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1fr);
    gap: 1.2rem 2rem;
    padding: 0.85rem 0 0.95rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .edu-index-search__label {
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    align-self: start;
    padding-top: 0.8rem;
  }

  .edu-index-search__body {
    display: grid;
    gap: 0.8rem;
  }

  .edu-index-search__body input {
    width: 100%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    padding: 0.7rem 0.82rem;
    font: inherit;
    border-radius: 0.85rem;
  }

  .edu-index-results {
    display: grid;
    gap: 0.7rem;
  }

  .edu-index-results__count {
    margin: 0;
    color: var(--text-2);
    font-size: 0.92rem;
  }

  .edu-index-results ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .edu-index-results li {
    border-top: 1px solid color-mix(in srgb, var(--border) 68%, transparent 32%);
  }

  .edu-index-results a {
    display: grid;
    gap: 0.2rem;
    padding: 0.72rem 0;
    color: inherit;
    text-decoration: none;
  }

  .edu-index-results strong {
    font-size: 1rem;
  }

  .edu-index-results a:hover strong {
    color: var(--link-hover);
  }

  .edu-index-results span,
  .edu-index-results em {
    color: var(--text-2);
    font-style: normal;
    font-size: 0.92rem;
  }

  .edu-index-subjects {
    display: grid;
  }

  @media (max-width: 720px) {
    .edu-index-page {
      width: min(100% - 1.5rem, 1320px);
      padding-top: 2.2rem;
    }

    .edu-index-search {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .edu-index-search__label {
      padding-top: 0;
    }
  }
</style>
