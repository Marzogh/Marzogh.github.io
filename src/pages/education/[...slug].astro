---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import EducationHeaderMinimal from '../../components/education/EducationHeaderMinimal.astro';
import EducationImportedContent from '../../components/education/EducationImportedContent.astro';
import EducationMetaLine from '../../components/education/EducationMetaLine.astro';
import EducationUtilityBar from '../../components/education/EducationUtilityBar.astro';
import { YEAR9_DIGITECH_BY_SLUG, YEAR9_DIGITECH_RESOURCES } from '../../data/educationYear9DigitalTechnologies';
import {
  normalizeEducationId,
} from '../../utils/education';
import { EDUCATION_LEGACY_REDIRECTS } from '../../utils/educationLegacy';
import { EDUCATION_VISIBLE } from '../../utils/siteVisibility';

export async function getStaticPaths() {
  if (!EDUCATION_VISIBLE) return [];
  const entries = await getCollection('education', ({ data }) => !data.draft);
  const contentPaths = entries.map((entry) => ({ params: { slug: normalizeEducationId(entry.id) } }));
  const legacyPaths = Object.keys(EDUCATION_LEGACY_REDIRECTS).map((slug) => ({ params: { slug } }));
  const qlearnPaths = YEAR9_DIGITECH_RESOURCES.map((resource) => ({ params: { slug: resource.slug } }));
  return [...contentPaths, ...legacyPaths, ...qlearnPaths];
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing route parameter: slug');

const canonicalYear9Target = slug === 'digital-technologies/year-9' ? '/education/digital-technologies' : null;
const legacyTarget = canonicalYear9Target ?? EDUCATION_LEGACY_REDIRECTS[slug];
const legacyRedirectScript = legacyTarget ? `window.location.replace(${JSON.stringify(legacyTarget)});` : '';

const entries = legacyTarget ? [] : await getCollection('education', ({ data }) => !data.draft);
const entry = legacyTarget ? null : entries.find((candidate) => normalizeEducationId(candidate.id) === slug) ?? null;
const qlearnResource = !entry && !legacyTarget ? YEAR9_DIGITECH_BY_SLUG.get(slug) ?? null : null;

if (!legacyTarget && !entry && !qlearnResource) {
  throw new Error(`Education entry not found: ${slug}`);
}

let Content = null;
if (entry) {
  const rendered = await render(entry);
  Content = rendered.Content;
}

const qlearnHubSourceBySlug: Record<string, string> = {
  'digital-technologies/year-9/unit-1': 'welcome-to-unit-1-all-about-python.html',
  'digital-technologies/year-9/unit-2': 'welcome-to-unit-2-making-python-interact-with-the-real-world.html',
};

const qlearnImportedSource = qlearnResource?.sourceSlug ?? (qlearnResource ? qlearnHubSourceBySlug[qlearnResource.slug] : undefined);
const qlearnUtilityLinks = qlearnImportedSource
  ? [{ label: 'Open standalone HTML', url: `/education/student-resources/digital-technologies-year-9-2026/pages/${qlearnImportedSource}` }]
  : [];

const canonicalQlearnHref = (resource) => {
  if (!resource) return '';
  if (resource.sourceSlug === 'welcome-to-unit-1-all-about-python.html') {
    return '/education/digital-technologies/year-9/unit-1';
  }
  if (resource.sourceSlug === 'welcome-to-unit-2-making-python-interact-with-the-real-world.html') {
    return '/education/digital-technologies/year-9/unit-2';
  }
  return `/education/${resource.slug}`;
};

const isTeacherOnlyQlearn = qlearnResource?.audience === 'teacher';
const isQlearnUnitHub =
  qlearnResource?.slug === 'digital-technologies/year-9/unit-1' ||
  qlearnResource?.slug === 'digital-technologies/year-9/unit-2';

const metadata = entry
  ? [
      entry.data.subject ? entry.data.subject.replace(/-/g, ' ') : '',
      entry.data.level ? entry.data.level.replace(/^year-/i, 'Year ') : '',
    ].filter(Boolean)
  : isTeacherOnlyQlearn
    ? ['Teacher material']
    : [];

const backHref = qlearnResource
  ? qlearnResource.slug === 'digital-technologies/year-9/unit-1' || qlearnResource.slug === 'digital-technologies/year-9/unit-2'
      ? '/education/digital-technologies'
      : qlearnResource.unit === 'unit-1'
      ? '/education/digital-technologies/year-9/unit-1'
      : qlearnResource.unit === 'unit-2'
        ? '/education/digital-technologies/year-9/unit-2'
        : '/education/digital-technologies'
  : '/education';

const backLabel = qlearnResource
  ? isQlearnUnitHub
      ? 'Back to Digital Technologies'
      : qlearnResource.unit === 'unit-1'
      ? 'Back to Unit 1'
      : qlearnResource.unit === 'unit-2'
        ? 'Back to Unit 2'
        : 'Back to Digital Technologies'
  : 'Back to Education';
---

<!doctype html>
<html lang="en">
  <head>
    {legacyTarget ? (
      <>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0;url=${legacyTarget}`} />
        <link rel="canonical" href={legacyTarget} />
        <title>Redirecting…</title>
      </>
    ) : (
      <BaseHead title={entry?.data.title ?? qlearnResource!.title} description={entry?.data.description ?? qlearnResource!.description} />
    )}
  </head>
  <body class="theme-edu">
    {legacyTarget ? (
      <main class="edu-page"><p>Redirecting to <a href={legacyTarget}>{legacyTarget}</a>.</p><script is:inline set:html={legacyRedirectScript} /></main>
    ) : (
      <>
        <Header />
        <main class="edu-page">
          <article class="edu-resource">
            <div class="edu-resource__masthead">
              <EducationHeaderMinimal backHref={backHref} backLabel={backLabel} title={entry?.data.title ?? qlearnResource!.title} />
              {((entry?.data.downloadTargets?.length ? entry.data.downloadTargets : qlearnUtilityLinks).length) ? (
                <EducationUtilityBar links={entry?.data.downloadTargets?.length ? entry.data.downloadTargets : qlearnUtilityLinks} />
              ) : null}
            </div>
            {(entry || isTeacherOnlyQlearn) ? <EducationMetaLine items={metadata} /> : null}

            <div class="edu-resource__body">
              {entry ? (
                <div class:list={['prose', 'prose--edu', entry.data.renderMode === 'interactive-document' && 'prose--eduInteractive']}>
                  {Content ? <Content /> : null}
                </div>
              ) : qlearnImportedSource ? (
                <EducationImportedContent source={qlearnImportedSource} sourceKind="qlearn-year9" />
              ) : null}
            </div>
          </article>
        </main>
        <Footer />
      </>
    )}
  </body>
</html>

<style>
  .edu-page {
    width: min(1360px, calc(100% - 4rem));
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }

  .edu-resource {
    display: grid;
    gap: 0.8rem;
  }

  .edu-resource__masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem 1.5rem;
    align-items: start;
  }

  .edu-resource__body {
    padding-top: 0.35rem;
  }

  .prose--edu :global(.embed) {
    margin: 0;
  }

  .prose--eduInteractive {
    max-width: none;
  }

  @media (max-width: 720px) {
    .edu-page {
      width: min(100% - 1.5rem, 1360px);
      padding-top: 2.2rem;
    }

    .edu-resource__masthead {
      grid-template-columns: 1fr;
    }
  }
</style>
