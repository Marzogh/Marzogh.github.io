---
const today = new Date();
---

<footer class="site-footer" aria-label="Site footer">
	<div class="footer__inner">

		<div class="footer__meta">
			<div class="footer__copy">&copy; {today.getFullYear()} ChipsnCode</div>
			<nav class="footer__links" aria-label="Footer links">
				<a class="iconbtn" href="https://github.com/Marzogh" target="_blank" rel="noopener noreferrer" aria-label="GitHub: Marzogh">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>

				<a class="iconbtn" href="/rss.xml" aria-label="RSS feed">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
						<path fill="currentColor" d="M6.18 17.82A2.18 2.18 0 1 1 4 20a2.18 2.18 0 0 1 2.18-2.18ZM4 4.44v3.09c6.82 0 12.37 5.55 12.37 12.37h3.09C19.46 11.36 12.54 4.44 4 4.44Zm0 6.18v3.09c3.41 0 6.18 2.77 6.18 6.18h3.09c0-5.12-4.15-9.27-9.27-9.27Z" />
					</svg>
				</a>

				<a class="iconbtn" href="/sitemap/" aria-label="Sitemap">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
						<path fill="currentColor" d="M10 3a3 3 0 1 0 1.83 5.38l2.1 1.22a3 3 0 0 0 0 4.8l-2.1 1.22A3 3 0 1 0 13 18a3 3 0 0 0-.07-.64l2.12-1.23A3 3 0 1 0 15 8.87l-2.12-1.23A3 3 0 0 0 13 7a3 3 0 0 0-3-4Zm0 2a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm8 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm-8 8a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z" />
					</svg>
				</a>
			</nav>
			<div class="footer__license">Non-poetry writing: <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a> &nbsp;•&nbsp; Poetry: All rights reserved &nbsp;•&nbsp; Code: <a href="https://opensource.org/license/mit/" target="_blank" rel="noopener noreferrer">MIT</a> &nbsp;•&nbsp; Third-party material remains subject to its original ownership, licence and source terms.</div>
			<div class="footer__disclaimer">No warranty. Use at your own risk; you’re responsible for outcomes and any errors.</div>
		</div>
	</div>
</footer>
<style>
  .site-footer { padding: 0 1.5rem 1.5rem; color: var(--text); }
  .footer__inner { max-width: 1320px; margin: 0 auto; padding-top: 0.75rem; border-top: 1px solid var(--border-2); }
  .footer__meta { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.25rem 1rem; font-size: 0.82rem; line-height: 1.5; }
  .footer__copy { font-weight: 700; grid-column: 1; }
  .footer__links { display: flex; align-items: center; gap: 0.35rem; grid-column: 2; }
  .footer__license, .footer__disclaimer { grid-column: 1 / -1; color: var(--text-2); font-size: 0.75rem; }
  .footer__license a { color: var(--text); text-underline-offset: 0.2em; }
  .iconbtn { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; color: var(--text); text-decoration: none; }
  .iconbtn:hover { color: var(--accent); }
  .iconbtn:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
  @media (pointer: coarse) { .iconbtn { width: 44px; height: 44px; } }
</style>
