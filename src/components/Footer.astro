---
import { Image } from 'astro:assets';
import logo from '../assets/Logo.png';
const today = new Date();
---

<footer class="site-footer" aria-label="Site footer">
	<div class="footer__inner">
		<div class="footer__brand">
			<a class="footer__brandLink" href="/" aria-label="ChipsnCode home">
				<Image
					class="footer__logo"
					src={logo}
					alt="ChipsnCode logo"
					width={88}
					height={88}
					format="webp"
					quality={80}
				/>
				<span class="footer__brandText">ChipsnCode</span>
			</a>
		</div>

		<div class="footer__meta">
			<div class="footer__copy">&copy; {today.getFullYear()} ChipsnCode</div>
			<nav class="footer__links" aria-label="Footer links">
				<a class="iconbtn" href="https://github.com/Marzogh" target="_blank" rel="noopener noreferrer" aria-label="GitHub: Marzogh">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>

				<a class="iconbtn" href="/rss.xml" aria-label="RSS feed">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
						<path fill="currentColor" d="M6.18 17.82A2.18 2.18 0 1 1 4 20a2.18 2.18 0 0 1 2.18-2.18ZM4 4.44v3.09c6.82 0 12.37 5.55 12.37 12.37h3.09C19.46 11.36 12.54 4.44 4 4.44Zm0 6.18v3.09c3.41 0 6.18 2.77 6.18 6.18h3.09c0-5.12-4.15-9.27-9.27-9.27Z" />
					</svg>
				</a>

				<a class="iconbtn" href="/sitemap-index.xml" aria-label="Sitemap">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
						<path fill="currentColor" d="M10 3a3 3 0 1 0 1.83 5.38l2.1 1.22a3 3 0 0 0 0 4.8l-2.1 1.22A3 3 0 1 0 13 18a3 3 0 0 0-.07-.64l2.12-1.23A3 3 0 1 0 15 8.87l-2.12-1.23A3 3 0 0 0 13 7a3 3 0 0 0-3-4Zm0 2a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm8 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm-8 8a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z" />
					</svg>
				</a>
			</nav>
			<div class="footer__license">Non-poetry writing: <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a> &nbsp;•&nbsp; Poetry: All rights reserved &nbsp;•&nbsp; Code: <a href="https://opensource.org/license/mit/" target="_blank" rel="noopener noreferrer">MIT</a></div>
			<div class="footer__disclaimer">No warranty. Use at your own risk; you’re responsible for outcomes and any errors.</div>
		</div>
	</div>
</footer>
<style>
	.site-footer {
		padding: 2rem 1rem;
		border-top: 1px solid var(--border);
		background:
			radial-gradient(1200px 120px at 10% 0%, color-mix(in srgb, var(--accent) 18%, transparent 82%), transparent 65%),
			radial-gradient(900px 120px at 90% 0%, color-mix(in srgb, var(--accent) 14%, transparent 86%), transparent 60%),
			color-mix(in srgb, var(--surface) 92%, transparent 8%);
		color: var(--text);
		font-size: 0.95rem;
	}

	.footer__inner {
		max-width: 1400px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	@media (min-width: 900px) {
		.footer__inner {
			grid-template-columns: 260px 1fr auto;
			align-items: center;
		}
	}

	.footer__brandLink {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--text);
		font-weight: 900;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.footer__brandText {
		white-space: nowrap;
	}

	.footer__logo {
		display: block;
		width: 44px;
		height: 44px;
		border-radius: 14px;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface-2) 85%, transparent 15%);
		box-shadow: var(--shadow-sm);
		object-fit: cover;
		flex: 0 0 44px;
	}

	.footer__meta {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 0.5rem 1rem;
		font-size: 0.82rem;
	}

	.footer__copy {
		font-weight: 700;
		letter-spacing: -0.01em;
		grid-column: 1;
	}

	.footer__license {
		margin-top: 0.25rem;
		color: var(--muted);
		font-size: 0.8rem;
		grid-column: 1 / -1;
	}

	.footer__license a {
		color: var(--link);
		text-decoration: none;
		font-weight: 700;
	}

	.footer__license a:hover {
		color: var(--link-hover);
		text-decoration: underline;
	}

	.footer__disclaimer {
		margin-top: 0.35rem;
		color: var(--muted);
		font-size: 0.75rem;
		max-width: 80ch;
		grid-column: 1 / -1;
	}

	.footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: flex-end;
		align-items: center;
		grid-column: 2;
	}

	.iconbtn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 999px;
		border: 0;
		background: transparent;
		color: color-mix(in srgb, var(--text) 78%, var(--muted) 22%);
		text-decoration: none;
		box-shadow: none;
	}

	.iconbtn:hover {
		color: var(--text);
		background: color-mix(in srgb, var(--accent) 10%, transparent 90%);
	}

	.iconbtn:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--accent) 55%, transparent 45%);
		outline-offset: 2px;
		background: color-mix(in srgb, var(--accent) 12%, transparent 88%);
	}

	@media (max-width: 899px) {
		.footer__meta {
			text-align: left;
		}
	}

	@media (min-width: 900px) {
		.footer__meta {
			text-align: right;
		}
		.footer__disclaimer {
			margin-left: auto;
		}
	}
</style>
