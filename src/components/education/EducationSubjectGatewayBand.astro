---
interface PreviewLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  href: string;
  note?: string;
  context?: string[];
  previewLinks?: PreviewLink[];
}

const {
  title,
  href,
  note = '',
  context = [],
  previewLinks = [],
} = Astro.props;
---

<section class="edu-gateway-band">
  <div class="edu-gateway-band__title">
    {context.length ? (
      <p class="edu-gateway-band__context">{context.join(' · ')}</p>
    ) : null}
    <h2><a href={href}>{title}</a></h2>
    {note ? <p>{note}</p> : null}
  </div>

  <div class="edu-gateway-band__body">
    {previewLinks.length ? (
      <nav class="edu-gateway-band__links" aria-label={`${title} entry points`}>
        {previewLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    ) : null}
  </div>
</section>

<style>
  .edu-gateway-band {
    display: grid;
    grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 1.4fr);
    gap: 1.4rem 2rem;
    padding: 1.15rem 0 1.2rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 78%, transparent 22%);
  }

  .edu-gateway-band__title,
  .edu-gateway-band__body {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .edu-gateway-band__title h2,
  .edu-gateway-band__title p {
    margin: 0;
  }

  .edu-gateway-band__context {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .edu-gateway-band__title h2 {
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .edu-gateway-band__title h2 a,
  .edu-gateway-band__links a {
    color: inherit;
    text-decoration: none;
  }

  .edu-gateway-band__title h2 a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent 65%);
  }

  .edu-gateway-band__title h2 a:hover,
  .edu-gateway-band__links a:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }

  .edu-gateway-band__title p {
    color: var(--text-2);
    max-width: 42ch;
    line-height: 1.45;
  }

  .edu-gateway-band__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.85rem;
    align-items: center;
  }

  .edu-gateway-band__links a {
    color: var(--text-2);
    font-size: 0.95rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--text-2) 35%, transparent 65%);
    text-underline-offset: 0.18em;
  }

  @media (max-width: 820px) {
    .edu-gateway-band {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }
</style>
