---
interface Props {
  items: string[];
}

const { items = [] } = Astro.props;
const visible = items.filter(Boolean);
---

{visible.length ? (
  <p class="edu-meta-line">
    {visible.map((item, index) => (
      <>
        {index > 0 ? <span aria-hidden="true"> · </span> : null}
        <span>{item}</span>
      </>
    ))}
  </p>
) : null}

<style>
  .edu-meta-line {
    margin: 0;
    color: var(--text-2);
    font-size: 0.96rem;
    line-height: 1.45;
  }
</style>
