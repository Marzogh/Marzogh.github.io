---
interface Props {
  src: string;
  title: string;
  minHeight?: string;
}

const { src, title, minHeight = '1600px' } = Astro.props;
---

<section class="embed">
  <div class="embed__bar">
    <div>
      <p class="embed__eyebrow">Interactive Resource</p>
      <h2 class="embed__title">{title}</h2>
    </div>
    <a class="embed__link" href={src} target="_blank" rel="noopener noreferrer">Open full page</a>
  </div>

  <iframe
    class="embed__frame"
    src={src}
    title={title}
    loading="lazy"
    style={`min-height: ${minHeight};`}
  />
</section>

<style>
  .embed {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0;
  }

  .embed__bar {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(47, 107, 63, 0.09), rgba(11, 79, 138, 0.06));
  }

  .embed__eyebrow {
    margin: 0 0 0.35rem 0;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .embed__title {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .embed__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-glass);
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: transform 120ms ease, border-color 120ms ease, box-shadow 120ms ease;
  }

  .embed__link:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 24%, var(--border) 76%);
    box-shadow: var(--shadow-sm);
  }

  .embed__frame {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface-raised);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 720px) {
    .embed__bar {
      align-items: start;
      flex-direction: column;
    }

    .embed__link {
      width: 100%;
    }
  }
</style>
