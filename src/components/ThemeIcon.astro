---
interface Props {
  name: 'builds' | 'code' | 'life' | 'mind' | 'light';
}

const { name } = Astro.props;
---

<svg class="theme-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {name === 'builds' && (
    <>
      <rect x="6.5" y="6.5" width="11" height="11" rx="1.25" />
      <rect x="9.5" y="9.5" width="5" height="5" />
      <path d="M9 3.5v3M15 3.5v3M9 17.5v3M15 17.5v3M3.5 9h3M3.5 15h3M17.5 9h3M17.5 15h3" />
    </>
  )}
  {name === 'code' && (
    <path d="m8.5 7-5 5 5 5M15.5 7l5 5-5 5M14 4l-4 16" />
  )}
  {name === 'life' && (
    <>
      <path d="M19.5 4.5C11 4.7 5.5 8.2 5.5 14.1c0 2.9 2.1 5.4 5.2 5.4 5.8 0 8.5-6.1 8.8-15Z" />
      <path d="M4 20c2.8-5.2 6.5-8.8 11.4-11.1" />
    </>
  )}
  {name === 'mind' && (
    <>
      <path d="M9.2 5.2a3.2 3.2 0 0 0-5 2.7c0 .6.2 1.2.5 1.7A3.8 3.8 0 0 0 6 16.9v.3a2.8 2.8 0 0 0 5.5.8V6.4a3.1 3.1 0 0 0-2.3-1.2Z" />
      <path d="M14.8 5.2a3.2 3.2 0 0 1 5 2.7c0 .6-.2 1.2-.5 1.7a3.8 3.8 0 0 1-1.3 7.3v.3a2.8 2.8 0 0 1-5.5.8V6.4a3.1 3.1 0 0 1 2.3-1.2ZM7.2 9.5c1.2.1 2.2.8 2.7 1.8M16.8 9.5c-1.2.1-2.2.8-2.7 1.8M7.3 15.2c1.2-.2 2.3.2 3 1" />
    </>
  )}
  {name === 'light' && (
    <>
      <path d="M12 2.5v5M12 16.5v5M2.5 12h5M16.5 12h5M5.3 5.3l3.5 3.5M15.2 15.2l3.5 3.5M18.7 5.3l-3.5 3.5M8.8 15.2l-3.5 3.5" />
      <circle cx="12" cy="12" r="2.2" />
    </>
  )}
</svg>

<style>
  .theme-icon {
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
