    padding: 0.62rem 0.75rem;
    border: 1px solid var(--ft-line);
    border-left: 0;
    border-radius: 0;
    background: color-mix(in srgb, var(--ft-panel) 90%, transparent);
    box-shadow: inset 3px 0 0 var(--ft-blue);
