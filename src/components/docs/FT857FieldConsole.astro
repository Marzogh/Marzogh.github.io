  ['045', 'DSP BPF WIDTH', 'Audio', 'DSP CW audio filter bandwidth', 'Default: 240 Hz. Narrow CW audio with 60, 120, or 240 Hz.'],
  ['046', 'DSP HPF CUTOFF', 'Audio', 'DSP high-pass low-cut frequency', 'Default: 100 Hz. Raise for voice-mode low-frequency rejection.'],
  ['047', 'DSP LPF CUTOFF', 'Audio', 'DSP low-pass high-cut frequency', 'Default: 6000 Hz. Lower for voice-mode high-frequency rejection.'],
  ['048', 'DSP MIC EQ', 'Audio', 'DSP microphone equalizer', 'Default: OFF. Choose LPF, HPF, or BOTH for transmit audio shaping.'],
  ['049', 'DSP NR LEVEL', 'Audio', 'DSP noise reduction level', 'Increase until noise drops without watery audio.'],
  ['050', 'EMERGENCY', 'System', 'Alaska emergency channel enable', 'USA version only. Default: OFF. Enables 5167.5 kHz under the manual restrictions.'],
  ['051', 'FM MIC GAIN', 'Audio', 'FM microphone gain', 'Set if FM audio is low or distorted.'],
  ['052', 'FM STEP', 'RF', 'FM SELECT tuning step', 'Match channel spacing.'],
  ['053', 'HOME > VFO', 'Memory', 'Copy HOME channel data to VFO when tuning', 'Default: ON. Lets HOME data move into the current VFO without changing stored HOME.'],
  ['054', 'LOCK MODE', 'System', 'What LOCK disables', 'Choose DIAL, FREQ, PANEL, or ALL.'],
  ['055', 'MEM GROUP', 'Memory', 'Memory grouping on/off', 'Default: OFF. Splits standard memories into ten groups.'],
  ['056', 'MEM TAG', 'Memory', 'Memory alpha tag', 'Label memory channels.'],
  ['057', 'MEM/VFO DIAL MODE', 'System', 'SELECT knob secondary function', 'Default: MHz/MEM GRP. Choose quick access behavior when pressing SELECT.'],
  ['058', 'MIC SCAN', 'Memory', 'Mic UP/DWN scanning access', 'Default: ON. Enables scan control from microphone keys.'],
  ['059', 'MIC SEL', 'System', 'MIC jack equipment type', 'Default: NOR. Choose normal mic, MH-59A8J remote mic, or CAT.'],
  ['060', 'MTR ARX SEL', 'Display', 'Analog meter receive display', 'Default: SIG. Choose signal, center, voltage, calibration, or off.'],
  ['061', 'MTR ATX SEL', 'Display', 'Analog meter transmit display', 'Default: PWR. Choose power, ALC, modulation, SWR, voltage, or off.'],
  ['062', 'MTR PEAK HOLD', 'Display', 'Meter peak hold', 'Default: ON. Holds meter peaks briefly.'],
  ['063', 'NB LEVEL', 'RF', 'Noise blanker level', 'Raise only enough to reduce impulse noise.'],
  ['064', 'OP FILTER 1', 'System', 'Optional filter slot 1', 'Not available at this time. Included for complete menu search.'],
  ['065', 'PG A', 'System', 'Program MFq A key', 'Default: MONI. Assign the A key in row q.'],
  ['066', 'PG B', 'System', 'Program MFq B key', 'Default: Q.SPL. Assign the B key in row q.'],
  ['067', 'PG C', 'System', 'Program MFq C key', 'Default: ATC. Assign the C key in row q.'],
  ['068', 'PG ACC', 'System', 'Program MH-59A8J ACC key', 'Default: MONI. Assign the optional remote mic ACC button.'],
  ['069', 'PG P1', 'System', 'Program MH-59A8J P1 key', 'Default: Q.SPL. Assign the optional remote mic P1 button.'],
  ['070', 'PG P2', 'System', 'Program MH-59A8J P2 key', 'Default: TCALL. Assign the optional remote mic P2 button.'],
  ['071', 'PKT1200', 'Digital', '1200 bps packet input level', 'Set TNC audio drive.'],
  ['072', 'PKT9600', 'Digital', '9600 bps packet input level', 'Set TNC audio drive.'],
  ['073', 'PKT RATE', 'Digital', 'Packet rate', 'Choose 1200 or 9600 bps.'],
  ['074', 'PROC LEVEL', 'TX', 'Speech processor compression', 'Set for SSB/AM punch without distortion.'],
  ['075', 'RF POWER SET', 'TX', 'Max RF power for band', 'Reduce for battery, heat, nearby people, or tuning.'],
  ['076', 'RPT SHIFT', 'Repeater', 'Repeater offset amount', 'Set regional offset value.'],
  ['077', 'SCAN MODE', 'Memory', 'Scan resume rule', 'TIME, BUSY, or STOP.'],
  ['078', 'SCAN RESUME', 'Memory', 'Scan resume delay', 'Set hold time after signal.'],
  ['079', 'SPLIT TONE', 'Repeater', 'Separate CTCSS/DCS encode and decode', 'Default: OFF. Use for repeaters needing split tone logic.'],
  ['080', 'SQL/RF GAIN', 'RF', 'SQL/RF knob role', 'Choose RF gain or squelch.'],
  ['081', 'SSB MIC GAIN', 'Audio', 'SSB microphone gain', 'Set with ALC during speech.'],
  ['082', 'SSB STEP', 'RF', 'SSB SELECT tuning step', 'Set quick tuning step.'],
  ['083', 'TONE FREQ', 'Repeater', 'CTCSS tone frequency', 'Set repeater tone. Default is 88.5 Hz.'],
  ['084', 'TOT TIME', 'TX', 'Transmit timeout timer', 'Protect finals and prevent stuck PTT.'],
  ['085', 'TUNER/ATAS', 'Antenna', 'TUNE key device', 'Select FC-30 or ATAS-120A.'],
  ['086', 'TX IF FILTER', 'TX', 'Transmit IF filter selection', 'Default: CFIL. Choose CFIL, FIL1, or FIL2.'],
  ['087', 'VOX DELAY', 'TX', 'VOX hang time', 'Set delay before returning to receive.'],
  ['088', 'VOX GAIN', 'TX', 'VOX trigger gain', 'Set so voice keys TX and noise does not.'],
  ['089', 'XVTR A FREQ', 'System', 'Transverter A display frequency', 'Default: current VFO frequency. Set arbitrary display readout for transverter use.'],
  ['090', 'XVTR B FREQ', 'System', 'Transverter B display frequency', 'Default: current VFO frequency. Set second arbitrary transverter display readout.'],
  ['091', 'XVTR SEL', 'System', 'Transverter selection', 'Default: OFF. Enable X VTR A or X VTR B display operation.'],
];

const categories = ['All', ...Array.from(new Set(menuItems.map((item) => item[2])))];

const groupLabels = {
  'get-on-air': 'Get on air',
  fix: 'Fix',
  configure: 'Configure',
  lookup: 'Look up',
};
---

<section class="ft-console ft-console--fieldbook" data-ft-console>
  <div class="ft-resource" aria-label="Printable field manual">
    <div>
      <p class="ft-resource__label">Offline field copy</p>
      <p class="ft-resource__text">Task cards, function rows, menu table and connection checks.</p>
    </div>
    <a class="ft-resource__pdf" href="/assets/downloads/ft-857d-field-manual.pdf" download>Download field PDF <span aria-hidden="true">↓</span></a>
  </div>

  <nav class="ft-tabs" role="tablist" aria-label="FT-857D reference sections">
    <button class="is-active" type="button" role="tab" aria-selected="true" aria-controls="ft-panel-tasks" data-panel-target="tasks">Operating tasks</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="ft-panel-rows" tabindex="-1" data-panel-target="rows">Function rows</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="ft-panel-menus" tabindex="-1" data-panel-target="menus">Menu items</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="ft-panel-maps" tabindex="-1" data-panel-target="maps">Connections &amp; controls</button>
  </nav>

  <div class="ft-panel is-active" id="ft-panel-tasks" role="tabpanel" data-panel="tasks">
    <div class="ft-tools">
      <label class="ft-search">
        <span>Find a task</span>
        <input type="search" data-task-search placeholder="SWR, repeater, no audio, digital..." />
      </label>
      <div class="ft-filterbar" aria-label="Task filters">
        <button class="is-active" type="button" data-task-filter="all">All</button>
        <button type="button" data-task-filter="get-on-air">Get on air</button>
        <button type="button" data-task-filter="fix">Fix</button>
        <button type="button" data-task-filter="configure">Configure</button>
        <button type="button" data-task-filter="lookup">Look up</button>
      </div>
    </div>

    <div class="ft-task-grid">
      {tasks.map((task) => (
        <article class="ft-task" data-task-card data-group={task.group} data-terms={`${task.title} ${task.summary} ${task.steps.join(' ')} ${task.confirm} ${task.fix} ${task.related.join(' ')}`.toLowerCase()}>
          <div class="ft-task__head">
            <p>{groupLabels[task.group] ?? task.group}</p>
            <h3>{task.title}</h3>
            <span>{task.summary}</span>
          </div>
          <p class="ft-task__steps-label">Press path</p>
          <ol>
            {task.steps.map((step) => <li>{step}</li>)}
          </ol>
          <div class="ft-task__check">
            <strong>You know it worked when</strong>
            <p>{task.confirm}</p>
          </div>
          <details>
            <summary>If it still refuses</summary>
            <p>{task.fix}</p>
          </details>
          <div class="ft-tags" aria-label={`Related items for ${task.title}`}>
            {task.related.map((tag) => <button type="button" data-jump-term={tag}>{tag}</button>)}
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="ft-panel" id="ft-panel-rows" role="tabpanel" data-panel="rows">
    <div class="ft-row-layout">
      <div class="ft-row-picker">
        <label class="ft-search ft-row-search">
          <span>Find a function row</span>
          <input type="search" data-row-search placeholder="VOX, DSP, tone, Menu 063, row j..." />
        </label>
        <div class="ft-row-strip" aria-label="Function row selector">
          {rows.map((row, index) => (
            <button
              class:list={[index === 0 && 'is-active']}
              type="button"
              data-row-target={row.id}
              data-row-terms={`${row.id} ${row.labels.join(' ')} ${row.altLabels?.join(' ') ?? ''} ${row.hint} ${row.keys.map((item) => `${item.key} ${item.label} ${item.press} ${item.hold ?? ''} ${item.menus?.join(' ') ?? ''}`).join(' ')} ${row.menus?.join(' ') ?? ''}`.toLowerCase()}
            >
              <span>{row.id.replace('MF', '')}</span>
              <strong>{row.labels.join('  ')}</strong>
            </button>
          ))}
        </div>
        <p class="ft-row-empty" data-row-empty hidden>No matching function rows.</p>
      </div>

      <div class="ft-row-stage">
        {rows.map((row, index) => (
          <article class:list={['ft-row-card', index === 0 && 'is-active']} data-row-card={row.id}>
            <p class="ft-row-card__kicker">Press FUNC, then rotate SELECT until these labels appear. Manual map: {row.id}</p>
            <div class="ft-row-display">
              {row.labels.map((label) => <span>{label}</span>)}
            </div>
            {row.altLabels ? (
              <p class="ft-row-card__alt">Alternate LCD labels: <strong>{row.altLabels.join('  ')}</strong></p>
            ) : null}
            <p class="ft-row-card__hint">{row.hint}</p>
            <div class="ft-abc">
              {row.keys.map((item) => (
                <div>
                  <span>{item.key}</span>
                  <strong>{item.label}</strong>
                  <p>{item.press}</p>
                  {item.hold ? <p class="ft-abc__hold"><b>Hold:</b> {item.hold}</p> : null}
                  {item.menus ? (
                    <div class="ft-row-links" aria-label={`Menu links for ${row.id} ${item.label}`}>
                      {item.menus.map((menu) => <button type="button" data-jump-term={menu}>Menu {menu}</button>)}
                    </div>
                  ) : null}
                </div>
              ))}
            </div>
            {row.menus ? (
              <div class="ft-row-related" aria-label={`Related menu items for ${row.id}`}>
                <span>Related menus</span>
                {row.menus.map((menu) => <button type="button" data-jump-term={menu}>Menu {menu}</button>)}
              </div>
            ) : null}
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="ft-panel" id="ft-panel-menus" role="tabpanel" data-panel="menus">
    <div class="ft-tools">
      <label class="ft-search">
        <span>Find a menu item</span>
        <input type="search" data-menu-search placeholder="075, RF power, tone, mic gain..." />
      </label>
      <div class="ft-filterbar" aria-label="Menu category filters">
        {categories.map((category, index) => (
          <button class:list={[index === 0 && 'is-active']} type="button" data-menu-filter={category}>
            {category}
          </button>
        ))}
      </div>
    </div>

    <div class="ft-menu-count" data-menu-count>{menuItems.length} menu items shown</div>

    <div class="ft-menu-list">
      {menuItems.map(([number, name, category, meaning, when]) => (
        <article class="ft-menu-item" data-menu-item data-category={category} data-terms={`${number} ${name} ${category} ${meaning} ${when}`.toLowerCase()}>
          <div class="ft-menu-item__num">{number}</div>
          <div>
            <h3>{name}</h3>
            <p>{meaning}</p>
          </div>
          <div>
            <span>{category}</span>
            <p>{when}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="ft-panel" id="ft-panel-maps" role="tabpanel" data-panel="maps">
    <div class="ft-map-grid">
      <section>
        <h3>Front panel controls</h3>
        <dl class="ft-dl">
          <div><dt>AF</dt><dd>Speaker or headphone volume.</dd></div>
          <div><dt>SQL/RF</dt><dd>RF gain or squelch depending on Menu 080.</dd></div>
          <div><dt>SELECT</dt><dd>Function rows, AM/FM tuning, memories, menu numbers.</dd></div>
          <div><dt>FUNC</dt><dd>Press to use the A/B/C function labels. Hold to open the numbered menu.</dd></div>
          <div><dt>A/B/C</dt><dd>Press the button under the label currently shown on the LCD.</dd></div>
          <div><dt>DSP</dt><dd>Jump to the DNR, DNF, DBF function labels.</dd></div>
          <div><dt>V/M</dt><dd>Toggle VFO and memory. Hold to store QMB.</dd></div>
          <div><dt>LOCK</dt><dd>Lock controls; behavior is set by Menu 054.</dd></div>
        </dl>
      </section>

      <section>
        <h3>Connector checks</h3>
        <dl class="ft-dl">
          <div><dt>INPUT</dt><dd>13.8 V DC, negative ground, 22 A supply.</dd></div>
          <div><dt>HF/50 MHz ANT</dt><dd>HF and 50 MHz antenna port.</dd></div>
          <div><dt>144/430 MHz ANT</dt><dd>2 m and 70 cm antenna port.</dd></div>
          <div><dt>DATA</dt><dd>AFSK, packet, audio, PTT, SQL status.</dd></div>
          <div><dt>KEY</dt><dd>Straight key or paddle. Use stereo plug.</dd></div>
          <div><dt>SP/PH</dt><dd>Set rear SP-PH to PH before earphones.</dd></div>
        </dl>
      </section>

      <section class="ft-safety-card">
        <h3>Before the first transmission on a new setup</h3>
        <ol>
          <li>Licensed for frequency and mode.</li>
          <li>Correct antenna port and antenna for band.</li>
          <li>SWR meter selected before power check.</li>
          <li>Menu 075 set to lowest practical power.</li>
          <li>People clear of antenna.</li>
          <li>No HI SWR, abnormal voltage, or pinned ALC.</li>
        </ol>
      </section>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-ft-console]');
    if (!root) return;

    const setActive = (items, activeItem) => {
      items.forEach((item) => item.classList.toggle('is-active', item === activeItem));
    };

    const panels = Array.from(root.querySelectorAll('[data-panel]'));
    const panelButtons = Array.from(root.querySelectorAll('[data-panel-target]'));
    panelButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-panel-target');
        setActive(panelButtons, button);
        panelButtons.forEach((item) => {
          const active = item === button;
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => panel.classList.toggle('is-active', panel.getAttribute('data-panel') === target));
      });
    });

    panelButtons.forEach((button, index) => {
      button.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let next = index;
        if (event.key === 'ArrowLeft') next = (index - 1 + panelButtons.length) % panelButtons.length;
        if (event.key === 'ArrowRight') next = (index + 1) % panelButtons.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = panelButtons.length - 1;
        panelButtons[next]?.focus();
        panelButtons[next]?.click();
      });
    });

    const taskCards = Array.from(root.querySelectorAll('[data-task-card]'));
    const taskSearch = root.querySelector('[data-task-search]');
    const taskFilters = Array.from(root.querySelectorAll('[data-task-filter]'));
    let activeTaskFilter = 'all';

    const filterTasks = () => {
      const query = (taskSearch?.value || '').trim().toLowerCase();
      taskCards.forEach((card) => {
        const groupMatch = activeTaskFilter === 'all' || card.getAttribute('data-group') === activeTaskFilter;
        const terms = card.getAttribute('data-terms') || '';
        const queryMatch = !query || terms.includes(query);
        card.hidden = !(groupMatch && queryMatch);
      });
    };

    taskSearch?.addEventListener('input', filterTasks);
    taskFilters.forEach((button) => {
      button.addEventListener('click', () => {
        activeTaskFilter = button.getAttribute('data-task-filter') || 'all';
        setActive(taskFilters, button);
        filterTasks();
      });
    });

    root.querySelectorAll('[data-jump-term]').forEach((button) => {
      button.addEventListener('click', () => {
        const term = button.getAttribute('data-jump-term') || '';
        const menuTab = root.querySelector('[data-panel-target="menus"]');
        menuTab?.click();
        const menuInput = root.querySelector('[data-menu-search]');
        if (menuInput) {
          menuInput.value = term;
          menuInput.dispatchEvent(new Event('input', { bubbles: true }));
          menuInput.focus();
        }
      });
    });

    const rowButtons = Array.from(root.querySelectorAll('[data-row-target]'));
    const rowCards = Array.from(root.querySelectorAll('[data-row-card]'));
    const rowSearch = root.querySelector('[data-row-search]');
    const rowEmpty = root.querySelector('[data-row-empty]');
    const activateRow = (button) => {
      const target = button.getAttribute('data-row-target');
      setActive(rowButtons, button);
      rowCards.forEach((card) => card.classList.toggle('is-active', card.getAttribute('data-row-card') === target));
      button.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    };

    rowButtons.forEach((button) => {
      button.addEventListener('click', () => activateRow(button));
    });

    const filterRows = () => {
      const query = (rowSearch?.value || '').trim().toLowerCase();
      let firstVisible = null;
      let visibleCount = 0;
      rowButtons.forEach((button) => {
        const terms = button.getAttribute('data-row-terms') || '';
        const show = !query || terms.includes(query);
        button.hidden = !show;
        if (show) {
          visibleCount += 1;
          firstVisible ??= button;
        }
      });
      if (rowEmpty) rowEmpty.hidden = visibleCount !== 0;
      const activeVisible = rowButtons.some((button) => button.classList.contains('is-active') && !button.hidden);
      if (!activeVisible && firstVisible) activateRow(firstVisible);
      if (!firstVisible) rowCards.forEach((card) => card.classList.remove('is-active'));
    };

    rowSearch?.addEventListener('input', filterRows);

    const menuItems = Array.from(root.querySelectorAll('[data-menu-item]'));
    const menuSearch = root.querySelector('[data-menu-search]');
    const menuFilters = Array.from(root.querySelectorAll('[data-menu-filter]'));
    const menuCount = root.querySelector('[data-menu-count]');
    let activeMenuFilter = 'All';

    const filterMenus = () => {
      const query = (menuSearch?.value || '').trim().toLowerCase();
      let count = 0;
      menuItems.forEach((item) => {
        const category = item.getAttribute('data-category');
        const categoryMatch = activeMenuFilter === 'All' || category === activeMenuFilter;
        const terms = item.getAttribute('data-terms') || '';
        const queryMatch = !query || terms.includes(query);
        const show = categoryMatch && queryMatch;
        item.hidden = !show;
        if (show) count += 1;
      });
      if (menuCount) menuCount.textContent = `${count} menu item${count === 1 ? '' : 's'} shown`;
    };

    menuSearch?.addEventListener('input', filterMenus);
    menuFilters.forEach((button) => {
      button.addEventListener('click', () => {
        activeMenuFilter = button.getAttribute('data-menu-filter') || 'All';
        setActive(menuFilters, button);
        filterMenus();
      });
    });
  })();
</script>

<style>
  .ft-console {
    --ft-ink: var(--text);
    --ft-muted: var(--muted);
    --ft-line: var(--border);
    --ft-panel: var(--surface-raised);
    --ft-soft: var(--surface);
    --ft-blue: var(--accent);
    --ft-green: var(--leaf);
    --ft-red: var(--coral);
    --ft-amber: #f59e0b;
    --ft-active: color-mix(in srgb, var(--ft-blue) 10%, var(--ft-panel) 90%);
    --ft-success: color-mix(in srgb, var(--ft-green) 11%, var(--ft-panel) 89%);
    --ft-success-ink: color-mix(in srgb, var(--ft-green) 68%, var(--ft-ink) 32%);
    display: grid;
    gap: 1rem;
    margin: 1.2rem 0 2.4rem;
    color: var(--ft-ink);
  }

  .ft-resource {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--ft-line);
    border-left: 5px solid var(--ft-blue);
    border-radius: 10px;
    background: color-mix(in srgb, var(--ft-blue) 7%, var(--ft-panel) 93%);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
  }

  .ft-resource__label,
  .ft-resource__text {
    margin: 0;
  }

  .ft-resource__label {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ft-muted);
  }

  .ft-resource__text {
    font-size: 0.96rem;
    color: var(--text-2);
  }

  .ft-resource__pdf,
  .ft-tabs button,
  .ft-filterbar button,
  .ft-tags button,
  .ft-row-links button,
  .ft-row-related button,
  .ft-row-strip button {
    font: inherit;
  }

  .ft-resource__pdf {
    flex: 0 0 auto;
    padding: 0.58rem 0.78rem;
    border-radius: 8px;
    background: var(--ft-ink);
    color: var(--surface);
    font-weight: 800;
    text-decoration: none;
  }

  .ft-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .ft-tabs button,
  .ft-filterbar button,
  .ft-row-strip button,
  .ft-row-links button,
  .ft-row-related button,
  .ft-tags button {
    border: 1px solid var(--ft-line);
    background: var(--ft-panel);
    color: var(--text-2);
    cursor: pointer;
  }

  .ft-tabs button {
    min-height: 44px;
    border-radius: 8px;
    font-weight: 800;
  }

  .ft-tabs button:hover,
  .ft-tabs button.is-active,
  .ft-filterbar button:hover,
  .ft-filterbar button.is-active,
  .ft-row-strip button:hover,
  .ft-row-strip button.is-active,
  .ft-row-links button:hover,
  .ft-row-related button:hover,
  .ft-tags button:hover {
    border-color: color-mix(in srgb, var(--ft-blue) 48%, var(--ft-line) 52%);
    background: var(--ft-active);
    color: var(--ft-ink);
  }

  .ft-panel {
    display: none;
  }

  .ft-panel.is-active {
    display: block;
  }

  .ft-tools {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .ft-search {
    display: grid;
    gap: 0.35rem;
  }

  .ft-search span,
  .ft-menu-count {
    color: var(--ft-muted);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ft-search input {
    width: 100%;
    min-height: 48px;
    padding: 0.72rem 0.85rem;
    border: 1px solid var(--ft-line);
    border-radius: 8px;
    background: var(--ft-panel);
    color: var(--ft-ink);
    font: inherit;
    font-size: 1rem;
  }

  .ft-filterbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ft-filterbar button,
  .ft-tags button {
    min-height: 36px;
    padding: 0.45rem 0.65rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 800;
  }

  .ft-task-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .ft-task {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: 1rem;
    border: 1px solid var(--ft-line);
    border-radius: 10px;
    background: var(--ft-panel);
    box-shadow: var(--shadow-sm);
  }

  .ft-task[hidden],
  .ft-menu-item[hidden] {
    display: none;
  }

  .ft-task__head p,
  .ft-task__head h3,
  .ft-task__head span,
  .ft-task__steps-label,
  .ft-task__check p,
  .ft-task details p {
    margin: 0;
  }

  .ft-task__head p {
    color: var(--ft-muted);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ft-task__head h3 {
    margin-top: 0.15rem;
    font-size: 1.18rem;
  }

  .ft-task__head span {
    display: block;
    margin-top: 0.25rem;
    color: var(--text-2);
  }

  .ft-task__steps-label {
    color: var(--ft-muted);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ft-task ol,
  .ft-safety-card ol {
    margin: 0;
    padding-left: 1.2rem;
  }

  .ft-task li + li,
  .ft-safety-card li + li {
    margin-top: 0.38rem;
  }

  .ft-task__check {
    padding: 0.75rem;
    border-radius: 8px;
    background: var(--ft-success);
    border: 1px solid color-mix(in srgb, var(--ft-green) 28%, var(--ft-line) 72%);
  }

  .ft-task__check strong {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--ft-success-ink);
  }

  .ft-task details {
    padding: 0.75rem;
    border: 1px solid var(--ft-line);
    border-radius: 8px;
    background: var(--ft-soft);
  }

  .ft-task summary {
    cursor: pointer;
    font-weight: 800;
  }

  .ft-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .ft-row-layout {
    display: grid;
    gap: 1rem;
  }

  .ft-row-picker {
    display: grid;
    gap: 0.65rem;
  }

  .ft-row-search {
    margin-bottom: 0;
  }

  .ft-row-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.8rem, 1fr));
    gap: 0.45rem;
  }

  .ft-row-strip button {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    text-align: left;
  }

  .ft-row-strip button[hidden] {
    display: none;
  }

  .ft-row-strip span {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ft-blue) 10%, var(--ft-soft) 90%);
    font-family: var(--font-mono);
    color: var(--ft-blue);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .ft-row-strip strong {
    overflow: hidden;
    color: var(--ft-ink);
    font-size: 0.86rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ft-row-strip button.is-active span {
    background: var(--ft-ink);
    color: var(--surface);
  }

  .ft-row-empty {
    margin: 0;
    padding: 0.75rem;
    border: 1px dashed var(--ft-line);
    border-radius: 8px;
    color: var(--ft-muted);
    font-weight: 800;
  }

  .ft-row-card {
    display: none;
    padding: 1rem;
    border: 1px solid var(--ft-line);
    border-radius: 12px;
    background: #101827;
    color: #dbeafe;
  }

  .ft-row-card.is-active {
    display: grid;
    gap: 1rem;
  }

  .ft-row-card__kicker,
  .ft-row-card__alt,
  .ft-row-card__hint {
    margin: 0;
    color: #bfdbfe;
  }

  .ft-row-card__alt strong {
    color: #fff;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .ft-row-card__kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .ft-row-display {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    padding: 0.8rem;
    border: 1px solid rgba(147, 197, 253, 0.35);
    border-radius: 10px;
    background: #172554;
  }

  .ft-row-display span {
    display: grid;
    place-items: center;
    min-height: 62px;
    border: 1px solid rgba(191, 219, 254, 0.3);
    border-radius: 8px;
    background: rgba(15, 23, 42, 0.45);
    color: #fff;
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 2vw, 1.15rem);
    font-weight: 900;
  }

  .ft-abc {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .ft-abc div {
    padding: 0.8rem;
    border: 1px solid rgba(191, 219, 254, 0.22);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
  }

  .ft-abc span {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-bottom: 0.45rem;
    border-radius: 50%;
    background: #dbeafe;
    color: #0f172a;
    font-weight: 900;
  }

  .ft-abc strong,
  .ft-abc p {
    display: block;
    margin: 0;
  }

  .ft-abc strong {
    color: #fff;
  }

  .ft-abc p {
    margin-top: 0.25rem;
    color: #bfdbfe;
  }

  .ft-abc__hold {
    padding-top: 0.45rem;
    border-top: 1px solid rgba(191, 219, 254, 0.16);
  }

  .ft-abc__hold b {
    color: #fff;
  }

  .ft-row-links,
  .ft-row-related {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.65rem;
  }

  .ft-row-related {
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(191, 219, 254, 0.22);
  }

  .ft-row-related span {
    color: #bfdbfe;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ft-row-links button,
  .ft-row-related button {
    min-height: 32px;
    padding: 0.35rem 0.55rem;
    border-color: rgba(191, 219, 254, 0.32);
    border-radius: 999px;
    background: rgba(219, 234, 254, 0.1);
    color: #dbeafe;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 900;
  }

  .ft-menu-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  .ft-menu-item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(180px, 0.7fr);
    gap: 0.8rem;
    align-items: start;
    padding: 0.8rem;
    border: 1px solid var(--ft-line);
    border-radius: 9px;
    background: var(--ft-panel);
  }

  .ft-menu-item__num {
    display: grid;
    place-items: center;
    min-height: 42px;
    border-radius: 8px;
    background: var(--ft-ink);
    color: var(--surface);
    font-family: var(--font-mono);
    font-weight: 900;
  }

  .ft-menu-item h3,
  .ft-menu-item p {
    margin: 0;
  }

  .ft-menu-item h3 {
    font-size: 1rem;
  }

  .ft-menu-item p {
    color: var(--text-2);
    font-size: 0.92rem;
  }

  .ft-menu-item span {
    display: inline-flex;
    margin-bottom: 0.24rem;
    color: var(--ft-blue);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .ft-map-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .ft-map-grid section {
    padding: 1rem;
    border: 1px solid var(--ft-line);
    border-radius: 10px;
    background: var(--ft-panel);
  }

  .ft-map-grid h3 {
    margin: 0 0 0.75rem;
  }

  .ft-dl {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .ft-dl div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--ft-line);
  }

  .ft-dl div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .ft-dl dt {
    font-family: var(--font-mono);
    font-weight: 900;
  }

  .ft-dl dd {
    margin: 0;
    color: var(--text-2);
  }

  .ft-safety-card {
    grid-column: 1 / -1;
    border-left: 5px solid var(--ft-amber) !important;
    background: color-mix(in srgb, var(--ft-amber) 9%, var(--ft-panel) 91%) !important;
  }

  @media (max-width: 780px) {
    .ft-resource {
      align-items: flex-start;
      flex-direction: column;
    }

    .ft-row-layout,
    .ft-map-grid,
    .ft-task-grid {
      grid-template-columns: 1fr;
    }

    .ft-tabs {
      grid-template-columns: repeat(2, 1fr);
    }

    .ft-menu-item {
      grid-template-columns: 1fr;
    }

    .ft-row-strip {
      display: flex;
      gap: 0.5rem;
      margin-inline: -0.2rem;
      overflow-x: auto;
      padding: 0.15rem 0.2rem 0.55rem;
      scroll-padding-inline: 0.2rem;
      -webkit-overflow-scrolling: touch;
    }

    .ft-row-strip button {
      flex: 0 0 10rem;
    }

    .ft-row-display,
    .ft-abc {
      grid-template-columns: 1fr;
    }

    .ft-dl div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  /* 2026 field-book treatment: dense, task-first, and shared-theme aware. */
  .ft-console--fieldbook {
    --ft-amber: #c98518;
    --ft-lcd: #171814;
