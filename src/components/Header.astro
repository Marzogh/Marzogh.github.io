---
import { Image } from 'astro:assets';
import HeaderLink from './HeaderLink.astro';
import logo from '../assets/Logo.png';
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand">
      <a href="/" class="brand-link" aria-label="Chips’nCode — Home">
        <Image class="brand-mark" src={logo} alt="" width={80} height={80} format="webp" quality={80} />
        <span>Chips’nCode</span>
      </a>
    </div>

    <nav class="main-nav" aria-label="Primary">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/notebook">Notebook</HeaderLink>
      <HeaderLink href="/poetry">Poetry</HeaderLink>
      <HeaderLink href="/projects">Projects</HeaderLink>
      <HeaderLink href="/docs">Documentation</HeaderLink>
      <HeaderLink href="/education">Education</HeaderLink>
      <HeaderLink href="/tools">Tools</HeaderLink>
      <HeaderLink href="/astrophotography">Astrophotography</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </nav>

    <div class="social-links" aria-label="Site utilities">
      <button class="theme-toggle" type="button" aria-label="Toggle theme" aria-pressed="false">
        <span class="sr-only">Toggle theme</span>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
          <path fill="currentColor" d="M12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12Zm0-14a1 1 0 0 1 1-1h0a1 1 0 1 1-2 0h0a1 1 0 0 1 1 1Zm0 19a1 1 0 0 1 1 1h0a1 1 0 1 1-2 0h0a1 1 0 0 1 1-1ZM4 13a1 1 0 0 1-1-1h0a1 1 0 1 1 2 0h0a1 1 0 0 1-1 1Zm19 0a1 1 0 0 1-1-1h0a1 1 0 1 1 2 0h0a1 1 0 0 1-1 1ZM6.22 6.22a1 1 0 0 1-1.41 0h0a1 1 0 1 1 1.41-1.41h0a1 1 0 0 1 0 1.41Zm12.98 12.98a1 1 0 0 1-1.41 0h0a1 1 0 1 1 1.41-1.41h0a1 1 0 0 1 0 1.41ZM6.22 17.78a1 1 0 0 1 0 1.41h0a1 1 0 1 1-1.41-1.41h0a1 1 0 0 1 1.41 0Zm12.98-12.98a1 1 0 0 1 0 1.41h0a1 1 0 1 1-1.41-1.41h0a1 1 0 0 1 1.41 0Z"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
          <path
            fill="currentColor"
            d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75C12.615 15.75 8.25 11.385 8.25 6c0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 2.25 11.25c0 5.385 4.365 9.75 9.75 9.75a9.753 9.753 0 0 0 9.752-5.998Z"
          />
        </svg>
      </button>

      <a href="https://github.com/Marzogh/Marzogh.github.io" target="_blank" rel="noopener" aria-label="View source on GitHub">
        <span class="sr-only">GitHub</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const key = 'theme';
    const btn = document.querySelector('.theme-toggle');
    const sunIcon = btn?.querySelector('.icon-sun');
    const moonIcon = btn?.querySelector('.icon-moon');
    const nav = document.querySelector('.main-nav');
    const path = window.location.pathname || '/';
    const isAstrophotographyRoute = path === '/astrophotography' || path.startsWith('/astrophotography/');

    function prefersDark() {
      return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    function positionNav() {
      if (!nav) return;
      const activeLink = nav.querySelector('a.active');
      const fallbackLink = nav.querySelector('a[href="/notebook"]');
      const target =
        activeLink?.getAttribute('href') === '/'
          ? fallbackLink || activeLink
          : activeLink || fallbackLink;

      if (!target) return;

      const navRect = nav.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      const desired =
        targetRect.left - navRect.left + nav.scrollLeft - (nav.clientWidth - target.clientWidth) / 2;

      nav.scrollTo({
        left: Math.max(0, desired),
        behavior: 'auto',
      });
    }

    function initEdgeDrawers() {
      const tabs = Array.from(document.querySelectorAll('.edge-drawer-tab'));
      if (!tabs.length) return;

      const palette = ['#8fb4f5', '#8fd3c7', '#c5b4f4', '#f2c59f', '#f1b0cb', '#9ec9de'];
      const named = tabs
        .map((tab) => ({
          tab,
          name: (tab.getAttribute('data-drawer-name') || tab.textContent || '').trim().toLowerCase(),
          toggleId: tab.getAttribute('for') || '',
        }))
        .sort((a, b) => a.name.localeCompare(b.name));

      named.forEach((item, index) => {
        const hue = palette[index % palette.length];
        item.tab.style.setProperty('--edge-drawer-order', String(index));
        item.tab.style.setProperty('--edge-drawer-hue', hue);
        if (item.toggleId) {
          const overlay = document.querySelector(`.edge-drawer-overlay[data-edge-drawer="${item.toggleId}"]`);
          if (overlay instanceof HTMLElement) {
            overlay.style.setProperty('--edge-drawer-hue', hue);
          }
        }
      });
    }

    function setPressed() {
      const explicit = root.dataset.theme;
      const isDark = explicit ? explicit === 'dark' : prefersDark();
      if (btn) {
        btn.setAttribute('aria-pressed', String(isDark));
        btn.dataset.mode = isDark ? 'dark' : 'light';
      }

      if (sunIcon instanceof SVGElement) {
        sunIcon.hidden = isDark;
      }

      if (moonIcon instanceof SVGElement) {
        moonIcon.hidden = !isDark;
      }
    }

    function lockAstroTheme() {
      root.dataset.theme = 'dark';
      if (btn) {
        btn.disabled = true;
        btn.setAttribute('aria-disabled', 'true');
        btn.setAttribute('title', 'Astrophotography pages stay in dark mode');
      }
      setPressed();
    }

    function apply(theme) {
      if (theme === 'light' || theme === 'dark') {
        root.dataset.theme = theme;
        localStorage.setItem(key, theme);
      } else {
        delete root.dataset.theme;
        localStorage.removeItem(key);
      }
      setPressed();
    }

    if (isAstrophotographyRoute) {
      lockAstroTheme();
    } else {
      const stored = localStorage.getItem(key);
      if (stored === 'light' || stored === 'dark') {
        apply(stored);
      } else {
        setPressed();
      }

      if (btn) {
        btn.addEventListener('click', () => {
          const current = root.dataset.theme;
          const next = current
            ? current === 'dark'
              ? 'light'
              : 'dark'
            : prefersDark()
              ? 'light'
              : 'dark';
          apply(next);
        });
      }

      if (window.matchMedia) {
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        mq.addEventListener?.('change', () => {
          if (!root.dataset.theme) setPressed();
        });
      }
    }

    const applyHeaderLayout = () => {
      positionNav();
      initEdgeDrawers();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyHeaderLayout, { once: true });
    } else {
      applyHeaderLayout();
    }

    window.addEventListener('resize', applyHeaderLayout, { passive: true });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 94%, transparent 6%);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: "brand nav utilities";
    align-items: center;
    column-gap: clamp(1.5rem, 3vw, 3rem);
    min-height: 78px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-2);
  }

  .brand {
    grid-area: brand;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.025em;
    text-decoration: none;
    color: var(--text);
    white-space: nowrap;
  }

  .brand-link:hover {
    color: var(--accent);
  }

  .brand-mark {
    display: block;
    width: 40px;
    height: 40px;
    object-fit: cover;
  }

  /* Nav can wrap on desktop and scroll on mobile */
  .main-nav {
    grid-area: nav;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.8rem, 1.25vw, 1.45rem);
    flex-wrap: nowrap;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    scroll-behavior: smooth;
    scroll-padding-inline: 1.5rem;
    padding: 0;
    margin: 0;
  }

  .main-nav::-webkit-scrollbar {
    display: none;
  }

  .main-nav a {
    padding: 8px 0;
    text-decoration: none;
    color: var(--text-2);
    border-bottom: 1px solid transparent;
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .main-nav a:hover {
    color: var(--text);
  }

  .main-nav a.active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .social-links {
    grid-area: utilities;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }

  .social-links a,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-2);
    box-shadow: none;
    text-decoration: none;
    cursor: pointer;
  }

  .social-links a:hover,
  .theme-toggle:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 25%, var(--header-chip-border) 75%);
  }

  .theme-toggle {
    padding: 0;
  }

  .theme-toggle[disabled] {
    cursor: not-allowed;
    opacity: 1;
  }

  /* Theme icon visibility fallback (JS also sets [hidden] explicitly) */
  .theme-toggle .icon-sun {
    display: inline;
  }

  .theme-toggle .icon-moon {
    display: none;
    color: #f8f6ef;
  }

  .theme-toggle svg[hidden] {
    display: none !important;
  }

  /* User forced dark */
  :global(html[data-theme="dark"]) .theme-toggle .icon-sun {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-toggle .icon-moon {
    display: inline;
  }

  /* OS dark (unless user forced light) */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .theme-toggle .icon-sun {
      display: none;
    }

    :global(html:not([data-theme="light"])) .theme-toggle .icon-moon {
      display: inline;
    }
  }

  /* Astrophotography pages are permanently dark */
  :global(body.theme-photo) .theme-toggle .icon-sun {
    display: none;
  }

  :global(body.theme-photo) .theme-toggle .icon-moon {
    display: inline;
  }

  /* Ensure icon contrast */
  .theme-toggle .icon-sun {
    color: var(--text);
  }

  @media (max-width: 1180px) {
    .header-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "brand"
        "nav";
      justify-items: start;
      row-gap: 0.45rem;
    }

    .main-nav {
      justify-content: flex-start;
      gap: var(--space-4);
      padding-bottom: 2px;
      -webkit-overflow-scrolling: touch;
    }

    .social-links {
      position: absolute;
      right: var(--space-5);
      top: 10px;
    }
  }

  @media (max-width: 520px) {
    .social-links {
      right: var(--space-3);
    }
  }
</style>
