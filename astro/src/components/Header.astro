---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand">
      <a href="/" class="brand-link" aria-label="Chips’nCode — Home">Chips’nCode</a>
    </div>

    <nav class="main-nav" aria-label="Primary">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/projects">Projects</HeaderLink>
      <HeaderLink href="/docs">Documentation</HeaderLink>
      <HeaderLink href="/education">Education</HeaderLink>
      <HeaderLink href="/tools">Tools</HeaderLink>
      <HeaderLink href="/astrophotography">Astrophotography</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </nav>

    <div class="social-links" aria-label="Site utilities">
      <button class="theme-toggle" type="button" aria-label="Toggle theme" aria-pressed="false">
        <span class="sr-only">Toggle theme</span>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
          <path fill="currentColor" d="M12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12Zm0-14a1 1 0 0 1 1-1h0a1 1 0 1 1-2 0h0a1 1 0 0 1 1 1Zm0 19a1 1 0 0 1 1 1h0a1 1 0 1 1-2 0h0a1 1 0 0 1 1-1ZM4 13a1 1 0 0 1-1-1h0a1 1 0 1 1 2 0h0a1 1 0 0 1-1 1Zm19 0a1 1 0 0 1-1-1h0a1 1 0 1 1 2 0h0a1 1 0 0 1-1 1ZM6.22 6.22a1 1 0 0 1-1.41 0h0a1 1 0 1 1 1.41-1.41h0a1 1 0 0 1 0 1.41Zm12.98 12.98a1 1 0 0 1-1.41 0h0a1 1 0 1 1 1.41-1.41h0a1 1 0 0 1 0 1.41ZM6.22 17.78a1 1 0 0 1 0 1.41h0a1 1 0 1 1-1.41-1.41h0a1 1 0 0 1 1.41 0Zm12.98-12.98a1 1 0 0 1 0 1.41h0a1 1 0 1 1-1.41-1.41h0a1 1 0 0 1 1.41 0Z"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
          <path fill="currentColor" d="M12 2a10 10 0 0 0 0 20 9 9 0 1 1 0-20z"/>
        </svg>
      </button>

      <a href="https://github.com/Marzogh/Marzogh.github.io" target="_blank" rel="noopener" aria-label="View source on GitHub">
        <span class="sr-only">GitHub</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const key = 'theme';
    const btn = document.querySelector('.theme-toggle');

    function prefersDark() {
      return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    function setPressed() {
      const explicit = root.dataset.theme;
      const isDark = explicit ? explicit === 'dark' : prefersDark();
      if (btn) btn.setAttribute('aria-pressed', String(isDark));
    }

    function apply(theme) {
      if (theme === 'light' || theme === 'dark') {
        root.dataset.theme = theme;
        localStorage.setItem(key, theme);
      } else {
        delete root.dataset.theme;
        localStorage.removeItem(key);
      }
      setPressed();
    }

    const stored = localStorage.getItem(key);
    if (stored === 'light' || stored === 'dark') {
      apply(stored);
    } else {
      setPressed();
    }

    if (btn) {
      btn.addEventListener('click', () => {
        const current = root.dataset.theme;
        const next = current
          ? current === 'dark'
            ? 'light'
            : 'dark'
          : prefersDark()
            ? 'light'
            : 'dark';
        apply(next);
      });
    }

    if (window.matchMedia) {
      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      mq.addEventListener?.('change', () => {
        if (!root.dataset.theme) setPressed();
      });
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--header-border);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .brand-link {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--text);
    white-space: nowrap;
  }

  .brand-link:hover {
    color: var(--accent);
  }

  /* Nav can wrap on desktop and scroll on mobile */
  .main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    row-gap: 6px;
    min-width: 0;
  }

  .main-nav a {
    padding: 8px 4px;
    text-decoration: none;
    color: var(--text-2);
    border-bottom: 2px solid transparent;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .main-nav a:hover {
    color: var(--text);
  }

  .main-nav a.active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }

  .social-links a,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--header-chip-border);
    background: var(--header-chip-bg);
    color: var(--text-2);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    cursor: pointer;
  }

  .social-links a:hover,
  .theme-toggle:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 25%, var(--header-chip-border) 75%);
  }

  .theme-toggle {
    padding: 0;
  }

  /* Theme icon visibility
     - Default (light): show sun
     - Dark when OS prefers dark (and no forced light): show moon
     - Dark when user forced dark via html[data-theme="dark"]: show moon
  */
  .theme-toggle .icon-sun {
    display: inline;
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  /* User forced dark */
  :global(html[data-theme="dark"]) .theme-toggle .icon-sun {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-toggle .icon-moon {
    display: inline;
  }

  /* OS dark (unless user forced light) */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .theme-toggle .icon-sun {
      display: none;
    }

    :global(html:not([data-theme="light"])) .theme-toggle .icon-moon {
      display: inline;
    }
  }

  /* Ensure icon contrast */
  .theme-toggle .icon-sun {
    color: var(--text);
  }

  /* User forced dark */
  :global(html[data-theme="dark"]) .theme-toggle .icon-moon {
    color: var(--text);
  }

  /* OS dark (unless user forced light) */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .theme-toggle .icon-moon {
      color: var(--text);
    }
  }

  @media (max-width: 980px) {
    .header-inner {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .main-nav {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      gap: var(--space-4);
      padding-bottom: 2px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .main-nav::-webkit-scrollbar {
      display: none;
    }

    .social-links {
      position: absolute;
      right: var(--space-5);
      top: 10px;
    }
  }

  @media (max-width: 520px) {
    .social-links {
      right: var(--space-3);
    }
  }
</style>
