---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Projects — Chips’nCode"
      description="Builds, hardware experiments, antennas, firmware, and system design."
    />
  </head>
  <body>
    <Header />
    <main style="max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem;">
      <h1 style="margin-bottom: 2rem;">Projects</h1>

      {projects.length === 0 ? (
        <p style="color: #666;">Projects coming soon.</p>
      ) : (
        <section
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;"
        >
          {projects.map((project) => (
            <a
              href={`/projects/${project.id}`}
              style="text-decoration: none; color: inherit;"
            >
              <div
                style="padding: 1.5rem; border: 1px solid #e5e7eb; border-radius: 12px; height: 100%;"
              >
                <h2 style="margin-top: 0; margin-bottom: 0.5rem;">
                  {project.data.title}
                </h2>
                <p style="color: #555; margin-bottom: 0;">
                  {project.data.description}
                </p>
              </div>
            </a>
          ))}
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>
