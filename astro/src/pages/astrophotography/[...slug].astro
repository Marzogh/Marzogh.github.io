---
import { getCollection, getEntry, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const sessions = await getCollection('astrophotography', ({ data }) => !data.draft);

  return sessions.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing route parameter: slug');
}

const entry = await getEntry('astrophotography', slug);

if (!entry) {
  throw new Error(`Astrophotography entry not found: ${slug}`);
}

const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={entry.data.title} description={entry.data.description} />
  </head>
  <body class="theme-photo">
    <Header />

    <main>
      <article class="astro-session">
        <div class="astro-back">
          <a href="/astrophotography" class="astro-back-link">
            ← Back to Astrophotography
          </a>
        </div>

        <header class="astro-header">
          <h1 class="astro-title">{entry.data.title}</h1>

          {entry.data.sessionDate && (
            <p class="astro-meta">
              Session Date: {entry.data.sessionDate.toDateString()}
            </p>
          )}
        </header>

        <hr class="astro-divider" />

        <div class="prose astro-prose">
          <Content />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .astro-session {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .astro-back-link {
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--muted);
  }

  .astro-back-link:hover {
    color: var(--accent);
  }

  .astro-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .astro-title {
    margin: 0;
  }

  .astro-meta {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .astro-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0;
  }

  /* Give astrophotography content more breathing room */
  .astro-prose img {
    margin: 1.6em 0;
    box-shadow: var(--shadow-md);
  }
</style>
