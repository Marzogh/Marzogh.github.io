---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const docs = (await getCollection('docs', ({ data }) => !data.draft)).sort(
  (a, b) => {
    const sectionCompare = (a.data.section || '').localeCompare(b.data.section || '');
    if (sectionCompare !== 0) return sectionCompare;
    return (a.data.order || 0) - (b.data.order || 0);
  }
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Documentation — Chips’nCode"
      description="Structured guides, technical documentation, and deep dives."
    />
  </head>
  <body>
    <Header />
    <main style="max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem;">
      <h1 style="margin-bottom: 2rem;">Documentation</h1>

      {docs.length === 0 ? (
        <p style="color: #666;">Documentation coming soon.</p>
      ) : (
        <section style="display: grid; gap: 1.25rem;">
          {docs.map((doc) => (
            <a
              href={`/docs/${doc.id}`}
              style="text-decoration: none; color: inherit;"
            >
              <div
                style="padding: 1.5rem; border: 1px solid #e5e7eb; border-radius: 12px;"
              >
                <h2 style="margin-top: 0; margin-bottom: 0.5rem;">
                  {doc.data.title}
                </h2>
                {doc.data.section && (
                  <p style="font-size: 0.85rem; color: #888; margin-bottom: 0.5rem;">
                    Section: {doc.data.section}
                  </p>
                )}
                <p style="color: #555; margin-bottom: 0;">
                  {doc.data.description}
                </p>
              </div>
            </a>
          ))}
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>
