options:
  parameters:
    author: Prajwal Bhattaram
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Medium-wave AM example at 792 kHz; substitute a local service if needed. RTL-SDR Blog
      V3 Q-branch direct_samp=2 configured in Soapy Custom Source Ch0 Other settings. Live reception requires
      suitable antenna and coverage.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: chipsncode_am_792_q_branch
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ChipsnCode - 792 kHz AM V3 Q-branch
    window_size: (1150,800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: rf_rate
  id: variable
  parameters:
    comment: Soapy RTL-SDR sample rate (Hz)
    value: '2400000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
- name: station_freq
  id: variable
  parameters:
    value: '792000'
    comment: Example medium-wave AM frequency. Change to a local AM station if needed.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 280
    - 8
    rotation: 0
    state: enabled
- name: soapy_custom_source_0
  id: soapy_custom_source
  parameters:
    driver: '''rtlsdr'''
    type: fc32
    nchan: '1'
    dev_args: ''''''
    stream_args: ''''''
    samp_rate: rf_rate
    tune_args0: ''''''
    settings0: '''direct_samp=2'''
    bandwidth0: '0'
    antenna0: '''RX'''
    center_freq0: station_freq + 50000
    freq_correction0: '0'
    agc0: 'False'
    gain0: '0'
    dc_removal0: 'False'
    dc_offset0: '0'
    iq_balance0: '0'
    comment: 'RTL-SDR Blog V3 direct sampling: Q branch. The channel-specific Other settings value is direct_samp=2.
      This is not a normal tuner configuration.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 24
    - 185
    rotation: 0
    state: enabled
- name: freq_xlating_fir_filter_xxx_0
  id: freq_xlating_fir_filter_xxx
  parameters:
    type: ccf
    decim: '30'
    taps: firdes.low_pass(1, rf_rate, 5000, 2000, window.WIN_HAMMING)
    center_freq: '-50000'
    samp_rate: rf_rate
    comment: Select AM channel; 2400000/30 = 80000 samples/s.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 315
    - 185
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_0
  id: blocks_complex_to_mag
  parameters:
    affinity: ''
    alias: ''
    comment: AM envelope detection; selected complex channel at 80000 samples per second.
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 590
    - 185
    rotation: 0
    state: enabled
- name: dc_blocker_xx_0
  id: dc_blocker_xx
  parameters:
    type: ff
    length: '256'
    long_form: 'True'
    comment: Remove varying carrier/DC level from real demodulated AM audio.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 765
    - 185
    rotation: 0
    state: enabled
- name: rational_resampler_xxx_0
  id: rational_resampler_xxx
  parameters:
    type: fff
    interp: '3'
    decim: '5'
    taps: '[]'
    fbw: '0'
    comment: 80000 * 3/5 = 48000 samples/s.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 936
    - 185
    rotation: 0
    state: enabled
- name: audio_sink_0
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: Live mono AM audio, 48 kHz, float samples
    device_name: ''
    num_inputs: '1'
    ok_to_block: 'True'
    samp_rate: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1350
    - 185
    rotation: 0
    state: enabled
