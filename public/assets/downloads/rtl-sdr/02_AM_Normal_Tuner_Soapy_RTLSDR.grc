options:
  parameters:
    author: Prajwal Bhattaram
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Aircraft AM example at 125.6 MHz, Brisbane Approach south-east sector. Soapy RTLSDR,
      tuning 50000 Hz above target and frequency translating filter. 2400000 -> 80000 -> 48000.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: chipsncode_am_normal
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ChipsnCode - AM using normal tuner
    window_size: (1150,800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: rf_rate
  id: variable
  parameters:
    comment: Soapy RTL-SDR sample rate (Hz)
    value: '2400000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
- name: station_freq
  id: variable
  parameters:
    value: '125600000'
    comment: 'Brisbane Approach south-east sector: 125.6 MHz. Change to a local AM signal.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 280
    - 8
    rotation: 0
    state: enabled
- name: soapy_rtlsdr_source_0
  id: soapy_rtlsdr_source
  parameters:
    type: fc32
    dev_args: ''''''
    samp_rate: rf_rate
    center_freq: station_freq + 50000
    freq_correction: '0'
    agc: 'False'
    gain: '20'
    bias: 'False'
    bufflen: '262144'
    comment: Normal tuner mode; 50000 Hz above the wanted AM signal.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 24
    - 185
    rotation: 0
    state: enabled
- name: freq_xlating_fir_filter_xxx_0
  id: freq_xlating_fir_filter_xxx
  parameters:
    type: ccf
    decim: '30'
    taps: firdes.low_pass(1, rf_rate, 5000, 2000, window.WIN_HAMMING)
    center_freq: '-50000'
    samp_rate: rf_rate
    comment: Select AM channel; 2400000/30 = 80000 samples/s.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 315
    - 185
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_0
  id: blocks_complex_to_mag
  parameters:
    affinity: ''
    alias: ''
    comment: AM envelope detection; selected complex channel at 80000 samples per second.
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 590
    - 185
    rotation: 0
    state: enabled
- name: dc_blocker_xx_0
  id: dc_blocker_xx
  parameters:
    type: ff
    length: '256'
    long_form: 'True'
    comment: Remove varying carrier/DC level from real demodulated AM audio.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 765
    - 185
    rotation: 0
    state: enabled
- name: rational_resampler_xxx_0
  id: rational_resampler_xxx
  parameters:
    type: fff
    interp: '3'
    decim: '5'
    taps: '[]'
    fbw: '0'
    comment: 80000 * 3/5 = 48000 samples/s.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 936
    - 185
    rotation: 0
    state: enabled
- name: audio_sink_0
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: Live mono AM audio, 48 kHz, float samples
    device_name: ''
    num_inputs: '1'
    ok_to_block: 'True'
    samp_rate: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1350
    - 185
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: rf_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
    fc: station_freq + 50000
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: ''
    label: Relative gain
    label1: Normal-tuner RF
    label10: ''''''
    label2: ''''''
    label3: ''''''
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: Received RF spectrum (tuned 50 kHz high)
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.1'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_RECTANGULAR
    ymax: '0'
    ymin: '-140'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 312
    - 500
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_1
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: rf_rate / 30
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '2048'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: ''
    label: Relative gain
    label1: Filtered AM channel
    label10: ''''''
    label2: ''''''
    label3: ''''''
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: 'Selected AM station: translated baseband'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.1'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_RECTANGULAR
    ymax: '0'
    ymin: '-140'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 672
    - 505
    rotation: 0
    state: enabled
connections:
- - soapy_rtlsdr_source_0
  - '0'
  - freq_xlating_fir_filter_xxx_0
  - '0'
- - soapy_rtlsdr_source_0
  - '0'
  - qtgui_freq_sink_x_0
  - '0'
- - freq_xlating_fir_filter_xxx_0
  - '0'
  - blocks_complex_to_mag_0
  - '0'
- - freq_xlating_fir_filter_xxx_0
  - '0'
  - qtgui_freq_sink_x_1
  - '0'
- - blocks_complex_to_mag_0
  - '0'
  - dc_blocker_xx_0
  - '0'
- - dc_blocker_xx_0
  - '0'
  - rational_resampler_xxx_0
  - '0'
- - rational_resampler_xxx_0
  - '0'
  - audio_sink_0
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
